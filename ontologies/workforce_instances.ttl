    mesh:skillDescription "Evitar erros e retrabalho garantindo um padrão de qualidade antes do envio." .

mesh:Skill_ia_operations_checklist_de_revisao_diaria_de_entregas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-checklist-de-revisao-diaria-de-entregas" ;
