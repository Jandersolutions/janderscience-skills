    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/controle-financeiro-de-freelancer/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura completa de controle financeiro para freelancer de tecnologia — com categorização de receitas e despesas, cálculo de quanto guardar para impostos, meta de faturamento por projeto e reserva de emergência — para sair do \"recebi, gastei, não sei para onde foi\" e ter clareza do quanto realmente sobra, do quanto você precisa faturar por mês e se o seu negócio está financeiramente saudável." .

mesh:Skill_ia_finance_dashboard_de_indicadores_para_gestores a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-dashboard-de-indicadores-para-gestores" ;
    rdfs:label "dashboard-de-indicadores-para-gestores" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/dashboard-de-indicadores-para-gestores/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura completa de um dashboard de KPIs — com os indicadores certos para cada área do negócio, fórmulas de cálculo e frequência de atualização — para que gestores de pequenas equipes acompanhem o desempenho do negócio de forma visual e rápida, sem precisar de um analista ou sistema caro. O dashboard certo transforma dados dispersos em clareza para decisão." .

mesh:Skill_ia_finance_dashboard_de_kpis_do_negocio a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-dashboard-de-kpis-do-negocio" ;
    rdfs:label "dashboard-de-kpis-do-negocio" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/dashboard-de-kpis-do-negocio/SKILL.md" ;
    mesh:skillDescription "Estruturar um conjunto de indicadores-chave de desempenho — para vendas, operação, financeiro e projetos — com definição clara de fórmula, frequência de medição e metas, para que o gestor pare de administrar por sensação e comece a tomar decisões baseadas em dados reais, identificando problemas antes que virem crise e oportunidades antes que desapareçam." .

mesh:Skill_ia_finance_dashboard_de_lucro_real_para_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-dashboard-de-lucro-real-para-e-commerce" ;
    rdfs:label "dashboard-de-lucro-real-para-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/dashboard-de-lucro-real-para-e-commerce/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura completa de um painel de lucro real para e-commerce Shopify — deduzindo de forma clara receita bruta, custo do produto, frete, taxas de pagamento, custo de anúncios por canal, impostos e custos fixos — para que o empreendedor saiba o lucro real de cada venda e do negócio inteiro olhando para um único número. Chega de confundir faturamento com lucro." .

mesh:Skill_ia_finance_dashboard_financeiro_para_renda_pulverizada a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-dashboard-financeiro-para-renda-pulverizada" ;
    rdfs:label "dashboard-financeiro-para-renda-pulverizada" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/dashboard-financeiro-para-renda-pulverizada/SKILL.md" ;
    mesh:skillDescription "Criar uma estrutura completa de controle financeiro para empreendedores com múltiplas fontes de renda simultâneas — projetos diferentes, clientes diferentes, parceiros a pagar — para ter clareza sobre quanto vai entrar, quanto vai sair, quanto já é lucro e qual projeto está valendo a pena. Substitui o \"estou totalmente perdido financeiramente\" por um painel simples que qualquer pessoa consegue manter atualizado em 15 minutos por semana." .

mesh:Skill_ia_finance_diagnostico_de_viabilidade_de_acao_judicial a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-diagnostico-de-viabilidade-de-acao-judicial" ;
    rdfs:label "diagnostico-de-viabilidade-de-acao-judicial" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/diagnostico-de-viabilidade-de-acao-judicial/SKILL.md" ;
    mesh:skillDescription "Fazer uma análise estruturada da viabilidade de uma ação judicial — avaliando fundamento jurídico, prova disponível, jurisprudência, custos, riscos e alternativas extrajudiciais — para que o advogado chegue a uma consulta ou ao cliente com um diagnóstico fundamentado, e não apenas com impressões, aumentando a qualidade da assessoria e a confiança do cliente na decisão." .

mesh:Skill_ia_finance_diagnostico_financeiro_completo_de_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-diagnostico-financeiro-completo-de-cliente" ;
    rdfs:label "diagnostico-financeiro-completo-de-cliente" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/diagnostico-financeiro-completo-de-cliente/SKILL.md" ;
    mesh:skillDescription "Conduzir um diagnóstico financeiro estruturado e aprofundado de clientes de consultoria — mapeando a situação atual, identificando gargalos, causas-raiz dos problemas e oportunidades de melhoria — para que o consultor entregue uma análise que vai além dos números e mostra ao cliente exatamente onde o dinheiro está escapando e o que fazer primeiro." .

mesh:Skill_ia_finance_diagnostico_financeiro_de_novo_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-diagnostico-financeiro-de-novo-cliente" ;
    rdfs:label "diagnostico-financeiro-de-novo-cliente" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/diagnostico-financeiro-de-novo-cliente/SKILL.md" ;
    mesh:skillDescription "Estruturar e executar o diagnóstico financeiro de um cliente novo de consultoria — a partir das informações coletadas na reunião inicial ou de documentos enviados — gerando um laudo com achados críticos, pontos de atenção e um plano de ação priorizado. Transforma a primeira conversa em um documento profissional que demonstra o valor da consultoria desde o dia um e justifica o escopo do trabalho a ser contratado." .

mesh:Skill_ia_finance_diagnostico_financeiro_rapido_para_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-diagnostico-financeiro-rapido-para-clientes" ;
    rdfs:label "diagnostico-financeiro-rapido-para-clientes" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/diagnostico-financeiro-rapido-para-clientes/SKILL.md" ;
    mesh:skillDescription "Gerar diagnósticos financeiros estruturados para clientes ou prospects do escritório — analisando regime tributário, estrutura de custos, fluxo de caixa e oportunidades de otimização — para entregar uma visão clara da saúde financeira do negócio, identificar onde o dinheiro está vazando e apresentar recomendações práticas que demonstram o valor do contador consultivo antes mesmo de fechar contrato." .

mesh:Skill_ia_finance_diario_de_operacoes_de_mini_indice_win a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-diario-de-operacoes-de-mini-indice-win" ;
    rdfs:label "diario-de-operacoes-de-mini-indice-win" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/diario-de-operacoes-de-mini-indice-win/SKILL.md" ;
    mesh:skillDescription "Estruturar o diário de operações de Mini Índice — com registro estruturado de cada trade, análise de resultados, identificação de padrões de comportamento e métricas de desempenho — para que o operador desenvolva consistência e disciplina, aprenda com os próprios erros e evolua sistematicamente sem depender só de intuição." .

mesh:Skill_ia_finance_estrategia_de_precificacao_de_produto_para_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-estrategia-de-precificacao-de-produto-para-e-commerce" ;
    rdfs:label "estrategia-de-precificacao-de-produto-para-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/estrategia-de-precificacao-de-produto-para-e-commerce/SKILL.md" ;
    mesh:skillDescription "Definir a estratégia de precificação de produtos do e-commerce — com análise de margem, posicionamento competitivo e técnicas de psicologia de preço — para maximizar a margem sem perder competitividade, usando decisões de preço baseadas em dados em vez de intuição ou cópia de concorrente." .

mesh:Skill_ia_finance_estrategia_de_precificacao_de_servicos a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-estrategia-de-precificacao-de-servicos" ;
    rdfs:label "estrategia-de-precificacao-de-servicos" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/estrategia-de-precificacao-de-servicos/SKILL.md" ;
    mesh:skillDescription "Definir a estratégia de precificação de serviços de marketing — calculando o preço mínimo viável, o preço de mercado e o preço baseado em valor — para freelancers e consultores que estão começando ou querem reposicionar o que cobram. Elimina o \"não sei quanto cobrar\" e substitui por uma metodologia clara que valoriza o trabalho e cria propostas que fecham." .

mesh:Skill_ia_finance_estrutura_de_contratos_e_documentos_com_revisao_final a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-estrutura-de-contratos-e-documentos-com-revisao-final" ;
    rdfs:label "estrutura-de-contratos-e-documentos-com-revisao-final" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/estrutura-de-contratos-e-documentos-com-revisao-final/SKILL.md" ;
    mesh:skillDescription "Criar minutas e estruturas de contratos e documentos com clareza e organização — prontas para adaptação e revisão final, economizando tempo na elaboração." .

mesh:Skill_ia_finance_estruturacao_de_dre_gerencial_para_pme a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-estruturacao-de-dre-gerencial-para-pme" ;
    rdfs:label "estruturacao-de-dre-gerencial-para-pme" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/estruturacao-de-dre-gerencial-para-pme/SKILL.md" ;
    mesh:skillDescription "Estruturar o Demonstrativo de Resultado Gerencial (DRE) de clientes PME de forma clara e acionável — separando receitas, custos variáveis, custos fixos, resultado operacional e resultado líquido — para que o dono do negócio tenha pela primeira vez uma visão real de quanto sobra (ou não sobra) do que fatura, e o consultor tenha uma ferramenta de análise e acompanhamento mensal." .

mesh:Skill_ia_finance_estruturacao_de_metas_smart_financeiras a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-estruturacao-de-metas-smart-financeiras" ;
    rdfs:label "estruturacao-de-metas-smart-financeiras" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/estruturacao-de-metas-smart-financeiras/SKILL.md" ;
    mesh:skillDescription "Transformar objetivos vagos e genéricos de clientes em metas SMART financeiras — específicas, mensuráveis, atingíveis, relevantes e com prazo — acompanhadas de plano de ação e indicadores de progresso — para que o consultor estruture o comprometimento do cliente com bases sólidas e o acompanhamento seja objetivo e focado em resultado." .

mesh:Skill_ia_finance_estruturador_de_acordo_extrajudicial a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-estruturador-de-acordo-extrajudicial" ;
    rdfs:label "estruturador-de-acordo-extrajudicial" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/estruturador-de-acordo-extrajudicial/SKILL.md" ;
    mesh:skillDescription "Criar acordos extrajudiciais completos e juridicamente seguros — com quitação clara, obrigações bem definidas, cláusulas de descumprimento e reconhecimento de dívida quando aplicável — para que o advogado resolva conflitos fora do processo de forma eficiente, proteja seu cliente e entregue um instrumento que realmente funciona se precisar ser executado." .

mesh:Skill_ia_finance_extrato_bancario_para_fluxo_de_caixa a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-extrato-bancario-para-fluxo-de-caixa" ;
    rdfs:label "extrato-bancario-para-fluxo-de-caixa" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/extrato-bancario-para-fluxo-de-caixa/SKILL.md" ;
    mesh:skillDescription "Transformar o extrato bancário bruto — cheio de descrições crípticas, lançamentos misturados e sem categorização — em um demonstrativo de fluxo de caixa organizado por categorias, com entradas, saídas, saldo operacional e variação do período. A skill lê o extrato colado em texto e entrega um relatório financeiro estruturado, pronto para apresentar ao cliente ou usar internamente." .

mesh:Skill_ia_finance_framework_de_alocacao_de_budget_de_ads a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-framework-de-alocacao-de-budget-de-ads" ;
    rdfs:label "framework-de-alocacao-de-budget-de-ads" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/framework-de-alocacao-de-budget-de-ads/SKILL.md" ;
    mesh:skillDescription "Criar um framework de decisão para alocar o budget total de anúncios entre canais (Facebook vs TikTok), fases do funil (aquisição vs retargeting) e tipos de campanha (teste vs escala) — para maximizar o ROAS total sem depender de intuição ou distribuição arbitrária. A alocação de budget é uma das decisões mais impactantes e menos sistemáticas de quem gerencia os próprios ads." .

mesh:Skill_ia_finance_framework_de_analise_de_precificacao_e_margem a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-framework-de-analise-de-precificacao-e-margem" ;
    rdfs:label "framework-de-analise-de-precificacao-e-margem" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/framework-de-analise-de-precificacao-e-margem/SKILL.md" ;
    mesh:skillDescription "Analisar a estrutura de precificação e margem de contribuição de um negócio — mapeando o custo real de cada produto ou serviço, calculando a margem por item e identificando o que está gerando lucro, o que está no zero a zero e o que está consumindo caixa — para que o consultor entregue ao cliente uma visão clara de onde o dinheiro está sendo destruído e como precificar corretamente." .

mesh:Skill_ia_finance_framework_de_precificacao_de_agencia a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-framework-de-precificacao-de-agencia" ;
    rdfs:label "framework-de-precificacao-de-agencia" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/framework-de-precificacao-de-agencia/SKILL.md" ;
    mesh:skillDescription "Definir a precificação estratégica dos serviços da agência — com modelos de cobrança, ancoragem de pacotes, lógica de upsell e argumentação de valor — para parar de cobrar pelo tempo ou pelas tarefas e começar a cobrar pelo resultado e pelo valor percebido, aumentando ticket médio sem precisar de mais clientes." .

mesh:Skill_ia_finance_framework_de_raciocinio_juridico a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-framework-de-raciocinio-juridico" ;
    rdfs:label "framework-de-raciocinio-juridico" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/framework-de-raciocinio-juridico/SKILL.md" ;
    mesh:skillDescription "Aplicar um framework estruturado de raciocínio jurídico para analisar casos complexos — usando os métodos de subsunção, ponderação de princípios, analogia e interpretação sistemática — e chegar a uma conclusão fundamentada sobre a questão jurídica apresentada. Ideal para casos que não têm resposta óbvia na lei e exigem um raciocínio mais profundo e estratégico do que simplesmente \"pesquisar o artigo certo\"." .

mesh:Skill_ia_finance_framework_de_sessao_de_coaching_financeiro a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-framework-de-sessao-de-coaching-financeiro" ;
    rdfs:label "framework-de-sessao-de-coaching-financeiro" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/framework-de-sessao-de-coaching-financeiro/SKILL.md" ;
    mesh:skillDescription "Estruturar sessões de coaching financeiro — combinando perguntas poderosas, diagnóstico de padrões comportamentais com dinheiro, identificação de crenças limitantes e criação de planos de ação comportamentais — para que o consultor/coach vá além dos números e ajude o cliente a mudar o comportamento que está na raiz dos problemas financeiros recorrentes." .

mesh:Skill_ia_finance_framework_de_tomada_de_decisao_juridica a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-framework-de-tomada-de-decisao-juridica" ;
    rdfs:label "framework-de-tomada-de-decisao-juridica" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/framework-de-tomada-de-decisao-juridica/SKILL.md" ;
    mesh:skillDescription "Aplicar um framework estruturado de pensamento estratégico a casos jurídicos complexos — analisando dimensões técnicas, táticas, humanas e de risco — para que o advogado vá além da análise superficial, identifique o que realmente importa em cada caso e chegue a recomendações mais fundamentadas, diferenciando-se do profissional que apenas aplica norma sem pensar estrategicamente." .

mesh:Skill_ia_finance_framework_de_unit_economics a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-framework-de-unit-economics" ;
    rdfs:label "framework-de-unit-economics" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/framework-de-unit-economics/SKILL.md" ;
    mesh:skillDescription "Calcular e interpretar os unit economics completos do e-commerce — CAC (Custo de Aquisição de Cliente) por canal, LTV (Lifetime Value), payback period, margem de contribuição e ponto de equilíbrio — para tomar decisões de quanto investir em ads, quando escalar e qual canal priorizar com base em matemática, não em intuição. Para e-commerce solo, conhecer seus unit economics é a diferença entre crescer de forma sustentável e queimar caixa sem perceber." .

mesh:Skill_ia_finance_gerador_de_clausulas_juridicas_especificas a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-gerador-de-clausulas-juridicas-especificas" ;
    rdfs:label "gerador-de-clausulas-juridicas-especificas" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/gerador-de-clausulas-juridicas-especificas/SKILL.md" ;
    mesh:skillDescription "Criar cláusulas contratuais precisas e tecnicamente sólidas para situações específicas — confidencialidade, responsabilidade, rescisão, propriedade intelectual, não-concorrência, SLA, penalidades — para que o advogado tenha um arsenal de cláusulas bem redigidas ao alcance em vez de recorrer a modelos genéricos que não protegem adequadamente o cliente." .

mesh:Skill_ia_finance_gerador_de_contrato_de_prestacao_de_servicos a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-gerador-de-contrato-de-prestacao-de-servicos" ;
    rdfs:label "gerador-de-contrato-de-prestacao-de-servicos" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/gerador-de-contrato-de-prestacao-de-servicos/SKILL.md" ;
    mesh:skillDescription "Gerar contratos completos e juridicamente embasados de prestação de serviços — com escopo, valores, prazos, responsabilidades, cláusulas de proteção e condições de rescisão — personalizados para cada tipo de projeto e cliente. Elimina a dependência de advogado para contratos padrão e garante que cada acordo esteja documentado de forma profissional, protegendo tanto o prestador quanto o contratante." .

mesh:Skill_ia_finance_gerador_de_contratos_de_prestacao_de_servicos a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-gerador-de-contratos-de-prestacao-de-servicos" ;
    rdfs:label "gerador-de-contratos-de-prestacao-de-servicos" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/gerador-de-contratos-de-prestacao-de-servicos/SKILL.md" ;
    mesh:skillDescription "Criar contratos de prestação de serviços jurídicos completos e tecnicamente sólidos — com cláusulas de escopo, honorários, prazo, responsabilidade e rescisão bem redigidas — para que o advogado freelancer pare de usar contratos genéricos ou improvisar, e passe a formalizar cada relação de trabalho com um documento que o proteja e transmita profissionalismo." .

mesh:Skill_ia_finance_gerador_de_parecer_juridico_estruturado a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-gerador-de-parecer-juridico-estruturado" ;
    rdfs:label "gerador-de-parecer-juridico-estruturado" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/gerador-de-parecer-juridico-estruturado/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura e o rascunho de um parecer jurídico completo — com ementa, exposição da consulta, análise técnica fundamentada e conclusão com recomendação clara — para que o advogado produza um documento de alta qualidade intelectual de forma mais rápida, sem abrir mão do rigor técnico que faz do parecer um entregável de alto valor percebido." .

mesh:Skill_ia_finance_gestao_de_inadimplencia_para_clientes_pme a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-gestao-de-inadimplencia-para-clientes-pme" ;
    rdfs:label "gestao-de-inadimplencia-para-clientes-pme" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/gestao-de-inadimplencia-para-clientes-pme/SKILL.md" ;
    mesh:skillDescription "Criar e implementar um sistema completo de gestão de inadimplência para clientes PME — com política de crédito, régua de cobrança automatizável, processo de negociação e métricas de controle — para que o consultor entregue uma solução que resolve um dos principais destruidores de caixa de PMEs e gera resultado mensurável rapidamente." .

mesh:Skill_ia_finance_gestao_financeira_mensal_do_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-gestao-financeira-mensal-do-e-commerce" ;
    rdfs:label "gestao-financeira-mensal-do-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/gestao-financeira-mensal-do-e-commerce/SKILL.md" ;
    mesh:skillDescription "Fazer o fechamento financeiro mensal do e-commerce de forma estruturada — calculando faturamento real, custos, margem de contribuição, lucro líquido e fluxo de caixa. Resolve o problema de quem vende bem mas não sabe se está lucrando, ou sabe que não sobra mas não sabe por quê. Com o fechamento mensal em mãos, as decisões ficam baseadas em dados e não em sensação." .

mesh:Skill_ia_finance_matriz_de_riscos_do_negocio a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-matriz-de-riscos-do-negocio" ;
    rdfs:label "matriz-de-riscos-do-negocio" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/matriz-de-riscos-do-negocio/SKILL.md" ;
    mesh:skillDescription "Criar uma matriz de riscos completa do negócio — identificando, classificando e priorizando os riscos por probabilidade e impacto — com planos de mitigação para cada risco." .

mesh:Skill_ia_finance_nda_acordo_de_confidencialidade a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-nda-acordo-de-confidencialidade" ;
    rdfs:label "nda-acordo-de-confidencialidade" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/nda-acordo-de-confidencialidade/SKILL.md" ;
    mesh:skillDescription "Criar um Acordo de Confidencialidade (NDA) profissional e equilibrado — protegendo informações sensíveis em negociações, parcerias, contratações e prestações de serviço." .

mesh:Skill_ia_finance_nda_e_clausula_de_confidencialidade a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-nda-e-clausula-de-confidencialidade" ;
    rdfs:label "nda-e-clausula-de-confidencialidade" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/nda-e-clausula-de-confidencialidade/SKILL.md" ;
    mesh:skillDescription "Gerar acordos de não divulgação (NDA) completos ou cláusulas de confidencialidade para inserir em contratos — adaptados ao tipo de relacionamento (cliente-fornecedor, parceria, pré-contratação) e ao nível de sensibilidade das informações — em minutos. Um dos documentos mais solicitados por empresas e freelancers, e que muitas vezes é mal elaborado por ser tratado como padrão genérico." .

mesh:Skill_ia_finance_organizacao_de_planilha_financeira_no_excel a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-organizacao-de-planilha-financeira-no-excel" ;
    rdfs:label "organizacao-de-planilha-financeira-no-excel" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/organizacao-de-planilha-financeira-no-excel/SKILL.md" ;
    mesh:skillDescription "Criar e organizar planilhas financeiras no Excel ou Google Sheets para consultores e coaches — com estrutura de controle de receitas por cliente, despesas categorizadas, metas mensais, fluxo de caixa e projeções — para ter clareza financeira real do negócio sem depender de contador para cada consulta. Inclui as fórmulas exatas para cada cálculo, para que qualquer pessoa consiga montar ou corrigir a planilha." .

mesh:Skill_ia_finance_organizacao_financeira_pessoal_e_do_negocio_sem_confusao a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-organizacao-financeira-pessoal-e-do-negocio-sem-confusao" ;
    rdfs:label "organizacao-financeira-pessoal-e-do-negocio-sem-confusao" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/organizacao-financeira-pessoal-e-do-negocio-sem-confusao/SKILL.md" ;
    mesh:skillDescription "Organizar finanças pessoais e empresariais de forma clara — separando o que é de cada área, criando rotina de controle e melhorando a tomada de decisão financeira." .

mesh:Skill_ia_finance_organizacao_financeira_simples_para_empreendedor a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-organizacao-financeira-simples-para-empreendedor" ;
    rdfs:label "organizacao-financeira-simples-para-empreendedor" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/organizacao-financeira-simples-para-empreendedor/SKILL.md" ;
    mesh:skillDescription "Criar um sistema financeiro simples e funcional — para controlar entradas, saídas e lucro sem complicação." .

mesh:Skill_ia_finance_organizador_de_documentos_e_due_diligence a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-organizador-de-documentos-e-due-diligence" ;
    rdfs:label "organizador-de-documentos-e-due-diligence" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/organizador-de-documentos-e-due-diligence/SKILL.md" ;
    mesh:skillDescription "Criar um checklist completo e um processo estruturado de due diligence para análise de documentos — em operações de compra e venda de empresa, entrada de sócio, assinatura de contrato relevante ou análise de risco de cliente — para que o advogado conduza a due diligence de forma organizada, sem perder nenhum documento relevante e com um relatório claro ao final." .

mesh:Skill_ia_finance_pacotizacao_e_precificacao_de_servicos_contabeis a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-pacotizacao-e-precificacao-de-servicos-contabeis" ;
    rdfs:label "pacotizacao-e-precificacao-de-servicos-contabeis" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/pacotizacao-e-precificacao-de-servicos-contabeis/SKILL.md" ;
    mesh:skillDescription "Transformar serviços contábeis avulsos e mal precificados em pacotes estruturados prontos para venda — com nomenclatura atrativa, escopo claro por tier, âncora de preço e argumentação de valor para cada nível — para que o escritório pare de vender \"horas de contador\" e comece a vender soluções completas que o cliente entende, compara e escolhe." .

mesh:Skill_ia_finance_parecer_juridico_estruturado a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-parecer-juridico-estruturado" ;
    rdfs:label "parecer-juridico-estruturado" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/parecer-juridico-estruturado/SKILL.md" ;
    mesh:skillDescription "Elaborar um parecer jurídico completo e tecnicamente fundamentado — com relato da consulta, análise do direito aplicável (legislação, doutrina e jurisprudência), resposta às questões formuladas e conclusão objetiva — a partir de um resumo da situação e da dúvida jurídica. Permite ao advogado produzir pareceres de alta qualidade em fração do tempo habitual, mantendo profundidade técnica e linguagem adequada ao destinatário." .

mesh:Skill_ia_finance_pesquisa_e_analise_de_benchmark_setorial a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-pesquisa-e-analise-de-benchmark-setorial" ;
    rdfs:label "pesquisa-e-analise-de-benchmark-setorial" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/pesquisa-e-analise-de-benchmark-setorial/SKILL.md" ;
    mesh:skillDescription "Estruturar análises de benchmark setorial — comparando os indicadores financeiros e operacionais do cliente com referências do setor — para que o consultor contextualize os problemas do cliente com precisão, identifique onde há gap de desempenho e quais melhorias são realistas para o mercado em que atua." .

mesh:Skill_ia_finance_pesquisa_jurisprudencial_rapida a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-pesquisa-jurisprudencial-rapida" ;
    rdfs:label "pesquisa-jurisprudencial-rapida" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/pesquisa-jurisprudencial-rapida/SKILL.md" ;
    mesh:skillDescription "Estruturar uma pesquisa jurisprudencial e doutrinária completa sobre um tema jurídico específico — identificando os principais precedentes do STF, STJ e tribunais locais, a posição majoritária e as correntes divergentes, os artigos de lei aplicáveis e os argumentos mais utilizados — para subsidiar a elaboração de peças jurídicas com embasamento sólido. Transforma horas de pesquisa em um framework de argumentação pronto para usar." .

mesh:Skill_ia_finance_peticao_inicial_estruturada a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-peticao-inicial-estruturada" ;
    rdfs:label "peticao-inicial-estruturada" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/peticao-inicial-estruturada/SKILL.md" ;
    mesh:skillDescription "Elaborar uma petição inicial completa e tecnicamente fundamentada — com qualificação das partes, narrativa fática persuasiva, fundamentos jurídicos doutrinários e jurisprudenciais, pedidos objetivos e valor da causa — a partir de um resumo dos fatos e do direito pleiteado. Reduz o tempo de redação em até 70% sem comprometer a profundidade técnica, permitindo ao advogado revisar e refinar em vez de começar do zero." .

mesh:Skill_ia_finance_pitch_deck_para_investidor a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-pitch-deck-para-investidor" ;
    rdfs:label "pitch-deck-para-investidor" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/pitch-deck-para-investidor/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura e o conteúdo completo de um pitch deck para apresentação a investidores — com a narrativa certa, os slides essenciais e os dados que investidores realmente querem ver." .

mesh:Skill_ia_finance_planejamento_do_trading_regras_e_plano_operacional a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-planejamento-do-trading-regras-e-plano-operacional" ;
    rdfs:label "planejamento-do-trading-regras-e-plano-operacional" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/planejamento-do-trading-regras-e-plano-operacional/SKILL.md" ;
    mesh:skillDescription "Estruturar o plano operacional de trading no Mini Índice — com regras claras de entrada e saída, gestão de risco por sessão, critérios de interrupção e protocolo de disciplina — para que o operador tenha um sistema definido antes de abrir a plataforma, saiba exatamente o que vai fazer em cada situação e pare de improvisar decisões no calor do mercado." .

mesh:Skill_ia_finance_planejamento_estrategico_anual_para_pme_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-planejamento-estrategico-anual-para-pme-cliente" ;
    rdfs:label "planejamento-estrategico-anual-para-pme-cliente" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/planejamento-estrategico-anual-para-pme-cliente/SKILL.md" ;
    mesh:skillDescription "Conduzir e documentar o planejamento estratégico anual de clientes PME — com análise de cenário, definição de metas financeiras e operacionais, iniciativas prioritárias e OKRs trimestrais — para que o cliente comece o ano (ou qualquer trimestre) com clareza de destino, foco nas iniciativas de maior impacto e um plano que o consultor pode acompanhar e ajustar ao longo do período." .

mesh:Skill_ia_finance_planejamento_orcamentario_anual a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-planejamento-orcamentario-anual" ;
    rdfs:label "planejamento-orcamentario-anual" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/planejamento-orcamentario-anual/SKILL.md" ;
    mesh:skillDescription "Construir o orçamento anual de uma empresa — com projeção de receita por linha, teto de despesas por categoria, margem meta e indicadores de acompanhamento mensal — de forma que o empresário saiba, mês a mês, se está dentro ou fora do plano. Transforma o \"achômetro\" em gestão por números, e permite que o consultor atue de forma proativa em vez de só reportar o passado." .

mesh:Skill_ia_finance_planejamento_tributario_analise_para_empresa a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-planejamento-tributario-analise-para-empresa" ;
    rdfs:label "planejamento-tributario-analise-para-empresa" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/planejamento-tributario-analise-para-empresa/SKILL.md" ;
    mesh:skillDescription "Elaborar uma análise de planejamento tributário para clientes empresariais — comparando regimes tributários (Simples Nacional, Lucro Presumido, Lucro Real), identificando a carga tributária atual versus a ideal, mapeando benefícios fiscais aplicáveis e estruturando um plano de adequação — em linguagem que o empresário entende, com impacto financeiro estimado em reais. Transforma uma área técnica em orientação prática de alto valor percebido." .

mesh:Skill_ia_finance_planilha_de_custos_e_precificacao_de_projetos a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-planilha-de-custos-e-precificacao-de-projetos" ;
    rdfs:label "planilha-de-custos-e-precificacao-de-projetos" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/planilha-de-custos-e-precificacao-de-projetos/SKILL.md" ;
    mesh:skillDescription "Estruturar uma planilha de custos e precificação completa para projetos técnicos — contemplando custo dos equipamentos, mão de obra, impostos, margem de lucro e preço de venda final — para que o gestor nunca mais venda projeto sem saber exatamente quanto vai lucrar, elimine o risco de precificar abaixo do custo real e apresente ao cliente um preço fundamentado que resiste à negociação." .

mesh:Skill_ia_finance_plano_de_acao_financeiro_90_dias_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-plano-de-acao-financeiro-90-dias-para-cliente" ;
    rdfs:label "plano-de-acao-financeiro-90-dias-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/plano-de-acao-financeiro-90-dias-para-cliente/SKILL.md" ;
    mesh:skillDescription "Criar planos de ação financeiros estruturados de 90 dias para clientes de consultoria — com metas claras, iniciativas priorizadas, cronograma semana a semana, responsáveis e indicadores de progresso — para que a consultoria saia do diagnóstico e entre em execução com um roteiro que o cliente consegue seguir e o consultor consegue monitorar." .

mesh:Skill_ia_finance_plano_de_recuperacao_programa_desindividei a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-plano-de-recuperacao-programa-desindividei" ;
    rdfs:label "plano-de-recuperacao-programa-desindividei" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/plano-de-recuperacao-programa-desindividei/SKILL.md" ;
    mesh:skillDescription "Elaborar um plano de recuperação financeira personalizado para clientes superendividados — mapeando todas as dívidas, analisando a capacidade de pagamento, estruturando uma proposta de renegociação com base na Lei 14.181/2021 e gerando o documento de plano para apresentação aos credores ou ao juízo. Acelera o diagnóstico e a proposta que antes demandavam horas de cálculo e redação manual." .

mesh:Skill_ia_finance_plano_de_reducao_de_custos_operacionais a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-plano-de-reducao-de-custos-operacionais" ;
    rdfs:label "plano-de-reducao-de-custos-operacionais" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/plano-de-reducao-de-custos-operacionais/SKILL.md" ;
    mesh:skillDescription "Criar um plano estruturado de redução de custos operacionais — com mapeamento de despesas, identificação de oportunidades de corte ou otimização, e plano de ação por prioridade — para que gestores de pequenas equipes consigam reduzir custos de forma inteligente, sem cortar o que gera resultado e sem comprometer a produtividade ou a qualidade das entregas para o cliente." .

mesh:Skill_ia_finance_politica_de_cancelamento_e_reembolso a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-politica-de-cancelamento-e-reembolso" ;
    rdfs:label "politica-de-cancelamento-e-reembolso" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/politica-de-cancelamento-e-reembolso/SKILL.md" ;
    mesh:skillDescription "Criar uma política de cancelamento e reembolso completa para a clínica — com regras claras para cancelamento de consultas, exames e vacinas, prazos de aviso, condições de reembolso e tratamento de no-show — para reduzir a perda de receita com horários vagos de última hora, alinhar a expectativa dos pacientes e dos profissionais locatários, e ter um documento formal que pode ser apresentado quando houver contestação." .

mesh:Skill_ia_finance_politica_de_escopo_e_gestao_de_mudancas a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-politica-de-escopo-e-gestao-de-mudancas" ;
    rdfs:label "politica-de-escopo-e-gestao-de-mudancas" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/politica-de-escopo-e-gestao-de-mudancas/SKILL.md" ;
    mesh:skillDescription "Criar uma política de escopo clara e um processo de gestão de mudanças estruturado — com definição do que está incluso, protocolo para solicitações fora do escopo e modelo de aditivo — para eliminar o \"scope creep\" que corrói a margem de projetos e consome horas não pagas. Para quem coordena múltiplos projetos, cada pedido extra não cobrado é prejuízo direto na rentabilidade." .

mesh:Skill_ia_finance_politica_de_privacidade_lgpd a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-politica-de-privacidade-lgpd" ;
    rdfs:label "politica-de-privacidade-lgpd" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/politica-de-privacidade-lgpd/SKILL.md" ;
    mesh:skillDescription "Criar uma política de privacidade completa e em conformidade com a LGPD para sites, apps e plataformas digitais — em linguagem clara que cumpre a lei sem ser ilegível para o usuário comum." .

mesh:Skill_ia_finance_precificacao_de_projetos_de_desenvolvimento a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-precificacao-de-projetos-de-desenvolvimento" ;
    rdfs:label "precificacao-de-projetos-de-desenvolvimento" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/precificacao-de-projetos-de-desenvolvimento/SKILL.md" ;
    mesh:skillDescription "Calcular o preço justo e estratégico de projetos de desenvolvimento — considerando horas estimadas, complexidade técnica, valor gerado para o cliente e posicionamento de mercado — para parar de cobrar barato por medo de perder o cliente, parar de cobrar no chute e ter uma lógica de precificação que você consegue explicar e defender com confiança." .

mesh:Skill_ia_finance_precificacao_de_servicos_de_consultoria a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-precificacao-de-servicos-de-consultoria" ;
    rdfs:label "precificacao-de-servicos-de-consultoria" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/precificacao-de-servicos-de-consultoria/SKILL.md" ;
    mesh:skillDescription "Calcular o preço correto para os serviços de consultoria — considerando custo hora real, overhead, margem desejada e posicionamento de mercado — e gerar uma tabela de preços com diferentes pacotes e justificativas de valor. Elimina o \"chuto um número e reza\" na hora de precificar e garante que cada contrato seja lucrativo de verdade." .

mesh:Skill_ia_finance_precificacao_de_servicos_freelancer a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-precificacao-de-servicos-freelancer" ;
    rdfs:label "precificacao-de-servicos-freelancer" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/precificacao-de-servicos-freelancer/SKILL.md" ;
    mesh:skillDescription "Calcular o preço correto para os serviços freelancer — considerando o custo hora real, overhead, impostos, margem desejada e posicionamento de mercado — e gerar uma tabela de serviços com faixas de preço justificadas. Acaba com o \"chuto um número e fico inseguro\" na hora de responder \"quanto custa?\" e garante que cada projeto seja lucrativo de verdade, não só movimentação de dinheiro." .

mesh:Skill_ia_finance_precificacao_e_pacotes_de_servicos_de_marketing_digital a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-precificacao-e-pacotes-de-servicos-de-marketing-digital" ;
    rdfs:label "precificacao-e-pacotes-de-servicos-de-marketing-digital" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/precificacao-e-pacotes-de-servicos-de-marketing-digital/SKILL.md" ;
    mesh:skillDescription "Estruturar a precificação e os pacotes de serviços de marketing digital — com ancoragem de preço, pacotes em 3 níveis e argumentos de valor — para parar de negociar preço a cada novo cliente e ter um cardápio de serviços que facilita a venda, aumenta o ticket médio e gera receita mais previsível." .

mesh:Skill_ia_finance_precificacao_estrategica_de_cosmeticos a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-precificacao-estrategica-de-cosmeticos" ;
    rdfs:label "precificacao-estrategica-de-cosmeticos" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/precificacao-estrategica-de-cosmeticos/SKILL.md" ;
    mesh:skillDescription "Calcular o preço de venda correto para produtos cosméticos — considerando todos os custos reais (produto, embalagem, frete, taxas de plataforma, impostos, marketing), a margem de lucro desejada e o posicionamento de mercado. Evita o erro fatal de precificar no feeling ou olhando só o concorrente, o que leva a vender muito e não sobrar nada." .

mesh:Skill_ia_finance_precificacao_estrategica_de_servicos_de_saude_e_bem_estar a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-precificacao-estrategica-de-servicos-de-saude-e-bem-estar" ;
    rdfs:label "precificacao-estrategica-de-servicos-de-saude-e-bem-estar" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/precificacao-estrategica-de-servicos-de-saude-e-bem-estar/SKILL.md" ;
    mesh:skillDescription "Calcular o preço correto e estruturar pacotes estratégicos de serviços de saúde e bem-estar — com ancoragem de preço, opções que facilitam a decisão do cliente e justificativa de valor — para parar de cobrar por consulta avulsa quando poderia ter programas de maior valor e recorrência." .

mesh:Skill_ia_finance_previsao_de_fluxo_de_caixa a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-previsao-de-fluxo-de-caixa" ;
    rdfs:label "previsao-de-fluxo-de-caixa" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/previsao-de-fluxo-de-caixa/SKILL.md" ;
    mesh:skillDescription "Criar uma previsão de fluxo de caixa completa — mensal e trimestral — com projeção de entradas, saídas, saldo disponível e alertas de risco, para que gestores tomem decisões financeiras com antecedência em vez de reagir a crises de caixa. Com uma boa previsão, você sabe com 30-60 dias de antecedência se vai faltar dinheiro — tempo suficiente para agir antes que o problema aconteça." .

mesh:Skill_ia_finance_projecao_de_fluxo_de_caixa_12_meses a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-projecao-de-fluxo-de-caixa-12-meses" ;
    rdfs:label "projecao-de-fluxo-de-caixa-12-meses" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/projecao-de-fluxo-de-caixa-12-meses/SKILL.md" ;
    mesh:skillDescription "Criar uma projeção de fluxo de caixa detalhada para os próximos 12 meses — incluindo receitas, custos fixos e variáveis, investimentos e sazonalidade — para antecipar meses de aperto e tomar decisões financeiras com segurança." .

mesh:Skill_ia_finance_projecao_de_fluxo_de_caixa_90_dias a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-projecao-de-fluxo-de-caixa-90-dias" ;
    rdfs:label "projecao-de-fluxo-de-caixa-90-dias" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/projecao-de-fluxo-de-caixa-90-dias/SKILL.md" ;
    mesh:skillDescription "Construir uma projeção de fluxo de caixa para os próximos 90 dias com base nas informações do cliente — receitas previstas, compromissos fixos e variáveis, sazonalidade — e entregar três cenários (conservador, realista, otimista) com alertas de risco de liquidez e recomendações de ação preventiva. Permite que o consultor mostre ao cliente o que está por vir antes que vire crise." .

mesh:Skill_ia_finance_proposta_comercial_de_consultoria_financeira a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-proposta-comercial-de-consultoria-financeira" ;
    rdfs:label "proposta-comercial-de-consultoria-financeira" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/proposta-comercial-de-consultoria-financeira/SKILL.md" ;
    mesh:skillDescription "Criar propostas comerciais de consultoria financeira que vão além do escopo e do preço — demonstrando o diagnóstico do problema do cliente, o ROI esperado da consultoria e o risco de não contratar — para que o consultor feche mais contratos de maior valor com clientes que entendem o que estão comprando." .

mesh:Skill_ia_finance_rascunho_de_contrato_de_prestacao_de_servico a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-rascunho-de-contrato-de-prestacao-de-servico" ;
    rdfs:label "rascunho-de-contrato-de-prestacao-de-servico" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/rascunho-de-contrato-de-prestacao-de-servico/SKILL.md" ;
    mesh:skillDescription "Criar um rascunho de contrato de prestação de serviço completo e funcional — com cláusulas essenciais de escopo, pagamento, prazo, propriedade intelectual e rescisão — para que o gestor tenha um documento profissional e protetor para formalizar cada relação com clientes, sem precisar de advogado para todo novo contrato simples." .

mesh:Skill_ia_finance_recurso_de_glosa_de_convenio a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-recurso-de-glosa-de-convenio" ;
    rdfs:label "recurso-de-glosa-de-convenio" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/recurso-de-glosa-de-convenio/SKILL.md" ;
    mesh:skillDescription "Criar uma carta de recurso de glosa completa — com argumentação técnica, embasamento nas normas da ANS e nos guias do convênio, documentação de suporte organizada e solicitação formal de revisão — para contestar glosas indevidas e recuperar receita que foi negada pelo convênio. Em clínicas pequenas, glosas não recorridas representam perda de 5% a 15% da receita anual — dinheiro que já foi gerado e pode ser recuperado." .

mesh:Skill_ia_finance_recurso_e_manifestacao_administrativa_camara_municipal a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-recurso-e-manifestacao-administrativa-camara-municipal" ;
    rdfs:label "recurso-e-manifestacao-administrativa-camara-municipal" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/recurso-e-manifestacao-administrativa-camara-municipal/SKILL.md" ;
    mesh:skillDescription "Elaborar recursos administrativos, manifestações, impugnações e notificações no âmbito da câmara municipal — desde impugnação de ato administrativo até recurso de multa ou resposta a ofício de órgão de controle — com fundamentação na Lei Orgânica, Regimento Interno, Lei 14.133/2021 e princípios do direito administrativo. Permite ao procurador produzir manifestações de qualidade com agilidade, sem perder o rigor técnico exigido pelo controle externo." .

mesh:Skill_ia_finance_redator_de_notificacoes_extrajudiciais a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-redator-de-notificacoes-extrajudiciais" ;
    rdfs:label "redator-de-notificacoes-extrajudiciais" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/redator-de-notificacoes-extrajudiciais/SKILL.md" ;
    mesh:skillDescription "Criar notificações extrajudiciais completas e estrategicamente redigidas — que comunicam a situação jurídica com clareza, estabelecem prazo e consequências, e são calibradas para produzir resultado sem precisar ajuizar — para que o advogado resolva conflitos na fase pré-processual, entregue mais valor ao cliente e economize tempo e custo de todos." .

mesh:Skill_ia_finance_redator_de_peticoes_e_manifestacoes_processuais a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-redator-de-peticoes-e-manifestacoes-processuais" ;
    rdfs:label "redator-de-peticoes-e-manifestacoes-processuais" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/redator-de-peticoes-e-manifestacoes-processuais/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura e o rascunho de petições, contestações, recursos e manifestações processuais — com fundamentos jurídicos organizados, argumentação lógica e linguagem técnica adequada — para que o advogado produza peças de qualidade mais rápido, sem começar do zero toda vez e com argumentos mais sólidos e bem articulados." .

mesh:Skill_ia_finance_relatorio_executivo_de_consultoria_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-relatorio-executivo-de-consultoria-para-cliente" ;
    rdfs:label "relatorio-executivo-de-consultoria-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/relatorio-executivo-de-consultoria-para-cliente/SKILL.md" ;
    mesh:skillDescription "Criar relatórios executivos de consultoria que comunicam com clareza o progresso do trabalho, os resultados alcançados, os desafios encontrados e os próximos passos — para que o cliente perceba valor real a cada entrega, o consultor fortaleça sua autoridade e o relacionamento se mantenha sólido entre as sessões de acompanhamento." .

mesh:Skill_ia_finance_relatorio_financeiro_gerencial_mensal a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-relatorio-financeiro-gerencial-mensal" ;
    rdfs:label "relatorio-financeiro-gerencial-mensal" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/relatorio-financeiro-gerencial-mensal/SKILL.md" ;
    mesh:skillDescription "Gerar um relatório financeiro gerencial completo — com análise de receitas, despesas, margem, fluxo de caixa e variações em relação ao mês anterior e à meta — para que gestores de pequenas equipes possam apresentar a situação financeira do negócio de forma clara, tomar decisões com base em dados e comunicar resultados para sócios ou diretores sem depender de um contador ou analista financeiro para cada relatório." .

mesh:Skill_ia_finance_relatorio_financeiro_mensal_da_clinica a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-relatorio-financeiro-mensal-da-clinica" ;
    rdfs:label "relatorio-financeiro-mensal-da-clinica" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/relatorio-financeiro-mensal-da-clinica/SKILL.md" ;
    mesh:skillDescription "Criar um relatório financeiro mensal completo e simplificado para a clínica — organizando receitas por fonte (convênios, particular, aluguel de sala, vacinas), despesas por categoria, resultado líquido, contas a receber e projeção do próximo mês — para que a gestora tenha visão clara da saúde financeira sem precisar de contador para entender o que está acontecendo. Quem não sabe quanto entra e quanto sai não consegue tomar decisão de crescimento." .

mesh:Skill_ia_finance_relatorio_financeiro_mensal_de_diretoria a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-relatorio-financeiro-mensal-de-diretoria" ;
    rdfs:label "relatorio-financeiro-mensal-de-diretoria" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/relatorio-financeiro-mensal-de-diretoria/SKILL.md" ;
    mesh:skillDescription "Transformar dados financeiros brutos do mês em um relatório executivo claro e orientado a decisão — com análise de receita, margem, custos, fluxo de caixa e projeções — para que o diretor tenha a fotografia financeira do negócio em uma leitura de 10 minutos e chegue à reunião mensal com perguntas, não com dúvidas básicas." .

mesh:Skill_ia_finance_relatorio_financeiro_mensal_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-relatorio-financeiro-mensal-para-cliente" ;
    rdfs:label "relatorio-financeiro-mensal-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/relatorio-financeiro-mensal-para-cliente/SKILL.md" ;
    mesh:skillDescription "Transformar números e dados financeiros do mês em um relatório executivo completo — com análise de fluxo de caixa, DRE simplificado, indicadores-chave e recomendações estratégicas — pronto para ser enviado ou apresentado ao cliente. Elimina as horas gastas formatando e escrevendo texto analítico em cima dos números, entregando um documento que posiciona o consultor como parceiro estratégico, não só como \"o cara dos números\"." .

mesh:Skill_ia_finance_revisao_e_analise_de_contrato a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-revisao-e-analise-de-contrato" ;
    rdfs:label "revisao-e-analise-de-contrato" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/revisao-e-analise-de-contrato/SKILL.md" ;
    mesh:skillDescription "Revisar contratos apresentados por clientes — de prestação de serviços, parceria, fornecimento, locação, licença de software e outros — identificando cláusulas de risco, desequilíbrios, obrigações excessivas e pontos para negociação, entregando um relatório de análise estruturado com semáforo de risco e recomendações objetivas. Permite ao freelancer entregar análises rápidas, completas e de alto valor percebido." .

mesh:Skill_ia_finance_revisor_de_contratos_com_analise_de_risco a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-revisor-de-contratos-com-analise-de-risco" ;
    rdfs:label "revisor-de-contratos-com-analise-de-risco" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/revisor-de-contratos-com-analise-de-risco/SKILL.md" ;
    mesh:skillDescription "Analisar um contrato recebido — de cliente, fornecedor ou contraparte — identificando cláusulas problemáticas, desequilíbrios, ausências relevantes e riscos jurídicos concretos, para que o advogado entregue uma revisão fundamentada e estratégica que vai além da leitura superficial e demonstra real profundidade técnica para o cliente." .

mesh:Skill_ia_finance_revisor_de_guias_de_convenio a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-revisor-de-guias-de-convenio" ;
    rdfs:label "revisor-de-guias-de-convenio" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/revisor-de-guias-de-convenio/SKILL.md" ;
    mesh:skillDescription "Revisar guias de consulta e procedimentos médicos — identificando inconsistências, campos incompletos, códigos incorretos e divergências entre o que foi executado e o que foi registrado — antes do envio ao convênio, para reduzir glosas e retrabalho no faturamento. Para a gestora de clínica que faz o faturamento sozinha, este prompt é o \"segundo par de olhos\" que encontra o erro antes que o convênio encontre." .

mesh:Skill_ia_finance_roteiro_de_apresentacao_de_resultados_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-roteiro-de-apresentacao-de-resultados-para-cliente" ;
    rdfs:label "roteiro-de-apresentacao-de-resultados-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/roteiro-de-apresentacao-de-resultados-para-cliente/SKILL.md" ;
    mesh:skillDescription "Estruturar apresentações de resultados de consultoria que comunicam com clareza e impacto o progresso do trabalho — com narrativa de antes e depois, quantificação dos resultados, aprendizados do período e visão de próximos passos — para que o cliente saia da reunião reconhecendo o valor entregue e esteja preparado para renovar ou expandir o contrato." .

mesh:Skill_ia_finance_simplificador_de_linguagem_juridica_para_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-simplificador-de-linguagem-juridica-para-clientes" ;
    rdfs:label "simplificador-de-linguagem-juridica-para-clientes" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/simplificador-de-linguagem-juridica-para-clientes/SKILL.md" ;
    mesh:skillDescription "Transformar documentos jurídicos, pareceres, cláusulas ou explicações técnicas em comunicação clara, objetiva e compreensível para clientes sem formação jurídica — para que o advogado pare de enviar PDFs com jargão que o cliente não entende e passe a ser percebido como um parceiro que explica bem, aumentando satisfação, confiança e retenção de clientes." .

mesh:Skill_ia_finance_sistema_de_acoes_para_aumentar_faturamento a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-sistema-de-acoes-para-aumentar-faturamento" ;
    rdfs:label "sistema-de-acoes-para-aumentar-faturamento" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/sistema-de-acoes-para-aumentar-faturamento/SKILL.md" ;
    mesh:skillDescription "Gerar mais receita com ações simples e diretas." .

mesh:Skill_ia_finance_sistema_de_analise_de_investimentos a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-sistema-de-analise-de-investimentos" ;
    rdfs:label "sistema-de-analise-de-investimentos" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/sistema-de-analise-de-investimentos/SKILL.md" ;
    mesh:skillDescription "Analisar oportunidades de investimento com clareza." .

mesh:Skill_ia_finance_sistema_de_analise_financeira_simplificada a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-sistema-de-analise-financeira-simplificada" ;
    rdfs:label "sistema-de-analise-financeira-simplificada" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/sistema-de-analise-financeira-simplificada/SKILL.md" ;
    mesh:skillDescription "Entender claramente entradas, saídas e lucro do negócio." .

mesh:Skill_ia_finance_sistema_de_controle_de_prazos_e_intimacoes a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-sistema-de-controle-de-prazos-e-intimacoes" ;
    rdfs:label "sistema-de-controle-de-prazos-e-intimacoes" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/sistema-de-controle-de-prazos-e-intimacoes/SKILL.md" ;
    mesh:skillDescription "Criar um sistema completo de controle de prazos e intimações processuais — com lógica de registro, alertas, classificação por urgência e acompanhamento de movimentações — para que o advogado freelancer nunca perca um prazo por desorganização, tenha visão clara de todos os processos em andamento e passe a operar com a segurança de um escritório estruturado." .

