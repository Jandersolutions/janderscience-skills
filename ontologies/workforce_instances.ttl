    mesh:skillDescription "Mapear e estruturar processos do negócio — transformando tarefas soltas em fluxos organizados e replicáveis para ganhar eficiência e reduzir retrabalho." .

mesh:Skill_ia_operations_organizador_de_processos_do_freelancer_sobrecarregado a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-organizador-de-processos-do-freelancer-sobrecarregado" ;
    rdfs:label "organizador-de-processos-do-freelancer-sobrecarregado" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/organizador-de-processos-do-freelancer-sobrecarregado/SKILL.md" ;
    mesh:skillDescription "Mapear, documentar e organizar todos os processos do negócio freelancer de saúde e bem-estar — desde captação até pós-atendimento — para eliminar retrabalho, reduzir o tempo gasto em tarefas repetitivas e criar um sistema que funciona de forma consistente mesmo quando você está cansado ou sobrecarregado." .

mesh:Skill_ia_operations_painel_de_indicadores_operacionais a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-painel-de-indicadores-operacionais" ;
    rdfs:label "painel-de-indicadores-operacionais" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/painel-de-indicadores-operacionais/SKILL.md" ;
    mesh:skillDescription "Definir os indicadores certos para cada departamento da empresa e estruturar um painel de acompanhamento gerencial — com métricas, metas, frequência de atualização e semáforos de alerta — para que o diretor monitore a saúde do negócio em uma única visão sem precisar ficar perguntando o que está acontecendo no operacional." .

mesh:Skill_ia_operations_painel_geral_de_negocio_vida_e_financas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-painel-geral-de-negocio-vida-e-financas" ;
    rdfs:label "painel-geral-de-negocio-vida-e-financas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
