mesh:Skill_ia_demand_generation_repurposing_de_conteudo a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-repurposing-de-conteudo" ;
    rdfs:label "repurposing-de-conteudo" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/repurposing-de-conteudo/SKILL.md" ;
    mesh:skillDescription "Transformar um único conteúdo — um vídeo, artigo, carrossel ou live — em até 7 formatos prontos para diferentes plataformas e momentos da semana, para que o empreendedor solo multiplique sua produção sem criar do zero toda vez, acabando com o ciclo de sobrecarregar a cabeça tentando ter novas ideias enquanto já tem ouro não aproveitado." .

mesh:Skill_ia_demand_generation_respostas_padrao_para_pacientes a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-respostas-padrao-para-pacientes" ;
    rdfs:label "respostas-padrao-para-pacientes" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/respostas-padrao-para-pacientes/SKILL.md" ;
    mesh:skillDescription "Criar um banco completo de respostas prontas para as perguntas mais frequentes de pacientes — sobre agendamento, valores, convênios, exames, vacinas, aparelhos auditivos e orientações pré e pós atendimento — para que a gestora da clínica responda com velocidade e profissionalismo sem precisar escrever do zero cada vez. Economiza até 2 horas por dia em comunicação e garante consistência nas informações transmitidas." .

mesh:Skill_ia_demand_generation_roteiro_de_carrossel_educativo a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-roteiro-de-carrossel-educativo" ;
