    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/analise-rapida-de-concorrencia/SKILL.md" ;
    mesh:skillDescription "Fazer uma análise competitiva estruturada de um ou mais concorrentes — avaliando posicionamento, comunicação, ofertas e pontos fracos — para identificar oportunidades de diferenciação e construir uma estratégia de marketing que seja relevante no mercado onde o negócio compete." .

mesh:Skill_ia_marketing_apresentacao_de_captacao_para_proprietario a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-apresentacao-de-captacao-para-proprietario" ;
