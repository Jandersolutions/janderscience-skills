    mesh:skillDescription "Analisar a identidade visual dos principais concorrentes do cliente — mapeando padrões visuais, convenções do segmento e espaços em branco — para criar uma identidade visual que se diferencie estrategicamente em vez de seguir o mesmo padrão visual de todo o mercado." .

mesh:Skill_ia_marketing_analise_de_concorrente_e_posicionamento_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-analise-de-concorrente-e-posicionamento-e-commerce" ;
