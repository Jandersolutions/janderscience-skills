    mesh:skillDescription "Transformar depoimentos e resultados de clientes em posts de redes sociais estruturados que geram prova social, confiança e desejo de compra." .

mesh:Skill_ia_demand_generation_post_de_lancamento_de_produtoservico a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-post-de-lancamento-de-produtoservico" ;
