    mesh:skillDescription "Otimizar cada seção do perfil do LinkedIn — headline, sobre, experiências, destaques e skills — para atrair oportunidades profissionais, gerar conexões estratégicas e posicionar-se como referência na sua área." .

mesh:Skill_ia_people_planejamento_estrategico_consultor_de_ia_solo a mesh:Skill ;
    mesh:skillIdentifier "ia-people-planejamento-estrategico-consultor-de-ia-solo" ;
