    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/transformador-de-ideia-em-carrossel/SKILL.md" ;
    mesh:skillDescription "Transformar uma ideia solta em um roteiro de carrossel completo — slide por slide, com título, texto, visual sugerido e CTA final — para que o empreendedor solo passe direto da ideia para a produção sem perder horas estruturando o conteúdo, produzindo carrosséis que educam, engajam e geram salvamentos." .

mesh:Skill_ia_demand_generation_transformar_ideia_em_post a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-transformar-ideia-em-post" ;
