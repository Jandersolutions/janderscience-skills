    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/pagina-de-venda-express/SKILL.md" ;
    mesh:skillDescription "Criar uma página de vendas completa — do headline ao botão de compra — com todos os blocos persuasivos necessários para converter visitantes em compradores, para que o empreendedor solo tenha uma página que vende mesmo enquanto dorme, sem precisar contratar um copywriter ou estudar anos de marketing para escrever algo que realmente funcione." .

mesh:Skill_ia_marketing_pesquisa_de_persona_e_icp a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-pesquisa-de-persona-e-icp" ;
    rdfs:label "pesquisa-de-persona-e-icp" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/pesquisa-de-persona-e-icp/SKILL.md" ;
    mesh:skillDescription "Construir um ICP (Ideal Customer Profile) e persona completos para guiar a estratégia de tráfego pago de um cliente — com mapeamento de dores, desejos, objeções, linguagem e comportamento online — para criar anúncios que falam diretamente com quem tem mais probabilidade de comprar, reduzir CPL e aumentar taxa de conversão." .

mesh:Skill_ia_marketing_pesquisa_e_perfil_de_publico_alvo a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-pesquisa-e-perfil-de-publico-alvo" ;
    rdfs:label "pesquisa-e-perfil-de-publico-alvo" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/pesquisa-e-perfil-de-publico-alvo/SKILL.md" ;
    mesh:skillDescription "Pesquisar e construir o perfil detalhado do público-alvo de uma campanha — incluindo dados demográficos, comportamentais, psicográficos e de segmentação para anúncios — fornecendo a base para decisões de criativo, copy e distribuição de mídia. Transforma o \"meu público é todo mundo que precisa disso\" em um retrato preciso que melhora a relevância e reduz o custo por resultado." .

mesh:Skill_ia_marketing_pitch_de_60_segundos a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-pitch-de-60-segundos" ;
    rdfs:label "pitch-de-60-segundos" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/pitch-de-60-segundos/SKILL.md" ;
    mesh:skillDescription "Criar um pitch de 60 segundos estruturado e memorável — para vídeos de apresentação, eventos, lives, stories ou conversas — que comunica claramente quem você atende, qual problema resolve, como resolve e por que é diferente, para que o empreendedor solo nunca mais trave quando alguém pergunta \"o que você faz?\" e sempre saia da conversa tendo gerado interesse ou uma lead." .

mesh:Skill_ia_marketing_pitch_de_venda_de_identidade_visual a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-pitch-de-venda-de-identidade-visual" ;
    rdfs:label "pitch-de-venda-de-identidade-visual" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/pitch-de-venda-de-identidade-visual/SKILL.md" ;
    mesh:skillDescription "Criar um pitch de venda personalizado para abordar potenciais clientes e oferecer serviços de identidade visual — de forma natural, sem parecer vendedor chato — para quem está começando e ainda não tem um fluxo constante de indicações e precisa prospectar ativamente." .

mesh:Skill_ia_marketing_pitch_para_decisores_executivos a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-pitch-para-decisores-executivos" ;
    rdfs:label "pitch-para-decisores-executivos" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/pitch-para-decisores-executivos/SKILL.md" ;
    mesh:skillDescription "Estruturar um pitch consultivo e persuasivo para apresentar projetos de segurança, smartcity ou sonorização a decisores executivos que não têm formação técnica — conectando o problema do negócio deles à solução técnica em linguagem de resultado e risco — para que o gestor nunca mais perca um projeto aprovável por falta de clareza ao vender para quem realmente decide, independente de onde a reunião acontece." .

mesh:Skill_ia_marketing_planejamento_de_calendario_promocional_de_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-planejamento-de-calendario-promocional-de-e-commerce" ;
    rdfs:label "planejamento-de-calendario-promocional-de-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/planejamento-de-calendario-promocional-de-e-commerce/SKILL.md" ;
    mesh:skillDescription "Criar o calendário promocional estratégico do trimestre — com datas selecionadas, mecânicas de oferta, cronograma de execução e responsáveis — para parar de criar campanha na última hora, garantir que o time saiba o que vem por aí com antecedência e maximizar o faturamento nas janelas de maior intenção de compra." .

mesh:Skill_ia_marketing_planejamento_de_campanha_de_produto_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-planejamento-de-campanha-de-produto-e-commerce" ;
    rdfs:label "planejamento-de-campanha-de-produto-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/planejamento-de-campanha-de-produto-e-commerce/SKILL.md" ;
    mesh:skillDescription "Criar um plano de campanha completo para um produto de e-commerce — seja lançamento, queima de estoque, data comemorativa ou oferta relâmpago — com cronograma, copies principais, canais, sequência de posts e métricas de acompanhamento, tudo estruturado para um empreendedor solo executar sem equipe." .

mesh:Skill_ia_marketing_planejamento_de_campanha_do_zero a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-planejamento-de-campanha-do-zero" ;
    rdfs:label "planejamento-de-campanha-do-zero" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/planejamento-de-campanha-do-zero/SKILL.md" ;
    mesh:skillDescription "Criar o plano completo de uma campanha de marketing do zero — definindo estratégia, canais, distribuição de budget, cronograma de execução e métricas de sucesso — com base no objetivo de negócio e no contexto do cliente. Transforma uma demanda vaga em um plano executável com clareza de o que fazer, quando e como medir." .

mesh:Skill_ia_marketing_planejamento_de_conteudo_de_especialista a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-planejamento-de-conteudo-de-especialista" ;
    rdfs:label "planejamento-de-conteudo-de-especialista" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/planejamento-de-conteudo-de-especialista/SKILL.md" ;
    mesh:skillDescription "Criar o plano de conteúdo mensal completo para consultores, coaches e especialistas — com pauta estratégica que equilibra conteúdo de atração (novos seguidores), nutrição (aprofundar autoridade) e conversão (gerar leads e propostas). Resolve o problema da inconsistência: com o plano em mãos, você sabe o que criar todo dia sem improvisar e sem perder o foco de construir autoridade." .

mesh:Skill_ia_marketing_planejamento_de_conteudo_mensal a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-planejamento-de-conteudo-mensal" ;
    rdfs:label "planejamento-de-conteudo-mensal" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/planejamento-de-conteudo-mensal/SKILL.md" ;
    mesh:skillDescription "Criar um plano de conteúdo mensal completo para redes sociais — com temas, formatos, frequência e objetivos estratégicos por semana — para empreendedoras solos que precisam postar com consistência sem passar horas planejando. Cada semana tem uma intenção de negócio e os conteúdos servem essa intenção, não são publicados aleatoriamente." .

mesh:Skill_ia_marketing_planejamento_de_lancamento_de_campanha a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-planejamento-de-lancamento-de-campanha" ;
    rdfs:label "planejamento-de-lancamento-de-campanha" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/planejamento-de-lancamento-de-campanha/SKILL.md" ;
    mesh:skillDescription "Estruturar um lançamento de campanha de marketing do zero — com fases definidas, cronograma, entregas, responsáveis e pontos de checagem — para que o time execute o lançamento de forma coordenada, sem improvisar no último momento nem esquecer etapas críticas que impactam o resultado." .

mesh:Skill_ia_marketing_planejamento_de_lancamento_digital a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-planejamento-de-lancamento-digital" ;
    rdfs:label "planejamento-de-lancamento-digital" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/planejamento-de-lancamento-digital/SKILL.md" ;
    mesh:skillDescription "Criar o plano completo de um lançamento digital — com cronograma detalhado, estratégia de conteúdo de pré-lançamento, sequência de e-mails, scripts de stories e táticas de fechamento — para lançar um produto ou serviço de forma organizada e maximizar as vendas na janela de abertura de carrinho." .

mesh:Skill_ia_marketing_planejamento_de_marketing_mensal_para_imobiliaria a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-planejamento-de-marketing-mensal-para-imobiliaria" ;
    rdfs:label "planejamento-de-marketing-mensal-para-imobiliaria" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/planejamento-de-marketing-mensal-para-imobiliaria/SKILL.md" ;
    mesh:skillDescription "Criar um plano de marketing mensal completo para a imobiliária — com ações definidas por canal (Instagram, portais, tráfego pago, WhatsApp, indicações), orçamento distribuído, responsáveis e KPIs de acompanhamento — para transformar o marketing de esporádico e intuitivo em uma máquina previsível de geração de leads que o gestor consegue acompanhar e melhorar todo mês." .

mesh:Skill_ia_marketing_plano_de_90_dias_para_monetizar_nas_redes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-plano-de-90-dias-para-monetizar-nas-redes" ;
    rdfs:label "plano-de-90-dias-para-monetizar-nas-redes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/plano-de-90-dias-para-monetizar-nas-redes/SKILL.md" ;
    mesh:skillDescription "Criar um plano estratégico completo de 90 dias — dividido em 3 fases de 30 dias — para sair do zero (ou de um perfil estagnado) e gerar as primeiras vendas com conteúdo nas redes sociais. Inclui metas semanais, ações prioritárias, conteúdo a criar, produto a lançar e métricas de acompanhamento, para que você tenha um mapa claro de onde está, onde quer chegar e o que fazer em cada semana." .

mesh:Skill_ia_marketing_plano_de_captacao_de_pacientes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-plano-de-captacao-de-pacientes" ;
    rdfs:label "plano-de-captacao-de-pacientes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/plano-de-captacao-de-pacientes/SKILL.md" ;
    mesh:skillDescription "Criar um plano de captação de novos pacientes completo — com estratégias por canal (Google, Instagram, parcerias, indicação, WhatsApp) adaptadas para cada serviço da clínica (audiologia, vacinas, laboratório, aluguel de sala) — priorizando as ações de maior retorno para quem está começando sem equipe e sem verba de marketing. O objetivo não é estar em todo lugar, é estar nos lugares certos com a mensagem certa." .

mesh:Skill_ia_marketing_plano_de_otimizacao_de_campanha a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-plano-de-otimizacao-de-campanha" ;
    rdfs:label "plano-de-otimizacao-de-campanha" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/plano-de-otimizacao-de-campanha/SKILL.md" ;
    mesh:skillDescription "Criar um plano de otimização contínua de campanha paga — definindo o que verificar, o que ajustar e em que ordem — para profissionais que gerenciam campanhas e precisam de um processo estruturado de melhoria de performance. Elimina o \"o que mexo agora?\" e substitui por uma rotina de otimização sistemática com critérios claros." .

mesh:Skill_ia_marketing_plano_de_otimizacao_de_campanha_facebook_ads a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-plano-de-otimizacao-de-campanha-facebook-ads" ;
    rdfs:label "plano-de-otimizacao-de-campanha-facebook-ads" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/plano-de-otimizacao-de-campanha-facebook-ads/SKILL.md" ;
    mesh:skillDescription "Criar um plano de otimização estruturado e priorizado para campanhas no Facebook Ads — com diagnóstico por nível (campanha, conjunto, anúncio), hipóteses de teste e ações ordenadas por impacto — para que o gestor saiba exatamente o que ajustar, em qual ordem e como medir se a mudança funcionou." .

mesh:Skill_ia_marketing_playbook_de_oferta_de_investimento a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-playbook-de-oferta-de-investimento" ;
    rdfs:label "playbook-de-oferta-de-investimento" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
