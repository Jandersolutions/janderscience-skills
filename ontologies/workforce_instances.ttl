    mesh:skillSourcePath "sources/skills-ia/skills/rotina/skills/gestao-de-multiplos-projetos-simultaneos/SKILL.md" ;
    mesh:skillDescription "Criar um sistema leve e prático de gestão para freelancers que tocam múltiplos projetos ao mesmo tempo — com painel de status, priorização por prazo e risco, rituais de acompanhamento e alertas de atenção — para nunca mais chegar na semana de entrega descobrindo que um projeto está atrasado, e ter clareza visual de onde cada projeto está a qualquer momento." .

mesh:Skill_ia_operations_gestor_de_tempo_para_freelancer_criativo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gestor-de-tempo-para-freelancer-criativo" ;
