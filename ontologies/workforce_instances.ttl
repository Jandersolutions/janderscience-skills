    mesh:skillDescription "Gerar contratos jurídicos personalizados com base no contexto do cliente — estruturados, completos e prontos para revisão final, economizando tempo na produção." .

mesh:Skill_ia_legal_risk_gerador_de_manifestacao_em_processo_tributario a mesh:Skill ;
    mesh:skillIdentifier "ia-legal-risk-gerador-de-manifestacao-em-processo-tributario" ;
    rdfs:label "gerador-de-manifestacao-em-processo-tributario" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/juridico-advocacia/skills/gerador-de-manifestacao-em-processo-tributario/SKILL.md" ;
    mesh:skillDescription "Gerar manifestações processuais rápidas para as situações mais recorrentes em processos tributários — impugnação de tutela de urgência, nota de expediente, informações em mandado de segurança, petições simples, requerimento de prazo — para que o Procurador produza peças curtas com agilidade sem precisar escrever do zero cada vez." .

mesh:Skill_ia_legal_risk_gerador_de_peticoes_estruturadas_com_teses_estrategicas a mesh:Skill ;
    mesh:skillIdentifier "ia-legal-risk-gerador-de-peticoes-estruturadas-com-teses-estrategicas" ;
