    mesh:skillDescription "Criar bios otimizadas e persuasivas para Instagram e LinkedIn de profissionais de saúde e bem-estar — que comunicam quem você atende, o que resolve e por que você — para transformar visitantes do perfil em seguidores qualificados e leads que chegam ao DM prontos para conversar." .

mesh:Skill_ia_people_branding_e_identidade_do_escritorio_contabil a mesh:Skill ;
    mesh:skillIdentifier "ia-people-branding-e-identidade-do-escritorio-contabil" ;
