    mesh:skillSourcePath "sources/skills-ia/skills/produto/skills/project-charter-termo-de-abertura/SKILL.md" ;
    mesh:skillDescription "Criar um Project Charter completo que alinha todas as partes interessadas antes de iniciar um projeto — definindo escopo, objetivos, stakeholders, riscos e critérios de sucesso — para evitar o clássico 'não era isso que eu esperava' no meio do caminho." .

mesh:Skill_ia_product_relatorio_de_analise_de_mercado a mesh:Skill ;
    mesh:skillIdentifier "ia-product-relatorio-de-analise-de-mercado" ;
