    mesh:skillDescription "Controlar entradas e saídas de forma fácil." .

mesh:Skill_ia_finance_controle_financeiro_da_imobiliaria a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-controle-financeiro-da-imobiliaria" ;
    rdfs:label "controle-financeiro-da-imobiliaria" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/controle-financeiro-da-imobiliaria/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura completa de controle financeiro para a imobiliária — com categorização de receitas e custos, modelo de fluxo de caixa, indicadores de saúde financeira e rotina de fechamento mensal — para sair do \"não sei exatamente o que sobra no fim do mês\" e ter clareza total sobre a rentabilidade real do negócio e a capacidade de crescimento." .

mesh:Skill_ia_finance_controle_financeiro_de_freelancer a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-controle-financeiro-de-freelancer" ;
    rdfs:label "controle-financeiro-de-freelancer" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
