    mesh:skillDescription "Atrair, educar e converter clientes por meio de conteúdo estratégico." .

mesh:Skill_ia_marketing_gerador_de_conceito_de_marca a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-gerador-de-conceito-de-marca" ;
    rdfs:label "gerador-de-conceito-de-marca" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/gerador-de-conceito-de-marca/SKILL.md" ;
    mesh:skillDescription "Criar o conceito estratégico completo de uma marca — arquétipo, personalidade, posicionamento, tom de voz e direção criativa — antes de abrir qualquer software de design, para parar de criar logos no achismo e começar a tomar decisões visuais com fundamento estratégico que o cliente entende e aprova." .

mesh:Skill_ia_marketing_gerador_de_depoimento_de_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-gerador-de-depoimento-de-cliente" ;
    rdfs:label "gerador-de-depoimento-de-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/gerador-de-depoimento-de-cliente/SKILL.md" ;
    mesh:skillDescription "Criar o script para pedir depoimento ao cliente de forma que ele responda com as informações certas — e transformar a resposta dele em um depoimento formatado, poderoso e estratégico — para construir prova social que converte novos clientes mesmo com poucos trabalhos no portfólio." .

mesh:Skill_ia_marketing_gerador_de_moodboard_textual a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-gerador-de-moodboard-textual" ;
    rdfs:label "gerador-de-moodboard-textual" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/gerador-de-moodboard-textual/SKILL.md" ;
    mesh:skillDescription "Criar um moodboard textual completo — com direção criativa, descrição de referências visuais, paleta de cores com códigos, estilo tipográfico e sensações-guia — para usar como bússola criativa antes de abrir qualquer software, sem precisar de ferramentas de design para documentar a direção do projeto." .

mesh:Skill_ia_marketing_gerador_de_nomes_de_marca a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-gerador-de-nomes-de-marca" ;
    rdfs:label "gerador-de-nomes-de-marca" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/gerador-de-nomes-de-marca/SKILL.md" ;
    mesh:skillDescription "Gerar opções estratégicas de nomes de marca — com diferentes abordagens criativas, análise de significado e checklist de disponibilidade — para entregar ao cliente uma etapa de naming profissional que agrega valor ao projeto de branding e justifica um ticket maior." .

mesh:Skill_ia_marketing_gerador_de_proposta_comercial_estruturada a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-gerador-de-proposta-comercial-estruturada" ;
    rdfs:label "gerador-de-proposta-comercial-estruturada" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/gerador-de-proposta-comercial-estruturada/SKILL.md" ;
    mesh:skillDescription "Criar uma proposta comercial completa, profissional e persuasiva — com estrutura que guia o leitor do problema até a solução e o preço — para que o gestor pare de entregar documentos genéricos ou mal estruturados e comece a apresentar propostas que transmitem competência e aceleram o fechamento." .

mesh:Skill_ia_marketing_gestao_de_objecoes_em_vendas a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-gestao-de-objecoes-em-vendas" ;
    rdfs:label "gestao-de-objecoes-em-vendas" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/gestao-de-objecoes-em-vendas/SKILL.md" ;
    mesh:skillDescription "Criar respostas estratégicas para objeções comuns — aumentando confiança e taxa de fechamento." .

mesh:Skill_ia_marketing_hipoteses_e_plano_de_testes_ab a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-hipoteses-e-plano-de-testes-ab" ;
    rdfs:label "hipoteses-e-plano-de-testes-ab" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/hipoteses-e-plano-de-testes-ab/SKILL.md" ;
    mesh:skillDescription "Criar hipóteses embasadas e um plano de testes A/B estruturado para campanhas de marketing — definindo o que testar, por que, como e quando — com critérios claros de decisão para que o resultado do teste leve a uma ação, não a mais dúvidas. Transforma o \"vamos testar tudo\" em uma agenda de testes com prioridade e lógica científica." .

mesh:Skill_ia_marketing_hook_de_criativo_para_ads a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-hook-de-criativo-para-ads" ;
    rdfs:label "hook-de-criativo-para-ads" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/hook-de-criativo-para-ads/SKILL.md" ;
    mesh:skillDescription "Criar 10 opções de hooks (ganchos) para os primeiros 3 segundos de criativos de anúncio — em vídeo ou imagem — otimizados para parar o scroll no Facebook e TikTok. O hook é o único elemento que determina se o anúncio vai ser assistido ou pulado, e é a variável que mais impacta o CTR e o custo por clique. Trocar o hook de um criativo que não performa é o teste de mais baixo custo e mais alto impacto em tráfego pago." .

mesh:Skill_ia_marketing_identidade_visual_e_branding_para_criador_de_conteudo a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-identidade-visual-e-branding-para-criador-de-conteudo" ;
    rdfs:label "identidade-visual-e-branding-para-criador-de-conteudo" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/identidade-visual-e-branding-para-criador-de-conteudo/SKILL.md" ;
    mesh:skillDescription "Criar um guia completo de identidade visual e branding para criadores de conteúdo e marcas pessoais — com paleta de cores, tipografia, tom de voz, diretrizes visuais e aplicação nos formatos do Instagram — para que todos os posts, Stories e criativos tenham coesão visual imediata, transmitam profissionalismo e façam o perfil ser reconhecido no scroll sem precisar ver o nome da conta." .

mesh:Skill_ia_marketing_isca_digital_de_alta_conversao a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-isca-digital-de-alta-conversao" ;
    rdfs:label "isca-digital-de-alta-conversao" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/isca-digital-de-alta-conversao/SKILL.md" ;
    mesh:skillDescription "Criar o conceito, estrutura e copy completo de uma isca digital — e-book, checklist, mini curso, template ou masterclass — que atrai leads qualificados para o seu produto principal. Inclui o nome da isca, a promessa, a estrutura de conteúdo e o copy da página de captura, para que você tenha uma máquina de captação de leads rodando com o mínimo de esforço de produção." .

mesh:Skill_ia_marketing_isca_digital_para_captacao_de_leads_contabeis a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-isca-digital-para-captacao-de-leads-contabeis" ;
    rdfs:label "isca-digital-para-captacao-de-leads-contabeis" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/isca-digital-para-captacao-de-leads-contabeis/SKILL.md" ;
    mesh:skillDescription "Criar iscas digitais completas — e-books, checklists, calculadoras descritivas e guias práticos — para capturar leads qualificados de donos de empresa interessados em serviços contábeis, gerando uma lista de potenciais clientes que podem ser nutridos até o momento da contratação, sem depender apenas de indicações ou tráfego pago recorrente." .

mesh:Skill_ia_marketing_mapa_de_objecoes_do_produtoservico a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-mapa-de-objecoes-do-produtoservico" ;
    rdfs:label "mapa-de-objecoes-do-produtoservico" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/mapa-de-objecoes-do-produtoservico/SKILL.md" ;
    mesh:skillDescription "Criar um mapa completo de todas as objeções que o público-alvo pode ter antes de comprar — classificadas por tipo, gravidade e fase do funil — com respostas prontas para cada uma, usáveis em vendas, copy, FAQ e treinamento." .

mesh:Skill_ia_marketing_mapeamento_de_jornada_do_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-mapeamento-de-jornada-do-cliente" ;
    rdfs:label "mapeamento-de-jornada-do-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/mapeamento-de-jornada-do-cliente/SKILL.md" ;
    mesh:skillDescription "Criar o mapa completo da jornada do cliente (customer journey map) — desde o primeiro contato com a marca até a fidelização — identificando cada ponto de contato, emoção e oportunidade de melhoria." .

mesh:Skill_ia_marketing_newsletter_e_comunicado_para_base_de_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-newsletter-e-comunicado-para-base-de-clientes" ;
    rdfs:label "newsletter-e-comunicado-para-base-de-clientes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/newsletter-e-comunicado-para-base-de-clientes/SKILL.md" ;
    mesh:skillDescription "Criar newsletters mensais e comunicados estratégicos para a base de clientes do escritório contábil — com novidades tributárias, dicas financeiras práticas e atualizações do escritório — para manter o cliente engajado, demonstrar valor proativo, reduzir churn por percepção de inatividade e abrir oportunidades naturais de upsell de novos serviços." .

mesh:Skill_ia_marketing_newsletter_email_para_base_de_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-newsletter-email-para-base-de-clientes" ;
    rdfs:label "newsletter-email-para-base-de-clientes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/newsletter-email-para-base-de-clientes/SKILL.md" ;
    mesh:skillDescription "Criar emails periódicos para manter contato com clientes e leads da base — com conteúdo útil sobre contratos, direitos e proteção jurídica — que geram recompra, indicações e novas vendas sem parecer spam ou pressão de venda. O freelancer que mantém contato regular com sua base fatura de forma previsível; o que não mantém depende sempre de captar do zero." .

mesh:Skill_ia_marketing_pagina_de_venda_express a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-pagina-de-venda-express" ;
    rdfs:label "pagina-de-venda-express" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
