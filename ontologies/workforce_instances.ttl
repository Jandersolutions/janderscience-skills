    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/pesquisa-rapida-e-sintese-de-mercado/SKILL.md" ;
    mesh:skillDescription "Estruturar pesquisas de mercado, análise de concorrência e mapeamento de tendências de forma rápida e com síntese acionável — identificando oportunidades, ameaças e posicionamento — para que o gestor tome decisões estratégicas com base em contexto real de mercado, não em intuição ou suposição." .

mesh:Skill_ia_operations_planejamento_estrategico_de_90_dias a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-planejamento-estrategico-de-90-dias" ;
