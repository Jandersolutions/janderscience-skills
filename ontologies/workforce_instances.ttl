    mesh:skillDescription "Transformar casos jurídicos reais em cases de sucesso anonimizados — seguindo as regras éticas da OAB — para uso em conteúdo de redes sociais, propostas comerciais e apresentações, criando narrativas de \"problema > estratégia > resultado\" que geram prova social poderosa, aumentam a confiança de potenciais clientes e diferenciam o advogado de concorrentes que não mostram resultados." .

mesh:Skill_ia_marketing_apresentacao_de_identidade_visual_ao_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-apresentacao-de-identidade-visual-ao-cliente" ;
    rdfs:label "apresentacao-de-identidade-visual-ao-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/apresentacao-de-identidade-visual-ao-cliente/SKILL.md" ;
    mesh:skillDescription "Criar o roteiro completo e os textos para apresentar uma identidade visual ao cliente — justificando cada decisão criativa com linguagem que o cliente entende — para transformar a apresentação em um momento de aprovação emocionante, não em uma negociação sobre cor de logo." .

mesh:Skill_ia_marketing_apresentacao_de_proposta_em_reuniao a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-apresentacao-de-proposta-em-reuniao" ;
    rdfs:label "apresentacao-de-proposta-em-reuniao" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/apresentacao-de-proposta-em-reuniao/SKILL.md" ;
    mesh:skillDescription "Criar o roteiro completo e a estrutura de slides para apresentar uma proposta de consultoria ou coaching ao vivo — conduzindo a reunião de apresentação de forma que o cliente se sinta compreendido, veja o valor claramente e seja guiado naturalmente para o \"sim\". Diferente da proposta escrita enviada por e-mail, a apresentação ao vivo permite adaptar o tom, responder objeções em tempo real e fechar na mesma reunião." .

mesh:Skill_ia_marketing_apresentacao_executiva_de_projeto a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-apresentacao-executiva-de-projeto" ;
    rdfs:label "apresentacao-executiva-de-projeto" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/apresentacao-executiva-de-projeto/SKILL.md" ;
    mesh:skillDescription "Transformar dados técnicos de um projeto — especificações, topologia, lista de itens — em uma apresentação executiva clara e persuasiva para decisores que não têm formação técnica (diretores, CEOs, secretários municipais, síndicos), para que o gestor nunca mais perca um projeto aprovável por falta de clareza na comunicação, e consiga criar apresentações que vendem a solução antes mesmo de o cliente entender completamente o que ela faz." .

mesh:Skill_ia_marketing_arquiteto_de_funil_de_vendas_completo a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-arquiteto-de-funil-de-vendas-completo" ;
    rdfs:label "arquiteto-de-funil-de-vendas-completo" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/arquiteto-de-funil-de-vendas-completo/SKILL.md" ;
    mesh:skillDescription "Projetar a arquitetura completa de um funil de vendas — desde a atração do lead frio até o fechamento e pós-venda — definindo cada etapa, conteúdos necessários, automações e métricas." .

mesh:Skill_ia_marketing_auditoria_de_campanha_facebook_ads a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-auditoria-de-campanha-facebook-ads" ;
    rdfs:label "auditoria-de-campanha-facebook-ads" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/auditoria-de-campanha-facebook-ads/SKILL.md" ;
    mesh:skillDescription "Auditar a estrutura e performance de campanhas de Facebook Ads — analisando estrutura de campanha/conjunto/anúncio, públicos, criativos, métricas de funil e configurações técnicas — para identificar os problemas que mais impactam o ROAS e gerar um plano de otimização priorizado. Para o empreendedor solo que gerencia as próprias campanhas, esta auditoria substitui R$5.000/mês de agência." .

mesh:Skill_ia_marketing_auditoria_de_campanha_paga a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-auditoria-de-campanha-paga" ;
    rdfs:label "auditoria-de-campanha-paga" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/auditoria-de-campanha-paga/SKILL.md" ;
    mesh:skillDescription "Auditar uma campanha de tráfego pago ativa no Meta Ads ou Google Ads — analisando estrutura, segmentação, criativos, copy, configurações de otimização e dados de performance — para identificar problemas que estão custando dinheiro e oportunidades de melhoria que ainda não foram exploradas. Funciona como uma revisão técnica completa que eleva a qualidade da gestão e demonstra valor ao cliente." .

mesh:Skill_ia_marketing_auditoria_de_conta_de_trafego_pago a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-auditoria-de-conta-de-trafego-pago" ;
    rdfs:label "auditoria-de-conta-de-trafego-pago" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/auditoria-de-conta-de-trafego-pago/SKILL.md" ;
    mesh:skillDescription "Conduzir uma auditoria estruturada de uma conta de Meta Ads ou Google Ads — analisando estrutura, segmentação, criativos, orçamento, métricas e configurações técnicas — para entregar ao cliente (ou usar internamente) um diagnóstico claro do que está errado, o que está custando dinheiro desnecessariamente e quais são as alavancas de melhoria com maior potencial de impacto no resultado." .

mesh:Skill_ia_marketing_auditoria_de_perfil_juridico_nas_redes_sociais a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-auditoria-de-perfil-juridico-nas-redes-sociais" ;
    rdfs:label "auditoria-de-perfil-juridico-nas-redes-sociais" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/auditoria-de-perfil-juridico-nas-redes-sociais/SKILL.md" ;
    mesh:skillDescription "Auditar o perfil de um advogado nas redes sociais — analisando bio, conteúdo recente, posicionamento, consistência e conversão — para identificar exatamente o que está impedindo o crescimento de seguidores e a conversão em clientes, e entregar um plano de correção prioritizado com ações concretas para implementar imediatamente." .

mesh:Skill_ia_marketing_banco_de_respostas_a_objecoes_de_vendas a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-banco-de-respostas-a-objecoes-de-vendas" ;
    rdfs:label "banco-de-respostas-a-objecoes-de-vendas" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/banco-de-respostas-a-objecoes-de-vendas/SKILL.md" ;
    mesh:skillDescription "Criar um banco completo e estratégico de respostas para as principais objeções que aparecem em negociações de serviços de marketing digital — com argumentos que validam a objeção, reposicionam o valor e encaminham para o fechamento — para nunca mais travar quando o cliente diz \"é caro\" ou \"vou pensar\"." .

mesh:Skill_ia_marketing_banco_de_respostas_para_objecoes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-banco-de-respostas-para-objecoes" ;
    rdfs:label "banco-de-respostas-para-objecoes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/banco-de-respostas-para-objecoes/SKILL.md" ;
    mesh:skillDescription "Criar um banco completo de respostas para as objeções mais frequentes que aparecem no processo de venda — seja no DM, WhatsApp, stories ou comentários — para que o empreendedor nunca mais trave na hora H sem saber o que responder. Respostas bem construídas para objeções convertem entre 20% e 40% dos \"vou pensar\" em compras." .

mesh:Skill_ia_marketing_bio_e_perfil_captacao_de_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-bio-e-perfil-captacao-de-clientes" ;
    rdfs:label "bio-e-perfil-captacao-de-clientes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/bio-e-perfil-captacao-de-clientes/SKILL.md" ;
    mesh:skillDescription "Criar a bio do Instagram, o headline do LinkedIn, a apresentação do site e os textos de perfil que comunicam quem você é, o que você resolve e para quem — de forma que visitantes do perfil entendam em 5 segundos se você é a pessoa certa para eles e tomem uma ação (seguir, enviar mensagem, agendar). Resolve o problema de ter um perfil que ninguém entende ou que não gera contatos." .

mesh:Skill_ia_marketing_briefing_completo_de_branding a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-briefing-completo-de-branding" ;
    rdfs:label "briefing-completo-de-branding" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/briefing-completo-de-branding/SKILL.md" ;
    mesh:skillDescription "Gerar um briefing de branding completo e estratégico — com as perguntas certas para extrair do cliente tudo que é necessário para criar uma identidade visual precisa — evitando retrabalho, revisões infinitas e projetos sem direção criativa clara." .

mesh:Skill_ia_marketing_briefing_de_campanha_de_marketing a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-briefing-de-campanha-de-marketing" ;
    rdfs:label "briefing-de-campanha-de-marketing" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/briefing-de-campanha-de-marketing/SKILL.md" ;
    mesh:skillDescription "Criar um briefing completo de campanha de marketing — com objetivo claro, público definido, canais escolhidos, direção criativa, orçamento e KPIs de sucesso — para que o time execute a campanha de forma alinhada e o gestor não precise corrigir rota no meio do caminho por falta de direcionamento inicial." .

mesh:Skill_ia_marketing_briefing_de_campanha_de_marketing_b2b a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-briefing-de-campanha-de-marketing-b2b" ;
    rdfs:label "briefing-de-campanha-de-marketing-b2b" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/briefing-de-campanha-de-marketing-b2b/SKILL.md" ;
    mesh:skillDescription "Estruturar briefings completos de campanha de marketing para segmentos específicos — construtoras, condomínios, prefeituras ou indústria — com objetivo, público, mensagem, canais e métricas definidos, para que o gestor direcione qualquer investimento em marketing de forma estratégica, evite campanhas genéricas que não convertem e consiga briefar agências ou freelancers com precisão, economizando tempo e dinheiro." .

mesh:Skill_ia_marketing_briefing_estruturado_de_campanha a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-briefing-estruturado-de-campanha" ;
    rdfs:label "briefing-estruturado-de-campanha" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/briefing-estruturado-de-campanha/SKILL.md" ;
    mesh:skillDescription "Criar ou extrair um briefing completo de campanha de marketing — capturando objetivo, público, canais, budget, métricas e contexto competitivo — para que toda a execução e análise posterior tenha uma base sólida e clara. Elimina o retrabalho causado por informações faltando no meio da campanha e garante alinhamento entre o que o cliente quer e o que será entregue." .

mesh:Skill_ia_marketing_cadencia_de_follow_up_de_leads_imobiliarios a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-cadencia-de-follow-up-de-leads-imobiliarios" ;
    rdfs:label "cadencia-de-follow-up-de-leads-imobiliarios" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/cadencia-de-follow-up-de-leads-imobiliarios/SKILL.md" ;
    mesh:skillDescription "Criar cadências completas de follow-up para leads imobiliários em diferentes estágios do funil — com mensagens prontas por canal (WhatsApp, telefone, e-mail), timing ideal de cada contato e critérios para qualificar ou descartar — para eliminar o \"deixei o cliente esfriar sem querer\" e transformar o acompanhamento de leads em um processo sistemático que qualquer corretor consegue executar." .

mesh:Skill_ia_marketing_cadencia_de_prospeccao_de_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-cadencia-de-prospeccao-de-clientes" ;
    rdfs:label "cadencia-de-prospeccao-de-clientes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/cadencia-de-prospeccao-de-clientes/SKILL.md" ;
    mesh:skillDescription "Criar uma cadência de prospecção ativa e sistemática para freelancer de tecnologia — com lista de onde encontrar clientes, scripts de abordagem por canal, sequência de follow-up e meta semanal de contatos — para nunca mais ficar esperando passivamente por indicações e ter um processo que gera conversas com potenciais clientes todas as semanas, independente de quanto você está ocupado agora." .

mesh:Skill_ia_marketing_calendario_de_conteudo_para_e_commerce_de_cosmeticos a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-calendario-de-conteudo-para-e-commerce-de-cosmeticos" ;
    rdfs:label "calendario-de-conteudo-para-e-commerce-de-cosmeticos" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/calendario-de-conteudo-para-e-commerce-de-cosmeticos/SKILL.md" ;
    mesh:skillDescription "Criar o calendário mensal de conteúdo para Instagram e outras redes com pauta estratégica — equilibrando posts de venda, educação sobre os produtos, conexão pessoal e prova social. Resolve o problema de não saber o que postar todo dia e garante presença digital consistente sem ficar inventando conteúdo na hora." .

mesh:Skill_ia_marketing_campanha_de_captacao_de_clientes_contabeis a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-campanha-de-captacao-de-clientes-contabeis" ;
    rdfs:label "campanha-de-captacao-de-clientes-contabeis" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/campanha-de-captacao-de-clientes-contabeis/SKILL.md" ;
    mesh:skillDescription "Criar campanhas completas de captação de clientes para escritórios de contabilidade — com copy de anúncio, isca digital, funil de conversão e roteiro de follow-up — para que o dono do escritório tenha uma máquina de aquisição funcionando mesmo quando está ocupado atendendo clientes, reduzindo a dependência de indicações e aumentando o previsibilidade da receita." .

mesh:Skill_ia_marketing_campanha_de_e_mail_marketing_para_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-campanha-de-e-mail-marketing-para-e-commerce" ;
    rdfs:label "campanha-de-e-mail-marketing-para-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/campanha-de-e-mail-marketing-para-e-commerce/SKILL.md" ;
    mesh:skillDescription "Criar uma campanha completa de e-mail marketing — seja para uma promoção, lançamento, data comemorativa ou reativação de clientes inativos — com sequência de e-mails, assuntos otimizados para abertura e textos prontos para enviar. E-mail marketing tem ROI médio de R$38 para cada R$1 investido e ainda é o canal mais rentável para e-commerce, especialmente com base própria." .

mesh:Skill_ia_marketing_campanha_de_lancamento_digital a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-campanha-de-lancamento-digital" ;
    rdfs:label "campanha-de-lancamento-digital" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/campanha-de-lancamento-digital/SKILL.md" ;
    mesh:skillDescription "Criar o plano completo de um lançamento digital — da pré-captação ao fechamento do carrinho — com sequência de conteúdo para redes sociais, sequência de e-mails, estratégia de lives e cronograma de ações. Transforma o caos de um lançamento improvisado em um processo claro e replicável que gera vendas de forma consistente." .

mesh:Skill_ia_marketing_campanha_de_marketing_para_servicos_b2b a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-campanha-de-marketing-para-servicos-b2b" ;
    rdfs:label "campanha-de-marketing-para-servicos-b2b" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/campanha-de-marketing-para-servicos-b2b/SKILL.md" ;
    mesh:skillDescription "Estruturar campanhas de marketing B2B para serviços jurídicos e de gestão — com estratégia de conteúdo, canais prioritários, mensagens por estágio do funil e cronograma de execução — para que o gestor saiba exatamente o que fazer, onde fazer e quando fazer para gerar leads qualificados sem depender de agência." .

mesh:Skill_ia_marketing_captacao_de_clientes_para_consultores a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-captacao-de-clientes-para-consultores" ;
    rdfs:label "captacao-de-clientes-para-consultores" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/captacao-de-clientes-para-consultores/SKILL.md" ;
    mesh:skillDescription "Criar um sistema de captação de clientes para consultores e coaches — combinando prospecção ativa (LinkedIn, e-mail, indicação estruturada) com atração passiva (conteúdo, SEO, referência) — para sair da dependência de indicações espontâneas e ter um processo previsível de geração de novos clientes. Para quem quer vender com mais consistência sem precisar ser vendedor agressivo." .

mesh:Skill_ia_marketing_captador_de_clientes_para_advogado_freelancer a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-captador-de-clientes-para-advogado-freelancer" ;
    rdfs:label "captador-de-clientes-para-advogado-freelancer" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/captador-de-clientes-para-advogado-freelancer/SKILL.md" ;
    mesh:skillDescription "Criar uma estratégia de captação de novos clientes para o advogado freelancer — com canais prioritários, abordagem de primeiro contato, mensagens de prospecção e follow-up — para que o profissional pare de depender de indicação passiva e passe a ter um processo ativo e consistente de desenvolvimento de carteira que aumenta o faturamento ao longo do tempo." .

mesh:Skill_ia_marketing_copy_de_captacao_advogado_nas_redes_sociais a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-copy-de-captacao-advogado-nas-redes-sociais" ;
    rdfs:label "copy-de-captacao-advogado-nas-redes-sociais" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/copy-de-captacao-advogado-nas-redes-sociais/SKILL.md" ;
    mesh:skillDescription "Criar textos persuasivos para captar clientes jurídicos — bio de perfil, CTA de posts, mensagem de boas-vindas para novos seguidores, link de agendamento e anúncios — que comuniquem autoridade e acessibilidade sem parecer propaganda barata ou violar as diretrizes da OAB. Resolve o problema de não saber \"como me vender sem parecer que estou me vendendo\" nas redes sociais." .

mesh:Skill_ia_marketing_copy_de_captacao_para_designer_de_branding a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-copy-de-captacao-para-designer-de-branding" ;
    rdfs:label "copy-de-captacao-para-designer-de-branding" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/copy-de-captacao-para-designer-de-branding/SKILL.md" ;
    mesh:skillDescription "Criar textos de captação para o negócio de branding — para anúncios, posts orgânicos, mensagens de prospecção e landing pages — que comunicam o valor estratégico do trabalho criativo, atraem clientes que entendem o serviço e filtram quem só quer \"logo barato\" — para que o designer venda com consistência sem precisar explicar o básico para todo prospect." .

mesh:Skill_ia_marketing_copy_de_captacao_para_servicos_juridicos_e_de_gestao a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-copy-de-captacao-para-servicos-juridicos-e-de-gestao" ;
    rdfs:label "copy-de-captacao-para-servicos-juridicos-e-de-gestao" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
