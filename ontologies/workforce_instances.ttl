    mesh:skillDescription "Criar um sistema de planejamento semanal estruturado — definindo prioridades, blocos de tempo, metas e revisão — para transformar semanas caóticas e reativas em semanas intencionais e produtivas." .

mesh:Skill_ia_people_portfolio_e_cases_para_atrair_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-people-portfolio-e-cases-para-atrair-clientes" ;
    rdfs:label "portfolio-e-cases-para-atrair-clientes" ;
