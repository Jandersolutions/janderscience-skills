    mesh:skillSourcePath "sources/headcount/plugins/demand-generation/skills/paid-advertising/SKILL.md" ;
    mesh:skillDescription "Plans, runs, and optimizes paid acquisition across search, social, and display — account structure, targeting, creative, bidding, budget, and the analysis that says whether to scale or stop. Use this to set up or restructure campaigns, write and iterate ad creative, diagnose rising costs or falling performance, decide budget allocation, or judge whether a channel is working." .

mesh:Skill_hc_demand_generation_programmatic_seo a mesh:Skill ;
    mesh:skillIdentifier "hc-demand-generation-programmatic-seo" ;
    rdfs:label "programmatic-seo" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/demand-generation/skills/programmatic-seo/SKILL.md" ;
    mesh:skillDescription "Builds large sets of search-targeted pages from a template and a dataset — the location, comparison, integration, and use-case pages that capture long-tail demand at scale. Use this when there is a repeating query pattern with real volume, when a dataset could answer many similar searches, or to judge whether a programmatic approach is viable before building it." .

mesh:Skill_hc_demand_generation_seo_strategy a mesh:Skill ;
    mesh:skillIdentifier "hc-demand-generation-seo-strategy" ;
    rdfs:label "seo-strategy" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/demand-generation/skills/seo-strategy/SKILL.md" ;
    mesh:skillDescription "Audits and improves organic search performance — technical health, site architecture, internal linking, structured data, and the content decisions that determine what can rank. Use this to run an SEO audit, diagnose why pages are not ranking or were deindexed, plan a site's URL and navigation structure, add structured data, or prioritize which SEO fixes are worth doing." .

mesh:Skill_hc_executive_agent_hierarchy a mesh:Skill ;
    mesh:skillIdentifier "hc-executive-agent-hierarchy" ;
    rdfs:label "agent-hierarchy" ;
    mesh:belongsToDepartment mesh:Dept_executive ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/executive/skills/agent-hierarchy/SKILL.md" ;
    mesh:skillDescription "Designs orchestrator-and-subagent hierarchies for a repository — splitting agents by exclusive write surface, pairing every producer with an independent auditor, and enforcing the split with a script that runs in CI. Use this whenever the user wants to set up, expand, audit, or fix a multi-agent or subagent structure for a codebase; asks how to divide work between agents; wants agent charters, roles, or a surface map written; or is hitting agents that collide on the same files, review their own work, or drift from their remit. Also use when sizing a roster or deciding whether a new agent is justified." .

mesh:Skill_hc_executive_ai_research_analyst a mesh:Skill ;
    mesh:skillIdentifier "hc-executive-ai-research-analyst" ;
    rdfs:label "ai-research-analyst" ;
    mesh:belongsToDepartment mesh:Dept_executive ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/executive/skills/ai-research-analyst/SKILL.md" ;
    mesh:skillDescription "Produces executive-level research — market sizing, competitor mapping, trend analysis, and strategic intelligence — grounded in cited sources with the confidence in each claim made explicit. Use this to analyze a market or industry, map competitors, evaluate a market-entry or build-versus-buy decision, produce a research brief, or assemble evidence for a decision. Also use when comparing options that need a structured, evidence-based verdict rather than an opinion." .

mesh:Skill_hc_executive_business_growth_consultant a mesh:Skill ;
    mesh:skillIdentifier "hc-executive-business-growth-consultant" ;
    rdfs:label "business-growth-consultant" ;
    mesh:belongsToDepartment mesh:Dept_executive ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/executive/skills/business-growth-consultant/SKILL.md" ;
    mesh:skillDescription "Finds the single constraint currently limiting a business's growth and the highest-leverage moves against it, rather than producing a list of everything that could be improved. Use this when growth has stalled or slowed, when deciding where to spend limited time or budget, when revenue rises but profit does not, when prioritizing growth initiatives, or when a business feels busy without compounding." .

mesh:Skill_hc_executive_ceo_advisor a mesh:Skill ;
    mesh:skillIdentifier "hc-executive-ceo-advisor" ;
    rdfs:label "ceo-advisor" ;
    mesh:belongsToDepartment mesh:Dept_executive ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/executive/skills/ceo-advisor/SKILL.md" ;
    mesh:skillDescription "Pressure-tests a decision, plan, or idea before it is committed to — surfacing the assumption it rests on, the case against it, and what would have to be true for it to work. Use this when weighing options, when a plan needs challenging before commitment, when you have already decided and want a genuine gut check, when processing meeting notes into decisions, or when competing initiatives need ranking. Distinct from `chief-executive`, which owns direction; this one interrogates a specific decision." .

mesh:Skill_hc_executive_chief_executive a mesh:Skill ;
    mesh:skillIdentifier "hc-executive-chief-executive" ;
    rdfs:label "chief-executive" ;
    mesh:belongsToDepartment mesh:Dept_executive ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/executive/skills/chief-executive/SKILL.md" ;
    mesh:skillDescription "Sets direction, allocates capital and attention, and makes the calls no one else can make. Use this when a decision spans more than one function, when priorities conflict and something must be cut, when a plan needs pressure-testing before commitment, or when the question is what the organization should do rather than how to do it. Also use to route a request to the right executive when it is unclear who owns it." .

mesh:Skill_hc_executive_fundraising_and_investor_relations a mesh:Skill ;
    mesh:skillIdentifier "hc-executive-fundraising-and-investor-relations" ;
    rdfs:label "fundraising-and-investor-relations" ;
    mesh:belongsToDepartment mesh:Dept_executive ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/executive/skills/fundraising-and-investor-relations/SKILL.md" ;
    mesh:skillDescription "Raises capital and manages the relationship afterward — deciding how much and why, understanding what dilution and preferences actually cost, running a process with real competitive tension, preparing for diligence before it starts, and reporting to investors and a board in a way that keeps support when results are bad. Use this to plan a raise, evaluate a term sheet beyond the valuation, prepare a data room, or fix reporting that is producing surprises." .

mesh:Skill_hc_executive_saas_idea_validator a mesh:Skill ;
    mesh:skillIdentifier "hc-executive-saas-idea-validator" ;
    rdfs:label "saas-idea-validator" ;
    mesh:belongsToDepartment mesh:Dept_executive ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/executive/skills/saas-idea-validator/SKILL.md" ;
    mesh:skillDescription "Evaluates a software or startup idea against problem, market, competition, monetization, defensibility, and execution, and returns a verdict rather than encouragement. Use this when an idea needs pressure-testing before anyone builds, when deciding whether something is worth pursuing, when assessing competition or willingness to pay, or when a validated idea needs a first-customers and MVP plan. Default to scrutiny; the useful answer is usually the unwelcome one." .

mesh:Skill_hc_finance_budgeting_and_forecasting a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-budgeting-and-forecasting" ;
    rdfs:label "budgeting-and-forecasting" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/budgeting-and-forecasting/SKILL.md" ;
    mesh:skillDescription "Runs the planning cycle — annual budget, rolling forecast, consolidation of business unit inputs, and the variance analysis that explains actuals against plan. Use this to build or challenge a budget, run a forecast cycle, consolidate departmental submissions, explain why results diverged from plan, or improve forecast accuracy." .

mesh:Skill_hc_finance_capital_allocation a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-capital-allocation" ;
    rdfs:label "capital-allocation" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/capital-allocation/SKILL.md" ;
    mesh:skillDescription "Evaluates where to spend limited capital — investment appraisal, hurdle rates, payback, and comparing proposals that are not alike. Use this to evaluate an investment or major purchase, compare competing funding requests, set a hurdle rate, decide between building and buying, or review whether past investments delivered what was claimed." .

mesh:Skill_hc_finance_capital_structure_and_covenants a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-capital-structure-and-covenants" ;
    rdfs:label "capital-structure-and-covenants" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/capital-structure-and-covenants/SKILL.md" ;
    mesh:skillDescription "Decides how the business is financed and what that financing then requires of it — debt versus equity, weighted average cost of capital as a hurdle rate, how much leverage cash flow can carry, and the financial, affirmative and negative covenants, definitions, test dates and cure rights that come attached. Use this to evaluate a financing option, set an investment hurdle, check whether a planned decision will trip a covenant, or work out what a lender can do when one breaks." .

mesh:Skill_hc_finance_chief_financial_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-chief-financial-officer" ;
    rdfs:label "chief-financial-officer" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/chief-financial-officer/SKILL.md" ;
    mesh:skillDescription "Owns the financial position: planning, budgeting, forecasting, unit economics, cash, and the numbers the business is run and reported on. Use this to build or challenge a budget, model a decision's financial consequence, assess unit economics or runway, evaluate an investment or spend request, set financial controls, or when a plan's numbers do not reconcile. Also use to decide whether the business can afford something." .

mesh:Skill_hc_finance_cost_accounting a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-cost-accounting" ;
    rdfs:label "cost-accounting" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/cost-accounting/SKILL.md" ;
    mesh:skillDescription "Establishes what something actually costs — fixed, variable and mixed cost behavior, absorption versus variable costing, job-order, process and activity-based methods, breakeven and operating leverage, and price/volume/mix decomposition. Use this to set a price floor, explain why revenue or margin moved, decide make versus buy, judge whether a product line earns its place, or work out how an allocation basis is distorting a reported margin." .

mesh:Skill_hc_finance_financial_modeling a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-financial-modeling" ;
    rdfs:label "financial-modeling" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/financial-modeling/SKILL.md" ;
    mesh:skillDescription "Builds and stress-tests financial models for forecasting, scenario planning, and decision support — revenue build, cost structure, driver logic, and the sensitivities that show where a plan breaks. Use this to model a decision's financial consequence, build a forecast or long-range plan, evaluate an investment or hire, or pressure-test someone else's model before relying on it." .

mesh:Skill_hc_finance_financial_reporting_and_close a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-financial-reporting-and-close" ;
    rdfs:label "financial-reporting-and-close" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/financial-reporting-and-close/SKILL.md" ;
    mesh:skillDescription "Runs the period-end close and produces reporting — close calendar, reconciliations, accruals, variance analysis, and reporting that gets read. Use this to shorten or stabilize a monthly close, design a close checklist, investigate a variance, structure management reporting, or work out why the numbers keep changing after close." .

mesh:Skill_hc_finance_financial_statement_analysis a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-financial-statement-analysis" ;
    rdfs:label "financial-statement-analysis" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/financial-statement-analysis/SKILL.md" ;
    mesh:skillDescription "Reads a set of financial statements and establishes what changed and why — fluctuation analysis against prior period and against budget, profitability, liquidity, solvency and efficiency ratios, benchmarking, and the non-GAAP measures presented alongside them. Use this to interpret results, review a counterparty's or target's financials, diagnose a deteriorating trend, explain a variance to someone who will act on it, or test whether an adjusted number is honest." .

mesh:Skill_hc_finance_internal_controls_and_audit a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-internal-controls-and-audit" ;
    rdfs:label "internal-controls-and-audit" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/internal-controls-and-audit/SKILL.md" ;
    mesh:skillDescription "Designs and tests controls over financial reporting — segregation of duties, approval limits, evidence, and preparing for audit. Use this to design controls for a process, prepare for an external audit, respond to an audit finding, set approval thresholds, or assess where a small team's segregation of duties is genuinely broken." .

mesh:Skill_hc_finance_revenue_recognition a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-revenue-recognition" ;
    rdfs:label "revenue-recognition" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/revenue-recognition/SKILL.md" ;
    mesh:skillDescription "Determines when and how revenue is recognized — performance obligations, contract terms that change the answer, and the deal structures that create accounting problems. Use this to work out how a contract should be recognized, review a non-standard deal before it is signed, understand deferred revenue, or spot terms that would delay or reverse recognition." .

mesh:Skill_hc_finance_tax a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-tax" ;
    rdfs:label "tax" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/tax/SKILL.md" ;
    mesh:skillDescription "Structures the tax questions a growing business faces — corporate income, sales and use, payroll, nexus, and the obligations created by hiring or selling somewhere new. Use this to work out what a new state or country obligates you to, prepare for a tax filing or audit, understand sales tax on your product, or check what a remote hire or new market triggers." .

mesh:Skill_hc_finance_treasury_and_liquidity a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-treasury-and-liquidity" ;
    rdfs:label "treasury-and-liquidity" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/treasury-and-liquidity/SKILL.md" ;
    mesh:skillDescription "Manages cash and liquidity — cash forecasting, runway, working capital, banking structure, and currency and counterparty exposure. Use this to build a cash forecast, extend runway, improve working capital, decide where cash should sit, or assess exposure to a bank, currency, or customer concentration." .

mesh:Skill_hc_finance_unit_economics a mesh:Skill ;
    mesh:skillIdentifier "hc-finance-unit-economics" ;
    rdfs:label "unit-economics" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/finance/skills/unit-economics/SKILL.md" ;
    mesh:skillDescription "Establishes whether the business makes money on each customer or unit — contribution margin, acquisition cost, payback period, lifetime value, and the cohort behavior underneath. Use this to assess whether growth is profitable, evaluate a channel or segment, support a pricing decision, judge how fast the business can afford to grow, or diagnose why revenue growth is not producing profit." .

mesh:Skill_hc_it_operations_backup_and_recovery a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-backup-and-recovery" ;
    rdfs:label "backup-and-recovery" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/backup-and-recovery/SKILL.md" ;
    mesh:skillDescription "Protects and restores data — backup coverage and scope, retention, immutability against ransomware, and proving restores actually work. Use this to design a backup regime, verify restores, plan retention, protect backups from ransomware, or recover from data loss." .

mesh:Skill_hc_it_operations_chief_information_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-chief-information-officer" ;
    rdfs:label "chief-information-officer" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/chief-information-officer/SKILL.md" ;
    mesh:skillDescription "The CIO's remit — running the technology the company works on, service quality, IT spend, and the boundary with product engineering. Use this to set IT priorities, decide what IT owns versus engineering, structure IT spend or an IT roadmap, judge whether to build, buy or outsource, or work out why IT is seen as a cost center rather than an enabler." .

mesh:Skill_hc_it_operations_cloud_administration a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-cloud-administration" ;
    rdfs:label "cloud-administration" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/cloud-administration/SKILL.md" ;
    mesh:skillDescription "Administers the cloud the company runs on rather than the one it sells — tenant and subscription structure, the SaaS estate and who owns each app, identity as the real perimeter, cloud spend that arrives as a surprise, and what the provider does not do for you. Use this to structure subscriptions or tenants, get control of sprawling SaaS, cut a cloud bill, work out who owns an application nobody admits to buying, or decide what corporate workloads belong in cloud at all." .

mesh:Skill_hc_it_operations_collaboration_platform_administration a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-collaboration-platform-administration" ;
    rdfs:label "collaboration-platform-administration" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/collaboration-platform-administration/SKILL.md" ;
    mesh:skillDescription "Administers the email, chat, meeting and file-sharing platform the organization runs on — tenant and domain configuration, mail authentication and routing, phishing and spam controls, shared mailboxes and distribution groups, external sharing and guest access, permission sprawl in file storage, and retention and legal hold. Use this to configure a tenant, tighten sharing, investigate a mail delivery or phishing problem, or work out who can see a file and why." .

mesh:Skill_hc_it_operations_endpoint_management a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-endpoint-management" ;
    rdfs:label "endpoint-management" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/endpoint-management/SKILL.md" ;
    mesh:skillDescription "Manages laptops, desktops and mobile devices — enrollment, configuration, patching, software distribution, and lost or compromised devices. Use this to set up device management, standardize builds, roll out software or an OS upgrade, handle a lost device, or bring an unmanaged fleet under control." .

mesh:Skill_hc_it_operations_identity_lifecycle_administration a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-identity-lifecycle-administration" ;
    rdfs:label "identity-lifecycle-administration" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/identity-lifecycle-administration/SKILL.md" ;
    mesh:skillDescription "Executes joiner, mover and leaver processes — provisioning, group membership, access changes on role change, and complete deprovisioning. Use this to set up or fix joiner-mover-leaver, deprovision someone completely, clean up accumulated access, audit group membership, or find accounts that outlived their owners." .

mesh:Skill_hc_it_operations_it_asset_management a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-it-asset-management" ;
    rdfs:label "it-asset-management" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/it-asset-management/SKILL.md" ;
    mesh:skillDescription "Tracks hardware and software assets through their life — procurement, ownership, licensing, refresh, and disposal. Use this to build an asset register, prepare for a software audit, plan a refresh cycle, control license spend, or dispose of equipment safely." .

mesh:Skill_hc_it_operations_network_administration a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-network-administration" ;
    rdfs:label "network-administration" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/network-administration/SKILL.md" ;
    mesh:skillDescription "Designs and operates the corporate network — segmentation, remote access, wireless, DNS and addressing, and diagnosing network problems. Use this to segment a network, set up or fix remote access, diagnose intermittent connectivity, plan addressing or DNS, or assess whether the network's trust assumptions still hold." .

mesh:Skill_hc_it_operations_service_desk a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-service-desk" ;
    rdfs:label "service-desk" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/service-desk/SKILL.md" ;
    mesh:skillDescription "Runs the IT service desk — intake, triage, prioritization, escalation, knowledge, and the metrics that improve service rather than distort it. Use this to set up or fix a service desk, design ticket priority and escalation, reduce repeat contacts, structure a knowledge base, or work out why a desk hitting its targets still frustrates everyone." .

mesh:Skill_hc_it_operations_systems_administration a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-systems-administration" ;
    rdfs:label "systems-administration" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/systems-administration/SKILL.md" ;
    mesh:skillDescription "Runs servers and corporate systems — patching, configuration baselines, change control, capacity, and the routine that prevents incidents. Use this to establish a patching cadence, standardize server configuration, plan a maintenance window, decide change control for infrastructure, or clean up systems that have drifted from any known state." .

mesh:Skill_hc_it_operations_telephony_and_conferencing a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-telephony-and-conferencing" ;
    rdfs:label "telephony-and-conferencing" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/telephony-and-conferencing/SKILL.md" ;
    mesh:skillDescription "Runs voice and meeting infrastructure — phone systems and numbers, emergency calling obligations, conference rooms and their AV, call recording and its retention consequences, and the porting that makes provider changes go badly. Use this to replace a phone system, fix rooms nobody can start a meeting in, meet emergency-calling requirements, port numbers without losing service, or work out why voice quality degrades only sometimes." .

mesh:Skill_hc_it_operations_virtualization_operations a mesh:Skill ;
    mesh:skillIdentifier "hc-it-operations-virtualization-operations" ;
    rdfs:label "virtualization-operations" ;
    mesh:belongsToDepartment mesh:Dept_it-operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/it-operations/skills/virtualization-operations/SKILL.md" ;
    mesh:skillDescription "Runs the hypervisor layer beneath the servers — host capacity and consolidation ratios, VM sprawl, snapshot discipline, resilience and live migration, and licensing that counts cores rather than instances. Use this to size or expand a cluster, work out why VMs are slow when the hosts look idle, clean up sprawl, set snapshot and template policy, or decide what stays virtualized and what moves to cloud." .

mesh:Skill_hc_legal_risk_chief_legal_and_risk_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-legal-risk-chief-legal-and-risk-officer" ;
    rdfs:label "chief-legal-and-risk-officer" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/legal-risk/skills/chief-legal-and-risk-officer/SKILL.md" ;
    mesh:skillDescription "Owns legal, contracts, intellectual property, regulatory compliance, privacy, security governance, enterprise risk, and audit readiness. Use this to review a contract or commitment, assess regulatory or privacy exposure, evaluate an IP or licensing question, judge the risk in a business decision, prepare for an audit or certification, or when a plan may create obligations the business cannot meet. Also use to decide whether a risk should be accepted, mitigated, or refused." .

mesh:Skill_hc_legal_risk_contract_review a mesh:Skill ;
    mesh:skillIdentifier "hc-legal-risk-contract-review" ;
    rdfs:label "contract-review" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/legal-risk/skills/contract-review/SKILL.md" ;
    mesh:skillDescription "Reviews and negotiates commercial agreements — MSAs, SOWs, order forms, NDAs, vendor and data-processing agreements — identifying material risk, proposing positions, and recommending a path rather than listing issues. Use this to review a contract before signature, prepare a negotiation position, build fallback positions and approval thresholds, or assess exposure in terms already agreed." .

mesh:Skill_hc_legal_risk_corporate_governance a mesh:Skill ;
    mesh:skillIdentifier "hc-legal-risk-corporate-governance" ;
    rdfs:label "corporate-governance" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/legal-risk/skills/corporate-governance/SKILL.md" ;
    mesh:skillDescription "Maintains the corporate record and the governance machinery — entity records, board and committee support, resolutions and minutes, delegations of authority, insurance, and business continuity. Use this to prepare board or committee materials, record a decision that needs to be minuted, set or check approval authority, review insurance and continuity coverage, establish a retention policy, or work out where a responsibility belongs when it falls between functions." .

mesh:Skill_hc_legal_risk_disputes_and_legal_holds a mesh:Skill ;
    mesh:skillIdentifier "hc-legal-risk-disputes-and-legal-holds" ;
    rdfs:label "disputes-and-legal-holds" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/legal-risk/skills/disputes-and-legal-holds/SKILL.md" ;
    mesh:skillDescription "Handles a dispute from the first sign of it — recognizing when preservation obligations attach, issuing and scoping a legal hold, suspending automatic deletion across every system that holds relevant material, preserving privilege, managing outside counsel and cost, and evaluating settlement against the real cost of continuing. Use this to respond to a claim or demand letter, issue a hold, work out which systems the hold has to reach, or decide whether to fight." .

mesh:Skill_hc_legal_risk_enterprise_risk a mesh:Skill ;
    mesh:skillIdentifier "hc-legal-risk-enterprise-risk" ;
    rdfs:label "enterprise-risk" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/legal-risk/skills/enterprise-risk/SKILL.md" ;
    mesh:skillDescription "Identifies, assesses, and tracks organizational risk — building and maintaining a risk register, scoring exposure, assigning owners and treatments, and preparing for audit. Use this to stand up a risk program, assess the risk in a decision or initiative, prepare for a certification or audit, decide whether a risk should be accepted, mitigated, transferred, or avoided, or report risk posture to leadership." .

mesh:Skill_hc_legal_risk_intellectual_property a mesh:Skill ;
    mesh:skillIdentifier "hc-legal-risk-intellectual-property" ;
    rdfs:label "intellectual-property" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/legal-risk/skills/intellectual-property/SKILL.md" ;
    mesh:skillDescription "Covers what the organization owns and what it is only borrowing — trademarks and clearance, copyright and work-for-hire, patents and trade secrets, open-source license obligations and copyleft reach, and IP terms in customer, contractor and AI-tool agreements. Use this to check whether a name is usable, establish that you own work you paid for, decide how to handle a license obligation in a dependency, or respond to an infringement claim." .

mesh:Skill_hc_legal_risk_privacy_and_data_protection a mesh:Skill ;
    mesh:skillIdentifier "hc-legal-risk-privacy-and-data-protection" ;
    rdfs:label "privacy-and-data-protection" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/legal-risk/skills/privacy-and-data-protection/SKILL.md" ;
    mesh:skillDescription "Assesses and improves how personal data is collected, used, shared, and retained — data mapping, lawful basis, consent, processor agreements, subject rights, and breach obligations. Use this before launching anything that handles personal data, when adding a vendor that will process it, when a data subject request arrives, when assessing exposure under GDPR or US state privacy laws, or when preparing for a privacy review." .

mesh:Skill_hc_legal_risk_regulatory_compliance a mesh:Skill ;
    mesh:skillIdentifier "hc-legal-risk-regulatory-compliance" ;
    rdfs:label "regulatory-compliance" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/legal-risk/skills/regulatory-compliance/SKILL.md" ;
    mesh:skillDescription "Identifies which regulations apply and builds the program that keeps you inside them — obligation mapping, controls, monitoring, and responding to regulators. Use this to work out what applies to your business, stand up a compliance program, prepare for a regulatory exam or certification, respond to a finding, or assess exposure before entering a new market." .

mesh:Skill_hc_marketing_behavioral_marketing a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-behavioral-marketing" ;
    rdfs:label "behavioral-marketing" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/behavioral-marketing/SKILL.md" ;
    mesh:skillDescription "Applies decision science and cognitive bias research to marketing and product decisions — how people actually choose under uncertainty, and how framing, defaults, sequencing, and social context change behavior. Use this to diagnose why a well-argued offer is not converting, to structure choices and pricing presentation, to design an experience around how attention and memory work, or to pressure-test whether a persuasion tactic is legitimate or manipulative." .

mesh:Skill_hc_marketing_brand_voice a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-brand-voice" ;
    rdfs:label "brand-voice" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/brand-voice/SKILL.md" ;
    mesh:skillDescription "Captures how a person or brand actually writes and turns it into reusable voice instructions every other content skill draws from. Use this before drafting any content for a new brand or client, when output keeps coming back sounding generic, when several writers need to sound like one, or when a voice needs defining without existing samples to learn from." .

mesh:Skill_hc_marketing_chief_content_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-chief-content-officer" ;
    rdfs:label "chief-content-officer" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/chief-content-officer/SKILL.md" ;
    mesh:skillDescription "Runs content as an operation — the production pipeline, editorial calendar, repurposing engine, competitive content intelligence, and audits of what already exists. Use this to build or fix a content production system, plan a calendar, decide how one piece becomes many, rank content ideas by expected impact, or audit an existing library for what to update, consolidate, or retire. For deciding what territory to own and why, use `content-strategy` first." .

mesh:Skill_hc_marketing_chief_marketing_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-chief-marketing-officer" ;
    rdfs:label "chief-marketing-officer" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/chief-marketing-officer/SKILL.md" ;
    mesh:skillDescription "Owns brand, demand generation, content, communications, and how the market understands what the business does. Use this to set marketing strategy, allocate budget across channels, decide positioning and messaging, judge whether a campaign is worth running, diagnose why demand has stalled, or arbitrate between brand-building and short-term acquisition. Also use to decide which marketing work to stop." .

mesh:Skill_hc_marketing_content_strategy a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-content-strategy" ;
    rdfs:label "content-strategy" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/content-strategy/SKILL.md" ;
    mesh:skillDescription "Decides what content to make and why — topic territory, format mix, cadence, and how content connects to a business outcome rather than to traffic. Use this to plan a content program, choose topics, build an editorial calendar, decide which formats and platforms to commit to, or diagnose why content is producing audience but not results." .

mesh:Skill_hc_marketing_customer_research a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-customer-research" ;
    rdfs:label "customer-research" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/customer-research/SKILL.md" ;
    mesh:skillDescription "Plans, runs, and synthesizes customer research — interviews, surveys, win-loss analysis, and message testing — into findings that change decisions. Use this when the customer is being guessed at, before positioning or a major launch, when churn or conversion has an unexplained cause, or when a team is arguing from anecdotes. Also use to turn raw interview notes into usable findings." .

mesh:Skill_hc_marketing_events_and_field_marketing a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-events-and-field-marketing" ;
    rdfs:label "events-and-field-marketing" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/events-and-field-marketing/SKILL.md" ;
    mesh:skillDescription "Plans and runs events that produce pipeline — conferences, trade shows, webinars, field programs, and measuring whether any of it worked. Use this to decide whether to sponsor an event, plan a conference presence or webinar, design a field program, or work out why event spend is not producing pipeline." .

mesh:Skill_hc_marketing_marketing_campaign_planner a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-marketing-campaign-planner" ;
    rdfs:label "marketing-campaign-planner" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/marketing-campaign-planner/SKILL.md" ;
    mesh:skillDescription "Designs a coordinated multi-channel campaign or product launch around one story — objective, message, channel sequencing, timeline, assets, and the checklist that gets it out the door. Use this to plan a launch or campaign, sequence a go-to-market push, pressure-test a campaign before committing budget, or turn a product change into a coordinated set of activity. For ongoing channel programs rather than a bounded push, use `marketing-planning`." .

mesh:Skill_hc_marketing_marketing_copywriting a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-marketing-copywriting" ;
    rdfs:label "marketing-copywriting" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/marketing-copywriting/SKILL.md" ;
    mesh:skillDescription "Writes and edits marketing copy for any surface — homepage, product and pricing pages, ads, emails, and collateral — and sharpens existing copy that is not working. Use this to write or rewrite page copy, tighten a draft, fix copy that is vague or feature-led, adapt one message across formats, or review copy before it ships." .

mesh:Skill_hc_marketing_marketing_planning a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-marketing-planning" ;
    rdfs:label "marketing-planning" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/marketing-planning/SKILL.md" ;
    mesh:skillDescription "Builds the marketing plan of record — objectives, channel mix, budget allocation, sequencing, and the measurement that says whether it worked. Use this for annual or quarterly planning, when budget must be allocated or defended, when marketing activity feels busy but undirected, or when a plan needs pressure-testing before commitment." .

mesh:Skill_hc_marketing_newsletter_writer a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-newsletter-writer" ;
    rdfs:label "newsletter-writer" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/newsletter-writer/SKILL.md" ;
    mesh:skillDescription "Writes and edits newsletters and marketing emails people actually open — subject lines, opening, structure, voice, and the conversion turn where there is one. Use this to draft or rewrite a newsletter or email, sharpen weak email copy, plan a newsletter's structure and cadence, write a sequence, or repurpose an issue into other formats. For automated lifecycle and SMS programs, use `lifecycle-messaging`." .

mesh:Skill_hc_marketing_partnership_marketing a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-partnership-marketing" ;
    rdfs:label "partnership-marketing" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/partnership-marketing/SKILL.md" ;
    mesh:skillDescription "Builds reach through other people's audiences — co-marketing partnerships, creator and influencer programs, and community building. Use this to find and evaluate partners, structure a joint campaign or creator deal, plan a community strategy, or decide whether a partnership is worth the coordination cost." .

mesh:Skill_hc_marketing_positioning_and_messaging a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-positioning-and-messaging" ;
    rdfs:label "positioning-and-messaging" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/positioning-and-messaging/SKILL.md" ;
    mesh:skillDescription "Establishes what a product is understood to be, for whom, and instead of what — then turns that into the messaging every other surface inherits. Use this when messaging is inconsistent across channels, when prospects misunderstand what the product does, when entering a new segment, when competitors are being compared against you unfavorably, or before any campaign, launch, or site rewrite." .

mesh:Skill_hc_marketing_product_launch a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-product-launch" ;
    rdfs:label "product-launch" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/product-launch/SKILL.md" ;
    mesh:skillDescription "Takes something built and gets it into the market — tiering the launch to match what it actually warrants, sequencing internal readiness before external announcement, preparing sales and support to answer the questions it creates, choosing the date for a reason, and measuring adoption rather than announcement reach. Use this to plan a launch, right-size one that is consuming more than it deserves, work out why a released feature nobody uses was launched loudly, or run the weeks after launch day." .

mesh:Skill_hc_marketing_public_relations a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-public-relations" ;
    rdfs:label "public-relations" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/public-relations/SKILL.md" ;
    mesh:skillDescription "Plans and executes earned media — press strategy, journalist outreach, announcements, commentary, and crisis response. Use this to plan a press push, write a pitch or release, find and approach the right journalists, prepare for an interview, decide whether something is newsworthy, or respond to a story going badly." .

mesh:Skill_hc_marketing_social_post_craft a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-social-post-craft" ;
    rdfs:label "social-post-craft" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/social-post-craft/SKILL.md" ;
    mesh:skillDescription "Writes, structures, and evaluates social posts end to end — hooks, body, formatting for how each platform renders, and a quality check before publishing. Use this to draft a post, rewrite one that underperformed, turn a longer piece into social content, sharpen an opening, or judge whether a draft is worth publishing." .

mesh:Skill_hc_marketing_video_content a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-video-content" ;
    rdfs:label "video-content" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/video-content/SKILL.md" ;
    mesh:skillDescription "Plans and scripts short-form and long-form video, and designs the packaging — titles, thumbnails, and openings — that determines whether it gets watched. Use this to script a video, plan a series, fix retention or click-through problems, design thumbnail and title concepts, or turn written content into video. For a YouTube channel specifically — idea selection, retention teardowns, and channel-level strategy — use `youtube-producer`." .

mesh:Skill_hc_marketing_visual_content a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-visual-content" ;
    rdfs:label "visual-content" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/visual-content/SKILL.md" ;
    mesh:skillDescription "Designs and directs the visual assets that carry content — carousels, infographics, quote graphics, diagrams, and social imagery — including the generation prompts where they are AI-produced. Use this to turn a written piece into a visual format, design a carousel or infographic, create social graphics, or fix visuals that are not stopping the scroll." .

mesh:Skill_hc_marketing_youtube_producer a mesh:Skill ;
    mesh:skillIdentifier "hc-marketing-youtube-producer" ;
    rdfs:label "youtube-producer" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/marketing/skills/youtube-producer/SKILL.md" ;
    mesh:skillDescription "Plans, packages, and scripts long-form video for retention and channel growth — idea selection, titles and thumbnails, script structure, and diagnosing why a video or channel underperforms. Use this for video ideas, packaging, scripting, a retention teardown, or channel strategy — including when someone describes a topic and wants it turned into something publishable. For short-form and cross-platform video, use `video-content`." .

mesh:Skill_hc_operations_business_continuity_and_resilience a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-business-continuity-and-resilience" ;
    rdfs:label "business-continuity-and-resilience" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/business-continuity-and-resilience/SKILL.md" ;
    mesh:skillDescription "Plans for operating through disruption — impact analysis, recovery objectives, continuity plans, and the exercises that prove they work. Use this to run a business impact analysis, set RTO and RPO, write or test a continuity plan, prepare for a supplier or site failure, or answer a customer's resilience questionnaire." .

mesh:Skill_hc_operations_capacity_and_demand_planning a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-capacity-and-demand-planning" ;
    rdfs:label "capacity-and-demand-planning" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/capacity-and-demand-planning/SKILL.md" ;
    mesh:skillDescription "Matches operational capacity to expected demand — forecasting load, sizing teams and systems, managing queues, and deciding when to add capacity. Use this to plan staffing for expected volume, diagnose a queue that keeps growing, size support or fulfillment capacity, or decide whether a bottleneck needs more capacity or better flow." .

mesh:Skill_hc_operations_chief_operating_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-chief-operating-officer" ;
    rdfs:label "chief-operating-officer" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/chief-operating-officer/SKILL.md" ;
    mesh:skillDescription "Owns execution: how work actually gets done across the organization, including process, program management, capacity, vendors, supply chain, and service delivery. Use this when execution is the problem rather than strategy, to design or fix a process, to resolve cross-functional handoff failures, to plan capacity, to assess delivery risk, or when the same failure keeps recurring. Also use to decide whether to build, hire, or outsource a capability." .

mesh:Skill_hc_operations_facilities_and_workplace a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-facilities-and-workplace" ;
    rdfs:label "facilities-and-workplace" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/facilities-and-workplace/SKILL.md" ;
    mesh:skillDescription "Runs the physical and hybrid workplace — space planning, leases, health and safety, office services, and the operational side of where people work. Use this to plan space, evaluate a lease or office move, set up a hybrid workplace, handle facilities incidents, or decide what office services are worth funding." .

mesh:Skill_hc_operations_incident_management a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-incident-management" ;
    rdfs:label "incident-management" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/incident-management/SKILL.md" ;
    mesh:skillDescription "Runs an operational incident from detection to closed action — declaring it and naming a commander, separating the people restoring service from the people communicating, keeping a timeline as it happens, deciding when it is over, and running a review that produces a small number of changes someone actually completes. Use this to set up an incident process, run one, work out why the same failure keeps recurring, or fix a review practice that generates findings nobody closes." .

mesh:Skill_hc_operations_operating_cadence a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-operating-cadence" ;
    rdfs:label "operating-cadence" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/operating-cadence/SKILL.md" ;
    mesh:skillDescription "Designs the rhythm an organization runs on — which reviews happen weekly, monthly and quarterly, what each one decides, who owns the numbers presented, and how a signal at the front line reaches the people who can act on it. Use this to set up a management operating system, fix a meeting calendar that produces no decisions, work out where a recurring problem keeps failing to surface, or cut a review structure that has grown past what it informs." .

mesh:Skill_hc_operations_process_design a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-process-design" ;
    rdfs:label "process-design" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/process-design/SKILL.md" ;
    mesh:skillDescription "Designs, documents, and fixes operational processes — mapping the current state, finding where work actually stalls, redesigning the flow, and building controls that hold. Use this when the same failure keeps recurring, when a handoff between teams is unreliable, when onboarding a repeated task, when work takes far longer than the work itself, or when deciding whether to automate, standardize, or eliminate a process." .

mesh:Skill_hc_operations_procurement_and_sourcing a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-procurement-and-sourcing" ;
    rdfs:label "procurement-and-sourcing" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/procurement-and-sourcing/SKILL.md" ;
    mesh:skillDescription "Buys well — specifying need, running competitive sourcing, negotiating, and category strategy before a contract exists. Use this to run an RFP or vendor selection, negotiate a purchase, consolidate spend across a category, decide between single and multiple suppliers, or bring uncontrolled spending under management." .

mesh:Skill_hc_operations_quality_management a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-quality-management" ;
    rdfs:label "quality-management" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/quality-management/SKILL.md" ;
    mesh:skillDescription "Builds quality into operations — defining standards, catching defects at the right point, root cause analysis, and continuous improvement. Use this to reduce a defect or error rate, design quality controls into a process, run a root cause analysis, respond to a customer quality complaint, or set up quality metrics that drive behavior." .

mesh:Skill_hc_operations_service_level_management a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-service-level-management" ;
    rdfs:label "service-level-management" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/service-level-management/SKILL.md" ;
    mesh:skillDescription "Defines and manages service levels — setting targets that reflect what customers need, measuring honestly, and handling breaches. Use this to write or negotiate an SLA, decide what to measure and at what threshold, respond to a missed service level, or work out why a service that meets its targets still has unhappy customers." .

mesh:Skill_hc_operations_supply_chain_and_logistics a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-supply-chain-and-logistics" ;
    rdfs:label "supply-chain-and-logistics" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/supply-chain-and-logistics/SKILL.md" ;
    mesh:skillDescription "Manages the flow of goods and inputs — sourcing, inventory, lead times, fulfillment, and supply risk. Use this to reduce stockouts or excess inventory, plan for a supplier failure, decide reorder points and safety stock, improve fulfillment reliability, or assess concentration risk in a supply base." .

mesh:Skill_hc_operations_vendor_management a mesh:Skill ;
    mesh:skillIdentifier "hc-operations-vendor-management" ;
    rdfs:label "vendor-management" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/operations/skills/vendor-management/SKILL.md" ;
    mesh:skillDescription "Selects, contracts, and manages suppliers and vendors — requirements, evaluation, negotiation support, onboarding, performance management, and exit. Use this to choose a vendor, run a selection process, structure a service agreement's operational terms, manage an underperforming supplier, plan an exit or migration, or assess concentration and continuity risk." .

mesh:Skill_hc_people_benefits_and_leave a mesh:Skill ;
    mesh:skillIdentifier "hc-people-benefits-and-leave" ;
    rdfs:label "benefits-and-leave" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/benefits-and-leave/SKILL.md" ;
    mesh:skillDescription "Designs and runs employee benefits and leave — health and retirement plans, leave policy, cost and renewal, and the administration that keeps them compliant. Use this to design or review a benefits package, prepare for a renewal, write leave policy, handle a leave request, or decide what benefits are worth their cost." .

mesh:Skill_hc_people_chief_human_resources_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-people-chief-human-resources-officer" ;
    rdfs:label "chief-human-resources-officer" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/chief-human-resources-officer/SKILL.md" ;
    mesh:skillDescription "Owns the organization itself: org design, hiring, performance, compensation, development, culture, and employee relations. Use this to design or restructure a team, plan hiring, write a role or leveling definition, handle a performance or compensation question, diagnose why a team is underperforming for non-technical reasons, or assess the people risk in a plan. Also use for onboarding design and retention of key staff." .

mesh:Skill_hc_people_compensation_and_leveling a mesh:Skill ;
    mesh:skillIdentifier "hc-people-compensation-and-leveling" ;
    rdfs:label "compensation-and-leveling" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/compensation-and-leveling/SKILL.md" ;
    mesh:skillDescription "Builds and maintains the leveling framework and pay structure — level definitions, salary bands, benchmarking, pay equity, and how raises and promotions are decided. Use this to design or revise leveling, set or adjust salary bands, benchmark against market, handle a compensation request or counteroffer, run a review cycle, or diagnose pay compression and equity issues." .

mesh:Skill_hc_people_employee_relations a mesh:Skill ;
    mesh:skillIdentifier "hc-people-employee-relations" ;
    rdfs:label "employee-relations" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/employee-relations/SKILL.md" ;
    mesh:skillDescription "Handles the difficult human situations — grievances, complaints, investigations, conflict, and separations conducted properly. Use this to respond to a complaint or grievance, structure an investigation, handle a conflict between colleagues, prepare for a difficult conversation, or work out what a manager can and cannot do in a given situation." .

mesh:Skill_hc_people_employment_compliance a mesh:Skill ;
    mesh:skillIdentifier "hc-people-employment-compliance" ;
    rdfs:label "employment-compliance" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/employment-compliance/SKILL.md" ;
    mesh:skillDescription "Covers the employment rules that carry real penalties — exempt and non-exempt classification, overtime and hours, employee versus contractor status, work authorization and recordkeeping, accommodation requests, and the notices and retention obligations that go with them. Use this to classify a role, review a contractor arrangement, respond to an accommodation request, work out what records to keep and for how long, or sanity-check a practice you inherited." .

mesh:Skill_hc_people_hiring_and_interviewing a mesh:Skill ;
    mesh:skillIdentifier "hc-people-hiring-and-interviewing" ;
    rdfs:label "hiring-and-interviewing" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/hiring-and-interviewing/SKILL.md" ;
    mesh:skillDescription "Designs and runs hiring — role definition, sourcing, interview loop design, structured evaluation, and the decision itself. Use this to open a role, write a job description or scorecard, design an interview process, prepare interview questions, calibrate a hiring decision, or diagnose why a hiring process produces poor outcomes." .

mesh:Skill_hc_people_learning_and_development a mesh:Skill ;
    mesh:skillIdentifier "hc-people-learning-and-development" ;
    rdfs:label "learning-and-development" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/learning-and-development/SKILL.md" ;
    mesh:skillDescription "Builds capability — skills gaps, career frameworks, training that transfers to the job, and internal mobility. Use this to design a career ladder, close a capability gap, decide whether to build or hire a skill, structure onboarding into a role, or work out why training keeps failing to change anything." .

mesh:Skill_hc_people_onboarding_and_offboarding a mesh:Skill ;
    mesh:skillIdentifier "hc-people-onboarding-and-offboarding" ;
    rdfs:label "onboarding-and-offboarding" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/onboarding-and-offboarding/SKILL.md" ;
    mesh:skillDescription "Designs the joining and leaving experience — first-day readiness, ramp to productivity, knowledge capture, and clean exits. Use this to design or fix onboarding, shorten time to productivity, structure a leaver process, capture knowledge before someone leaves, or coordinate the access and asset steps around a joiner or leaver." .

mesh:Skill_hc_people_org_design a mesh:Skill ;
    mesh:skillIdentifier "hc-people-org-design" ;
    rdfs:label "org-design" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/org-design/SKILL.md" ;
    mesh:skillDescription "Designs how an organization is structured — reporting lines, team boundaries, spans and layers, role definition, and workforce planning against the strategy. Use this to structure a new team, restructure an existing one, resolve unclear ownership between teams, plan headcount, or diagnose why a team underperforms for structural rather than individual reasons." .

mesh:Skill_hc_people_payroll_operations a mesh:Skill ;
    mesh:skillIdentifier "hc-people-payroll-operations" ;
    rdfs:label "payroll-operations" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/payroll-operations/SKILL.md" ;
    mesh:skillDescription "Runs the pay cycle so it is right, on time, and provable — the calendar and cutoffs, what feeds pay from the HRIS and time systems, gross-to-net and the deductions in it, multi-jurisdiction registration and tax filing, off-cycle payments and corrections, and the reconciliation to the general ledger. Use this to design or audit a payroll process, work out what happens when someone is paid wrong, or understand what changes when you hire in a new state or country." .

mesh:Skill_hc_people_performance_management a mesh:Skill ;
    mesh:skillIdentifier "hc-people-performance-management" ;
    rdfs:label "performance-management" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/performance-management/SKILL.md" ;
    mesh:skillDescription "Runs performance systems that change behavior — expectations, feedback, review cycles, calibration, and handling underperformance. Use this to design or fix a review process, run calibration, write or coach on feedback, address sustained underperformance, or work out why reviews consume weeks and change nothing." .

mesh:Skill_hc_people_workforce_planning a mesh:Skill ;
    mesh:skillIdentifier "hc-people-workforce-planning" ;
    rdfs:label "workforce-planning" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/people/skills/workforce-planning/SKILL.md" ;
    mesh:skillDescription "Plans the shape and size of the workforce — demand for roles, build-versus-buy, attrition, and sequencing hiring against budget. Use this to build a hiring plan, decide which roles to open and in what order, model attrition and backfill, plan for a growth or contraction scenario, or connect headcount plans to the budget." .

mesh:Skill_hc_pmo_benefits_realization a mesh:Skill ;
    mesh:skillIdentifier "hc-pmo-benefits-realization" ;
    rdfs:label "benefits-realization" ;
    mesh:belongsToDepartment mesh:Dept_pmo ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/pmo/skills/benefits-realization/SKILL.md" ;
    mesh:skillDescription "Ensures projects deliver the value they were approved on — defining measurable benefits, baselining, tracking after delivery, and honest post-implementation review. Use this to define benefits for a business case, set a baseline, track whether value actually landed, or run a post-implementation review that produces something useful." .

mesh:Skill_hc_pmo_change_and_adoption a mesh:Skill ;
    mesh:skillIdentifier "hc-pmo-change-and-adoption" ;
    rdfs:label "change-and-adoption" ;
    mesh:belongsToDepartment mesh:Dept_pmo ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/pmo/skills/change-and-adoption/SKILL.md" ;
    mesh:skillDescription "Gets people to actually use what was delivered — stakeholder analysis, communication, training, resistance, and measuring adoption. Use this to plan a rollout, recover an implementation nobody is using, handle resistance to a change, sequence communications, or work out why a technically successful project changed nothing." .

mesh:Skill_hc_pmo_dependency_and_risk_management a mesh:Skill ;
    mesh:skillIdentifier "hc-pmo-dependency-and-risk-management" ;
    rdfs:label "dependency-and-risk-management" ;
    mesh:belongsToDepartment mesh:Dept_pmo ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/pmo/skills/dependency-and-risk-management/SKILL.md" ;
    mesh:skillDescription "Manages delivery risk and cross-team dependencies — identifying, sizing, mitigating and escalating what could stop the work. Use this to build a risk register that gets used, manage dependencies between teams, decide what to escalate and when, or work out why the same risks keep materializing unmanaged." .

mesh:Skill_hc_pmo_estimating_and_contingency a mesh:Skill ;
    mesh:skillIdentifier "hc-pmo-estimating-and-contingency" ;
    rdfs:label "estimating-and-contingency" ;
    mesh:belongsToDepartment mesh:Dept_pmo ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/pmo/skills/estimating-and-contingency/SKILL.md" ;
    mesh:skillDescription "Produces a cost or effort estimate someone can defend — decomposing the work, choosing between analogous, parametric and bottom-up methods, documenting the basis and its assumptions, expressing confidence as a range, and sizing contingency and management reserve separately. Use this to build an estimate, challenge one you have been handed, work out why estimates keep coming in low, or decide how much reserve a portfolio actually needs." .

mesh:Skill_hc_pmo_head_of_pmo a mesh:Skill ;
    mesh:skillIdentifier "hc-pmo-head-of-pmo" ;
    rdfs:label "head-of-pmo" ;
    mesh:belongsToDepartment mesh:Dept_pmo ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/pmo/skills/head-of-pmo/SKILL.md" ;
    mesh:skillDescription "The EPMO lead's remit — what the PMO governs, what it must never become, and how it earns standing rather than compliance. Use this to stand up or reform a PMO, decide what it should and should not control, judge whether it is adding value or overhead, or work out why teams route around it." .

mesh:Skill_hc_pmo_portfolio_governance a mesh:Skill ;
    mesh:skillIdentifier "hc-pmo-portfolio-governance" ;
    rdfs:label "portfolio-governance" ;
    mesh:belongsToDepartment mesh:Dept_pmo ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/pmo/skills/portfolio-governance/SKILL.md" ;
    mesh:skillDescription "Governs the portfolio of work — intake, prioritization, stage gates, resource contention, and stopping things. Use this to set up intake and prioritization, run a stage gate, decide between competing initiatives, resolve resource contention across projects, or work out why everything is in flight and nothing is finishing." .

mesh:Skill_hc_pmo_program_management a mesh:Skill ;
    mesh:skillIdentifier "hc-pmo-program-management" ;
    rdfs:label "program-management" ;
    mesh:belongsToDepartment mesh:Dept_pmo ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/pmo/skills/program-management/SKILL.md" ;
    mesh:skillDescription "Plans and drives cross-functional programs to delivery — scope, sequencing, dependencies, status, risk, and the escalations that keep work moving. Use this to run a multi-team initiative, recover a program that is slipping, build a delivery plan with dependencies, structure status reporting, or diagnose why cross-team work keeps missing dates." .

mesh:Skill_hc_pmo_project_delivery a mesh:Skill ;
    mesh:skillIdentifier "hc-pmo-project-delivery" ;
    rdfs:label "project-delivery" ;
    mesh:belongsToDepartment mesh:Dept_pmo ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/pmo/skills/project-delivery/SKILL.md" ;
    mesh:skillDescription "Plans and delivers a single project — scope, estimation, scheduling, critical path, tracking, and recovering when it slips. Use this to plan a project, build or challenge a schedule, estimate credibly, track progress meaningfully, or recover a project that is late." .

mesh:Skill_hc_pmo_schedule_development_and_analysis a mesh:Skill ;
    mesh:skillIdentifier "hc-pmo-schedule-development-and-analysis" ;
    rdfs:label "schedule-development-and-analysis" ;
    mesh:belongsToDepartment mesh:Dept_pmo ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/pmo/skills/schedule-development-and-analysis/SKILL.md" ;
    mesh:skillDescription "Builds and interrogates a project schedule — logic-driven sequencing, dependency types and lags, float and the critical path, resource loading and leveling, schedule risk analysis, and measuring progress against a baseline rather than against optimism. Use this to construct a schedule, audit one you have inherited, find out why a plan keeps slipping, work out what a date change actually costs, or judge whether a reported percentage complete means anything." .

mesh:Skill_hc_product_brand_identity a mesh:Skill ;
    mesh:skillIdentifier "hc-product-brand-identity" ;
    rdfs:label "brand-identity" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/brand-identity/SKILL.md" ;
    mesh:skillDescription "Defines and applies visual brand — logo usage, palette, typography, imagery direction, and the guidelines that keep expression consistent across product and marketing surfaces. Use this to establish a brand from scratch, audit whether an existing brand is being applied consistently, build brand guidelines, or decide how a brand should express itself in an unfamiliar format." .

mesh:Skill_hc_product_chief_product_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-product-chief-product-officer" ;
    rdfs:label "chief-product-officer" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/chief-product-officer/SKILL.md" ;
    mesh:skillDescription "Owns what gets built and why: product strategy, roadmap, discovery, user experience, and the definition of success for each release. Use this to decide what to build next, to cut scope, to turn a business goal into a product bet, to judge whether a feature is worth its cost, or when engineering and go-to-market disagree about what a release is for. Also use for roadmap sequencing and for killing work that is not earning its place." .

mesh:Skill_hc_product_design_styles a mesh:Skill ;
    mesh:skillIdentifier "hc-product-design-styles" ;
    rdfs:label "design-styles" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/design-styles/SKILL.md" ;
    mesh:skillDescription "Applies a deliberate visual direction to an interface — minimalist editorial, industrial utilitarian, or high-polish commercial — each with its own type scale, palette behavior, surface treatment, and motion. Use this when a product needs a point of view rather than defaults, when choosing between visual directions, when an interface reads as generic, or when restyling something without changing its structure." .

mesh:Skill_hc_product_design_system a mesh:Skill ;
    mesh:skillIdentifier "hc-product-design-system" ;
    rdfs:label "design-system" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/design-system/SKILL.md" ;
    mesh:skillDescription "Builds and maintains the design system a product is assembled from — tokens for color, type, spacing and elevation, component contracts, and the rules that keep them coherent as the product grows. Use this when starting a new interface, when screens have drifted apart visually, when the same component exists three times in slightly different forms, or when a token or component needs adding without breaking what exists." .

mesh:Skill_hc_product_interface_craft a mesh:Skill ;
    mesh:skillIdentifier "hc-product-interface-craft" ;
    rdfs:label "interface-craft" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/interface-craft/SKILL.md" ;
    mesh:skillDescription "Raises the visual and interaction quality of an interface — layout, hierarchy, type, spacing, density, and the details that separate a considered product from a generic one. Use this when a screen works but looks unfinished or default, when a layout feels crowded or arbitrary, when a page has no clear focal point, or when an interface needs to feel trustworthy rather than merely functional." .

mesh:Skill_hc_product_interface_redesign a mesh:Skill ;
    mesh:skillIdentifier "hc-product-interface-redesign" ;
    rdfs:label "interface-redesign" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/interface-redesign/SKILL.md" ;
    mesh:skillDescription "Upgrades an existing interface to a higher standard without rebuilding it — auditing what is there, identifying what reads as generic or unfinished, and sequencing changes by impact. Use this when a product works but looks dated or default, when a redesign is being considered, when deciding whether to restyle or rebuild, or when a screen needs to look substantially better with limited effort." .

mesh:Skill_hc_product_presentation_design a mesh:Skill ;
    mesh:skillIdentifier "hc-product-presentation-design" ;
    rdfs:label "presentation-design" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/presentation-design/SKILL.md" ;
    mesh:skillDescription "Designs slide decks and one-pagers that carry an argument rather than decorate one — deck structure, headlines that state the takeaway, charts that make a single point, and the different rules board decks and conference talks follow. Use this to build or fix a pitch deck, board deck, or conference talk, to design a one-pager, or when a deck is dense, unfocused, or being read aloud from the slides. For social graphics, carousels and infographics, use `marketing:visual-content` instead." .

mesh:Skill_hc_product_product_discovery a mesh:Skill ;
    mesh:skillIdentifier "hc-product-product-discovery" ;
    rdfs:label "product-discovery" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/product-discovery/SKILL.md" ;
    mesh:skillDescription "Finds out whether a problem is real and a solution would work, before building it — recruiting the right people, interviewing without leading them, separating what users say from what they do, naming the riskiest assumption and testing that one first, and reaching a decision rather than a summary. Use this to validate a problem, test an idea cheaply, decide whether to build something, or fix a discovery process that keeps confirming what the team already believed." .

mesh:Skill_hc_product_product_requirements a mesh:Skill ;
    mesh:skillIdentifier "hc-product-product-requirements" ;
    rdfs:label "product-requirements" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/product-requirements/SKILL.md" ;
    mesh:skillDescription "Writes down what is being built so a team can build it and know when they are done — problem and success measure before solution, scope stated by exclusion, user-visible behavior including the states everyone forgets, acceptance criteria someone can test, and the open questions named rather than buried. Use this to write a specification, review one that is causing rework, or work out why a delivered feature technically matched the request and still was not what anyone wanted." .

mesh:Skill_hc_product_ux_product_auditor a mesh:Skill ;
    mesh:skillIdentifier "hc-product-ux-product-auditor" ;
    rdfs:label "ux-product-auditor" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/ux-product-auditor/SKILL.md" ;
    mesh:skillDescription "Audits a website, app, onboarding flow, or design for usability, conversion, and product problems, tying every finding to a business outcome and a severity. Use this to review an interface, diagnose low conversion or activation, find where users drop off, get structured product feedback, or decide which UX fixes to ship first. For raising visual quality rather than finding problems, use `interface-craft`." .

mesh:Skill_hc_product_visual_reference_generation a mesh:Skill ;
    mesh:skillIdentifier "hc-product-visual-reference-generation" ;
    rdfs:label "visual-reference-generation" ;
    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/product/skills/visual-reference-generation/SKILL.md" ;
    mesh:skillDescription "Produces design reference imagery before implementation — screen concepts, layout directions, and flows for web or mobile that make a verbal brief concrete enough to argue with. Use this when a brief needs visualizing before anyone builds, when comparing layout directions, when handing a developer a target, or when stakeholders are describing different things with the same words." .

mesh:Skill_hc_revenue_activation a mesh:Skill ;
    mesh:skillIdentifier "hc-revenue-activation" ;
    rdfs:label "activation" ;
    mesh:belongsToDepartment mesh:Dept_revenue ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/revenue/skills/activation/SKILL.md" ;
    mesh:skillDescription "Gets new users from signup to first real value — signup flow, onboarding, time-to-value, and the early experience that determines whether someone becomes a user or a lapsed account. Use this to design or fix signup and onboarding, diagnose why signups do not convert to active use, reduce time-to-value, or decide what a new user must accomplish first." .

mesh:Skill_hc_revenue_chief_revenue_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-revenue-chief-revenue-officer" ;
    rdfs:label "chief-revenue-officer" ;
    mesh:belongsToDepartment mesh:Dept_revenue ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/revenue/skills/chief-revenue-officer/SKILL.md" ;
    mesh:skillDescription "Owns the revenue engine end to end: sales, monetization, pricing, customer success, retention, and partnerships. Use this for pricing and packaging decisions, sales strategy and coverage, forecast and pipeline health, churn and expansion, partner and channel strategy, or when marketing-sourced demand is not converting. Also use to decide which segments to pursue and which to decline." .

mesh:Skill_hc_revenue_deal_negotiation a mesh:Skill ;
    mesh:skillIdentifier "hc-revenue-deal-negotiation" ;
    rdfs:label "deal-negotiation" ;
    mesh:belongsToDepartment mesh:Dept_revenue ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/revenue/skills/deal-negotiation/SKILL.md" ;
    mesh:skillDescription "Negotiates a commercial deal without giving away the terms that matter — preparing your walk-away and theirs, trading concessions rather than conceding them, recognizing the tactics that create false urgency, protecting price by moving other variables, and closing on terms someone can actually deliver. Use this to prepare for a negotiation, respond to a demand mid-deal, work out why discounts keep landing at quarter end, or review terms before they are signed." .

mesh:Skill_hc_revenue_outbound_prospecting a mesh:Skill ;
    mesh:skillIdentifier "hc-revenue-outbound-prospecting" ;
    rdfs:label "outbound-prospecting" ;
    mesh:belongsToDepartment mesh:Dept_revenue ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/revenue/skills/outbound-prospecting/SKILL.md" ;
    mesh:skillDescription "Finds, qualifies, and reaches prospects through cold outreach — list building, qualification criteria, cold email and multi-channel sequences, and the follow-up that actually gets replies. Use this to build a prospect list, write cold outreach, fix a sequence that is not getting responses, define qualification criteria, or decide whether a segment is worth pursuing." .

mesh:Skill_hc_revenue_pricing_and_packaging a mesh:Skill ;
    mesh:skillIdentifier "hc-revenue-pricing-and-packaging" ;
    rdfs:label "pricing-and-packaging" ;
    mesh:belongsToDepartment mesh:Dept_revenue ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/revenue/skills/pricing-and-packaging/SKILL.md" ;
    mesh:skillDescription "Sets price, structures packages and tiers, and designs the monetization surfaces that carry them — upgrade paths, paywalls, and offer construction. Use this to set or change pricing, design or restructure tiers, choose a pricing metric, build an offer, design upgrade prompts and paywalls, or evaluate whether a pricing change is safe to make." .

mesh:Skill_hc_revenue_referral_programs a mesh:Skill ;
