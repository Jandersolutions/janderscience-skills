    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/estrutura-de-controle-de-entregas/SKILL.md" ;
    mesh:skillDescription "Garantir que entregas sejam feitas com qualidade e prazo." .

mesh:Skill_ia_operations_estrutura_de_processos_juridicos_e_operacionais a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-estrutura-de-processos-juridicos-e-operacionais" ;
    rdfs:label "estrutura-de-processos-juridicos-e-operacionais" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/estrutura-de-processos-juridicos-e-operacionais/SKILL.md" ;
    mesh:skillDescription "Mapear e organizar processos jurídicos e operacionais da rotina — criando fluxos claros, checklists e padrões para reduzir sobrecarga e ganhar previsibilidade." .

mesh:Skill_ia_operations_estrutura_de_reuniao_de_pipeline_de_vendas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-estrutura-de-reuniao-de-pipeline-de-vendas" ;
    rdfs:label "estrutura-de-reuniao-de-pipeline-de-vendas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/estrutura-de-reuniao-de-pipeline-de-vendas/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura completa da reunião semanal de acompanhamento do pipeline de vendas — com pauta padronizada, perguntas certas por etapa do funil, critérios de priorização e template de registro de decisões — para que o gestor conduza reuniões de 20-30 minutos que realmente destravam negócios, identificam onde cada corretor precisa de ajuda e mantêm todos os leads quentes em movimento." .

mesh:Skill_ia_operations_fluxo_de_aprovacao_e_alcadas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-fluxo-de-aprovacao-e-alcadas" ;
    rdfs:label "fluxo-de-aprovacao-e-alcadas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/fluxo-de-aprovacao-e-alcadas/SKILL.md" ;
    mesh:skillDescription "Criar um documento de fluxo de aprovação e alçadas decisórias para processos operacionais — definindo quem pode decidir o quê, em que valor ou magnitude, e qual o fluxo de escalada quando a decisão ultrapassa a alçada do executor. Elimina a dependência do gestor para decisões que poderiam ser tomadas pela equipe, e ao mesmo tempo protege a organização de decisões tomadas sem autorização adequada." .

mesh:Skill_ia_operations_framework_de_argumentacao_para_conteudo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-argumentacao-para-conteudo" ;
    rdfs:label "framework-de-argumentacao-para-conteudo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-argumentacao-para-conteudo/SKILL.md" ;
    mesh:skillDescription "Construir conteúdos com lógica, clareza e poder persuasivo." .

mesh:Skill_ia_operations_framework_de_criacao_de_solucao_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-criacao-de-solucao-para-cliente" ;
    rdfs:label "framework-de-criacao-de-solucao-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-criacao-de-solucao-para-cliente/SKILL.md" ;
    mesh:skillDescription "Criar soluções de marketing e vendas personalizadas para clientes de consultoria — usando um framework de raciocínio estratégico que vai do diagnóstico ao plano de ação — para que a consultora possa montar propostas únicas, específicas e de alto valor para cada cliente sem começar do zero toda vez, entregando o que nenhum template genérico entregaria." .

mesh:Skill_ia_operations_framework_de_decisao_estrategica_para_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-decisao-estrategica-para-e-commerce" ;
    rdfs:label "framework-de-decisao-estrategica-para-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-decisao-estrategica-para-e-commerce/SKILL.md" ;
    mesh:skillDescription "Criar um framework completo para tomar decisões estratégicas no e-commerce — sobre onde focar energia, qual problema resolver primeiro, quando mudar de direção e como avaliar se uma iniciativa valeu a pena — para eliminar a paralisia de \"não sei o que fazer\" e o erro de \"fazer tudo ao mesmo tempo sem resultado\". Para o empreendedor solo, clareza estratégica é a alavanca mais subutilizada." .

mesh:Skill_ia_operations_framework_de_delegacao_inteligente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-delegacao-inteligente" ;
    rdfs:label "framework-de-delegacao-inteligente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-delegacao-inteligente/SKILL.md" ;
    mesh:skillDescription "Criar um plano completo de delegação para uma responsabilidade, projeto ou conjunto de tarefas que hoje está nas costas do diretor — com briefing claro, nível de autonomia, critérios de sucesso e protocolo de acompanhamento — para que o time ganhe ownership real e o diretor saia do operacional sem perder o controle." .

mesh:Skill_ia_operations_framework_de_diagnostico_de_marketing_do_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-diagnostico-de-marketing-do-cliente" ;
    rdfs:label "framework-de-diagnostico-de-marketing-do-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-diagnostico-de-marketing-do-cliente/SKILL.md" ;
    mesh:skillDescription "Aplicar um framework estruturado para diagnosticar a situação de marketing e vendas de um cliente — avaliando os 5 pilares críticos, identificando o gargalo principal e gerando um relatório de diagnóstico que impressiona na reunião e justifica a contratação da consultoria. Para consultores que ainda fazem diagnóstico na intuição e querem ter um método replicável e profissional." .

mesh:Skill_ia_operations_framework_de_diagnostico_estrategico_de_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-diagnostico-estrategico-de-cliente" ;
    rdfs:label "framework-de-diagnostico-estrategico-de-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-diagnostico-estrategico-de-cliente/SKILL.md" ;
    mesh:skillDescription "Realizar um diagnóstico estratégico profundo de um cliente de consultoria de marketing e vendas — identificando o problema real por trás do sintoma apresentado, os gargalos prioritários, as alavancas de maior impacto e a solução mais adequada — para entregar insights de alto valor que justifiquem honorários premium e diferenciem a consultora de quem só executa o que o cliente pede." .

mesh:Skill_ia_operations_framework_de_diagnostico_estrategico_do_negocio a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-diagnostico-estrategico-do-negocio" ;
    rdfs:label "framework-de-diagnostico-estrategico-do-negocio" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-diagnostico-estrategico-do-negocio/SKILL.md" ;
    mesh:skillDescription "Aplicar um framework de diagnóstico estratégico completo — combinando análise de modelo de negócio, eficiência operacional, posicionamento de mercado e saúde financeira — para ter uma visão clara de onde o negócio está hoje, quais são os gargalos reais de crescimento e quais são as alavancas de maior impacto para os próximos 90 dias. É a ferramenta para usar quando você sente que algo está errado mas não sabe exatamente o quê." .

mesh:Skill_ia_operations_framework_de_okrs_para_e_commerce_com_time_pequeno a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-okrs-para-e-commerce-com-time-pequeno" ;
    rdfs:label "framework-de-okrs-para-e-commerce-com-time-pequeno" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-okrs-para-e-commerce-com-time-pequeno/SKILL.md" ;
    mesh:skillDescription "Criar OKRs (Objectives and Key Results) trimestrais para o e-commerce — com objetivos inspiradores, resultados-chave mensuráveis e iniciativas priorizadas — para alinhar o time em torno do que realmente importa, eliminar a dispersão de esforço e criar uma cultura de accountability sem precisar de um sistema complexo de gestão." .

mesh:Skill_ia_operations_framework_de_onboarding_de_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-onboarding-de-cliente" ;
    rdfs:label "framework-de-onboarding-de-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-onboarding-de-cliente/SKILL.md" ;
    mesh:skillDescription "Estruturar o processo completo de onboarding de um novo cliente na agência — com kickoff, coleta de informações, alinhamento de expectativas, entregáveis das primeiras semanas e rituais de acompanhamento — para que toda entrada de cliente seja organizada, profissional e gere confiança imediata, eliminando o caos das primeiras semanas que mancha a percepção de qualidade da agência." .

mesh:Skill_ia_operations_framework_de_pensamento_estrategico_para_conteudo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-pensamento-estrategico-para-conteudo" ;
    rdfs:label "framework-de-pensamento-estrategico-para-conteudo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-pensamento-estrategico-para-conteudo/SKILL.md" ;
    mesh:skillDescription "Desenvolver conteúdos mais profundos, com visão estratégica e diferenciação real." .

mesh:Skill_ia_operations_framework_de_pensamento_estrategico_para_gestor_de_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-pensamento-estrategico-para-gestor-de-e-commerce" ;
    rdfs:label "framework-de-pensamento-estrategico-para-gestor-de-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-pensamento-estrategico-para-gestor-de-e-commerce/SKILL.md" ;
    mesh:skillDescription "Aplicar frameworks de pensamento estratégico — First Principles, Inversion, Second-Order Thinking e SWOT dinâmico — para analisar desafios e oportunidades do e-commerce com mais profundidade, evitar o pensamento superficial e chegar a conclusões que a maioria dos gestores não chega porque usa só o pensamento linear." .

mesh:Skill_ia_operations_framework_de_plano_de_acao_para_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-plano-de-acao-para-e-commerce" ;
    rdfs:label "framework-de-plano-de-acao-para-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-plano-de-acao-para-e-commerce/SKILL.md" ;
    mesh:skillDescription "Criar planos de ação estruturados usando frameworks estratégicos — 5W2H, árvore de causas e mapa de dependências — para transformar um problema ou iniciativa em passos de execução claros, com responsável, prazo e critério de sucesso, eliminando a ambiguidade que paralisa times pequenos." .

mesh:Skill_ia_operations_framework_de_plano_de_marketing_em_90_dias a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-plano-de-marketing-em-90-dias" ;
    rdfs:label "framework-de-plano-de-marketing-em-90-dias" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-plano-de-marketing-em-90-dias/SKILL.md" ;
    mesh:skillDescription "Criar um plano de marketing completo e executável de 90 dias para um cliente de consultoria — com metas claras, estratégia de aquisição, calendário de ações, responsabilidades e critérios de ajuste — para que o cliente saia da reunião com um documento que guia cada semana de trabalho e a consultora tenha o entregável que demonstra o valor do serviço contratado." .

mesh:Skill_ia_operations_framework_de_priorizacao_de_tarefas_para_gestor_de_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-priorizacao-de-tarefas-para-gestor-de-e-commerce" ;
    rdfs:label "framework-de-priorizacao-de-tarefas-para-gestor-de-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-priorizacao-de-tarefas-para-gestor-de-e-commerce/SKILL.md" ;
    mesh:skillDescription "Aplicar frameworks estratégicos de priorização — ICE Score, RICE, Matriz de Eisenhower e MoSCoW — para transformar uma lista caótica de tarefas do gestor e do time em uma fila de execução ordenada por impacto real, eliminando a paralisia de \"não sei por onde começar\" e garantindo que o esforço vai para o que realmente move o negócio." .

mesh:Skill_ia_operations_framework_de_priorizacao_e_tomada_de_decisao a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-priorizacao-e-tomada-de-decisao" ;
    rdfs:label "framework-de-priorizacao-e-tomada-de-decisao" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-priorizacao-e-tomada-de-decisao/SKILL.md" ;
    mesh:skillDescription "Aplicar frameworks estratégicos de priorização e tomada de decisão — Matriz de Eisenhower, ICE Score, Análise de Custo de Oportunidade e Regra 10/10/10 — para qualquer situação em que você esteja sobrecarregado de demandas e não sabe por onde começar, qual projeto aceitar, qual descartar ou qual decisão tomar. Transforma a paralisia e o caos em clareza e ação em menos de 30 minutos." .

mesh:Skill_ia_operations_framework_de_storytelling_para_conteudo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-storytelling-para-conteudo" ;
    rdfs:label "framework-de-storytelling-para-conteudo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-storytelling-para-conteudo/SKILL.md" ;
    mesh:skillDescription "Transformar conteúdos em histórias envolventes que conectam e geram impacto." .

mesh:Skill_ia_operations_framework_de_tomada_de_decisao a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-tomada-de-decisao" ;
    rdfs:label "framework-de-tomada-de-decisao" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-tomada-de-decisao/SKILL.md" ;
    mesh:skillDescription "Estruturar qualquer decisão estratégica ou operacional difícil — com análise das opções disponíveis, critérios de avaliação, riscos e consequências — para que o gestor saia do loop de \"fico com A ou B?\" e chegue a uma decisão fundamentada, sem pressa e sem excesso de análise paralisante." .

mesh:Skill_ia_operations_framework_de_tomada_de_decisao_estrategica a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-tomada-de-decisao-estrategica" ;
    rdfs:label "framework-de-tomada-de-decisao-estrategica" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-tomada-de-decisao-estrategica/SKILL.md" ;
    mesh:skillDescription "Aplicar frameworks estratégicos consolidados — como matriz de decisão, análise de custo de oportunidade, 2nd order thinking e pre-mortem — para tomar decisões complexas de negócio com mais profundidade e menos viés, para que o gestor pare de decidir no improviso ou na intuição quando os stakes são altos, e comece a ter um processo estruturado que ele consegue explicar para sócios, equipe e investidores." .

mesh:Skill_ia_operations_framework_de_tomada_de_decisao_gerencial a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-tomada-de-decisao-gerencial" ;
    rdfs:label "framework-de-tomada-de-decisao-gerencial" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-tomada-de-decisao-gerencial/SKILL.md" ;
    mesh:skillDescription "Aplicar frameworks estruturados de tomada de decisão gerencial — análise de trade-offs, árvore de decisão, análise de risco e critérios ponderados — para que gestores consigam estruturar qualquer decisão difícil de forma racional e documentada, reduzindo o peso emocional, alinhando stakeholders e criando um registro que justifica a escolha. Para decisões de contratar, investir, cortar, mudar de estratégia ou entrar em um novo mercado." .

mesh:Skill_ia_operations_framework_de_tomada_de_decisao_para_gestor_de_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-framework-de-tomada-de-decisao-para-gestor-de-e-commerce" ;
    rdfs:label "framework-de-tomada-de-decisao-para-gestor-de-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/framework-de-tomada-de-decisao-para-gestor-de-e-commerce/SKILL.md" ;
    mesh:skillDescription "Aplicar frameworks estratégicos de tomada de decisão — Regret Minimization, WRAP, Pré-mortem e Matriz de Decisão — para resolver dilemas complexos de e-commerce com critério objetivo, reduzindo a influência do viés e da emoção e chegando a uma decisão mais rápida e mais confiante mesmo com informação incompleta." .

mesh:Skill_ia_operations_gerador_de_it_instrucao_de_trabalho a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gerador-de-it-instrucao-de-trabalho" ;
    rdfs:label "gerador-de-it-instrucao-de-trabalho" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gerador-de-it-instrucao-de-trabalho/SKILL.md" ;
    mesh:skillDescription "Criar uma Instrução de Trabalho completa — documento mais granular que o POP, que descreve exatamente como executar uma tarefa específica, com detalhes de operação, alertas de segurança, critérios de aceite e imagens/descrições visuais quando necessário. A IT é o \"como fazer\" dentro do \"o que fazer\" definido pelo POP, e é o documento que o operador consulta no momento da execução." .

mesh:Skill_ia_operations_gerador_de_politica_de_processo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gerador-de-politica-de-processo" ;
    rdfs:label "gerador-de-politica-de-processo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gerador-de-politica-de-processo/SKILL.md" ;
    mesh:skillDescription "Criar um documento de Política completo para qualquer processo operacional — estabelecendo as diretrizes, regras de conduta, obrigações, restrições, penalidades por descumprimento e referências ao POP e IT vinculados. A Política é o documento de governança que responde \"por que e com que regras esse processo existe\", enquanto o POP responde \"o quê fazer\" e a IT responde \"como fazer\"." .

mesh:Skill_ia_operations_gerador_de_pop_procedimento_operacional_padrao a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gerador-de-pop-procedimento-operacional-padrao" ;
    rdfs:label "gerador-de-pop-procedimento-operacional-padrao" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gerador-de-pop-procedimento-operacional-padrao/SKILL.md" ;
    mesh:skillDescription "Criar um Procedimento Operacional Padrão completo — com objetivo, escopo, responsabilidades, fluxo de etapas, critérios de qualidade e referências cruzadas — para qualquer processo logístico ou operacional. O POP é o documento-mestre que garante que o processo seja executado da mesma forma, por qualquer pessoa, em qualquer momento, eliminando variação e retrabalho." .

mesh:Skill_ia_operations_gerador_de_termo_de_adesao a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gerador-de-termo-de-adesao" ;
    rdfs:label "gerador-de-termo-de-adesao" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gerador-de-termo-de-adesao/SKILL.md" ;
    mesh:skillDescription "Criar um Termo de Adesão completo — documento assinado pelo colaborador que formaliza o conhecimento, o entendimento e o comprometimento com as diretrizes de uma Política, POP ou conjunto de normas operacionais. O Termo de Adesão é o elo que transforma documentos normativos em compromissos individuais rastreáveis, criando respaldo formal em caso de descumprimento e evidência de comunicação em auditorias." .

mesh:Skill_ia_operations_gestao_de_agenda_e_reducao_de_faltas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gestao-de-agenda-e-reducao-de-faltas" ;
    rdfs:label "gestao-de-agenda-e-reducao-de-faltas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gestao-de-agenda-e-reducao-de-faltas/SKILL.md" ;
    mesh:skillDescription "Criar um sistema completo de confirmação de consultas e redução de faltas — com mensagens de confirmação, lembretes escalonados, processo de reagendamento e política de lista de espera — para reduzir horários vagos, aumentar a ocupação da agenda e garantir que os médicos locatários e a fonoaudióloga tenham suas agendas preenchidas. Cada falta não confirmada é receita não faturada." .

mesh:Skill_ia_operations_gestao_de_escala_operacional a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gestao-de-escala-operacional" ;
    rdfs:label "gestao-de-escala-operacional" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gestao-de-escala-operacional/SKILL.md" ;
    mesh:skillDescription "Criar e gerenciar a escala operacional de uma equipe pequena — com distribuição de turnos, cobertura de folgas, plano de contingência para ausências e critérios de substituição — de forma que a operação nunca pare por falta de pessoal e que nenhum colaborador seja sobrecarregado por escala mal-feita. Para o gestor solo, a escala bem feita é a base que garante que o trabalho aconteça independente de imprevistos." .

mesh:Skill_ia_operations_gestao_de_escopo_e_mudancas_de_projeto a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gestao-de-escopo-e-mudancas-de-projeto" ;
    rdfs:label "gestao-de-escopo-e-mudancas-de-projeto" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gestao-de-escopo-e-mudancas-de-projeto/SKILL.md" ;
    mesh:skillDescription "Criar um sistema prático para lidar com pedidos de mudança de escopo durante projetos — com scripts de resposta, templates de aditivo contratual e critérios claros para o que é ajuste vs. o que é projeto novo — para nunca mais fazer trabalho extra de graça por não saber como cobrar, sem criar conflito com o cliente e sem parecer difícil de trabalhar." .

mesh:Skill_ia_operations_gestao_de_projeto_tecnico_completo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gestao-de-projeto-tecnico-completo" ;
    rdfs:label "gestao-de-projeto-tecnico-completo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gestao-de-projeto-tecnico-completo/SKILL.md" ;
    mesh:skillDescription "Estruturar toda a documentação de um projeto técnico — segurança eletrônica, smartcity ou sonorização — reunindo dados técnicos, relação de itens, planilha de custos, topologia, descritivo e proposta em um único fluxo organizado, para que o gestor nunca mais perca informação crítica entre etapas, entregue projetos com qualidade consistente e consiga tocar múltiplos projetos em paralelo sem depender de memória ou de equipe robusta." .

mesh:Skill_ia_operations_gestor_de_comunidade_de_alunas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gestor-de-comunidade-de-alunas" ;
    rdfs:label "gestor-de-comunidade-de-alunas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gestor-de-comunidade-de-alunas/SKILL.md" ;
    mesh:skillDescription "Planejar e gerar conteúdos, dinâmicas, perguntas e estratégias de engajamento para comunidades de alunas no WhatsApp, Telegram ou plataformas de membros — mantendo a comunidade ativa, útil e com alto nível de satisfação sem consumir horas da empreendedora. O resultado é uma comunidade que as alunas valorizam e que vira prova social para novas vendas." .

mesh:Skill_ia_operations_gestor_de_multiplos_projetos_simultaneos a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gestor-de-multiplos-projetos-simultaneos" ;
    rdfs:label "gestor-de-multiplos-projetos-simultaneos" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gestor-de-multiplos-projetos-simultaneos/SKILL.md" ;
    mesh:skillDescription "Criar um sistema de acompanhamento para múltiplos projetos rodando ao mesmo tempo — com visão consolidada de status, próximos passos e riscos — para que o gestor pare de depender da memória ou de planilhas confusas e tenha em 5 minutos uma visão clara do que está atrasado, do que precisa de atenção e do que está no caminho certo." .

mesh:Skill_ia_operations_gestor_de_prioridades_com_okrs_simplificados a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-gestor-de-prioridades-com-okrs-simplificados" ;
    rdfs:label "gestor-de-prioridades-com-okrs-simplificados" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/gestor-de-prioridades-com-okrs-simplificados/SKILL.md" ;
    mesh:skillDescription "Criar um conjunto de OKRs (Objetivos e Resultados-Chave) práticos e claros para uma equipe pequena — sem a burocracia e complexidade das grandes implementações — para que o gestor e a equipe saibam exatamente o que perseguir, como medir progresso e onde não gastar energia no trimestre." .

mesh:Skill_ia_operations_guia_de_delegacao_e_autonomia_de_equipe a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-guia-de-delegacao-e-autonomia-de-equipe" ;
    rdfs:label "guia-de-delegacao-e-autonomia-de-equipe" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/guia-de-delegacao-e-autonomia-de-equipe/SKILL.md" ;
    mesh:skillDescription "Criar um guia completo de delegação eficaz — com mapeamento de tarefas delegáveis, matriz de autonomia por colaborador, protocolo de delegação e sistema de acompanhamento — para que gestores parem de fazer tudo pessoalmente, desenvolvam a autonomia da equipe e liberem tempo para atividades estratégicas. Para quem quer reduzir custo com equipe e produzir mais sem contratar: delegação eficaz é o caminho." .

mesh:Skill_ia_operations_guia_passo_a_passo_para_usar_o_claude_no_trabalho_juridico a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-guia-passo-a-passo-para-usar-o-claude-no-trabalho-juridico" ;
    rdfs:label "guia-passo-a-passo-para-usar-o-claude-no-trabalho-juridico" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/guia-passo-a-passo-para-usar-o-claude-no-trabalho-juridico/SKILL.md" ;
    mesh:skillDescription "Mostrar de forma simples e prática como usar o Claude para acelerar o trabalho jurídico do Procurador — desde a triagem da planilha diária até a elaboração de peças — com exemplos concretos, sem jargão técnico e com passo a passo que funciona mesmo para quem está começando agora com IA." .

mesh:Skill_ia_operations_indicadores_kpi_logistico a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-indicadores-kpi-logistico" ;
    rdfs:label "indicadores-kpi-logistico" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/indicadores-kpi-logistico/SKILL.md" ;
    mesh:skillDescription "Definir e estruturar os KPIs (Key Performance Indicators) para qualquer processo logístico ou operacional — com fórmula de cálculo, fonte de dados, frequência de medição, meta, responsável e plano de ação para quando o indicador sair da faixa. Transforma documentos e processos em números rastreáveis, eliminando a gestão por percepção e criando base para decisão baseada em dados." .

mesh:Skill_ia_operations_laudo_e_relatorio_audiologico a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-laudo-e-relatorio-audiologico" ;
    rdfs:label "laudo-e-relatorio-audiologico" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/laudo-e-relatorio-audiologico/SKILL.md" ;
    mesh:skillDescription "Criar laudos e relatórios audiológicos completos e padronizados — a partir dos dados brutos dos exames (audiograma, imitanciometria, logoaudiometria) — com terminologia clínica correta, classificação da perda, interpretação funcional e conduta sugerida. Reduz o tempo de elaboração de cada laudo de 15-20 minutos para 5 minutos, mantendo padrão técnico e qualidade clínica." .

mesh:Skill_ia_operations_manual_de_processos_e_cultura_da_empresa a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-manual-de-processos-e-cultura-da-empresa" ;
    rdfs:label "manual-de-processos-e-cultura-da-empresa" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/manual-de-processos-e-cultura-da-empresa/SKILL.md" ;
    mesh:skillDescription "Criar o manual de processos e cultura da imobiliária — com valores, comportamentos esperados, procedimentos operacionais por setor e regras de convivência — para que todo colaborador novo e antigo tenha uma referência clara de \"como as coisas funcionam aqui\", reduzindo a dependência do gestor para explicar tudo pessoalmente e criando uma empresa com identidade própria que funciona mesmo quando o dono não está." .

mesh:Skill_ia_operations_mapa_de_riscos_operacionais a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-mapa-de-riscos-operacionais" ;
    rdfs:label "mapa-de-riscos-operacionais" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/mapa-de-riscos-operacionais/SKILL.md" ;
    mesh:skillDescription "Identificar e mapear os riscos de qualquer processo logístico ou operacional — classificando cada risco por probabilidade e impacto, definindo controles existentes e necessários, e gerando um plano de mitigação priorizado. Para o gestor de operações, o mapa de riscos é o documento que transforma a gestão reativa (\"apagar incêndio\") em gestão preventiva (\"evitar o incêndio\")." .

mesh:Skill_ia_operations_mapeador_de_processos_internos a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-mapeador-de-processos-internos" ;
    rdfs:label "mapeador-de-processos-internos" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/mapeador-de-processos-internos/SKILL.md" ;
    mesh:skillDescription "Transformar um processo que está na cabeça do gestor — ou que a equipe faz de forma inconsistente — em um fluxo documentado, com cada etapa descrita, responsável definido e critério de qualidade claro, para que o processo rode sem depender de você e a equipe saiba exatamente o que fazer em cada situação." .

mesh:Skill_ia_operations_mapeamento_de_processos_da_imobiliaria a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-mapeamento-de-processos-da-imobiliaria" ;
    rdfs:label "mapeamento-de-processos-da-imobiliaria" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/mapeamento-de-processos-da-imobiliaria/SKILL.md" ;
    mesh:skillDescription "Mapear, documentar e organizar os processos operacionais de cada setor da imobiliária — vendas, locação e administrativo — identificando etapas, responsáveis, entradas e saídas de cada processo, para eliminar retrabalho, definir quem faz o quê e criar a base para um manual operacional sólido que funciona mesmo quando o dono não está presente." .

mesh:Skill_ia_operations_mapeamento_ponta_a_ponta_de_processo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-mapeamento-ponta-a-ponta-de-processo" ;
    rdfs:label "mapeamento-ponta-a-ponta-de-processo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/mapeamento-ponta-a-ponta-de-processo/SKILL.md" ;
    mesh:skillDescription "Mapear qualquer processo operacional ou logístico de forma completa — do evento disparador até o resultado final — identificando todas as etapas, responsáveis, sistemas, documentos gerados, pontos de decisão, gargalos e riscos. O mapeamento ponta a ponta é o primeiro passo antes de criar qualquer POP ou IT: você só documenta bem o que entendeu completamente." .

mesh:Skill_ia_operations_material_de_treinamento_personalizado_por_colaborador a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-material-de-treinamento-personalizado-por-colaborador" ;
    rdfs:label "material-de-treinamento-personalizado-por-colaborador" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/material-de-treinamento-personalizado-por-colaborador/SKILL.md" ;
    mesh:skillDescription "Criar materiais de treinamento individualizados para cada colaborador da imobiliária com base nos pontos de melhoria identificados pelo gestor — scripts, guias práticos, exercícios e planos de acompanhamento — para desenvolver cada pessoa no que ela especificamente precisa melhorar, sem precisar contratar treinamento externo e sem desperdiçar tempo com conteúdo genérico." .

mesh:Skill_ia_operations_matriz_de_responsabilidades_raci a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-matriz-de-responsabilidades-raci" ;
    rdfs:label "matriz-de-responsabilidades-raci" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/matriz-de-responsabilidades-raci/SKILL.md" ;
    mesh:skillDescription "Criar uma Matriz RACI completa — identificando para cada atividade ou processo quem é Responsável pela execução, quem é Accountable (quem responde pelo resultado), quem precisa ser Consultado antes e quem precisa ser Informado depois — para eliminar a ambiguidade de \"quem faz o quê\" que é a principal causa de retrabalho, conflito e sobrecarga em equipes pequenas." .

mesh:Skill_ia_operations_modelo_de_reuniao_de_alinhamento_com_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-modelo-de-reuniao-de-alinhamento-com-cliente" ;
    rdfs:label "modelo-de-reuniao-de-alinhamento-com-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/modelo-de-reuniao-de-alinhamento-com-cliente/SKILL.md" ;
    mesh:skillDescription "Criar a pauta completa, o roteiro de condução e a ata estruturada de reuniões de alinhamento com clientes — kickoffs, revisões de projeto, apresentações de proposta e reuniões de crise — para que cada reunião termine com decisões claras, próximos passos definidos e responsáveis acordados, eliminando as reuniões que não chegam a lugar nenhum e os e-mails de \"para confirmar o que ficou definido\"." .

mesh:Skill_ia_operations_okrs_para_times_e_departamentos a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-okrs-para-times-e-departamentos" ;
    rdfs:label "okrs-para-times-e-departamentos" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/okrs-para-times-e-departamentos/SKILL.md" ;
    mesh:skillDescription "Criar Objetivos e Resultados-Chave (OKRs) trimestrais para um time ou departamento — com objetivos inspiradores, KRs mensuráveis e plano de acompanhamento — para que cada área tenha clareza do que precisa entregar no trimestre, o esforço do time esteja conectado à estratégia da empresa e o diretor possa acompanhar progresso sem precisar entrar no micro." .

mesh:Skill_ia_operations_onboarding_de_cliente_consultoria_de_ia a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-onboarding-de-cliente-consultoria-de-ia" ;
    rdfs:label "onboarding-de-cliente-consultoria-de-ia" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/onboarding-de-cliente-consultoria-de-ia/SKILL.md" ;
    mesh:skillDescription "Estruturar o processo completo de entrada de um novo cliente de implementação de IA — do \"contrato assinado\" ao \"começando a construir\" — com email de boas-vindas, formulário técnico de briefing, checklist de credenciais e acessos necessários, e alinhamento de expectativas. Resolve o início caótico de projetos onde o consultor precisa ir pedindo informações aos poucos, perdendo tempo e transmitindo desorganização." .

mesh:Skill_ia_operations_onboarding_de_cliente_novo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-onboarding-de-cliente-novo" ;
    rdfs:label "onboarding-de-cliente-novo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/onboarding-de-cliente-novo/SKILL.md" ;
    mesh:skillDescription "Criar o processo completo de onboarding de um novo cliente — desde a confirmação do projeto até o kick-off oficial — com coleta de acessos, alinhamento de expectativas, definição de canais de comunicação e primeiras entregas simbólicas, para causar uma primeira impressão profissional que justifica seu preço, reduz as perguntas no meio do projeto e fideliza o cliente antes mesmo de começar a desenvolver." .

mesh:Skill_ia_operations_onboarding_de_colaborador_novo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-onboarding-de-colaborador-novo" ;
    rdfs:label "onboarding-de-colaborador-novo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/onboarding-de-colaborador-novo/SKILL.md" ;
    mesh:skillDescription "Criar um processo completo de onboarding para novos colaboradores — com cronograma da primeira semana, materiais de boas-vindas, checklist de configuração e plano de treinamento — para que a integração aconteça de forma estruturada, o novo colaborador produza com autonomia em menos tempo e o gestor não precise repetir as mesmas instruções para cada nova contratação. Onboarding bom reduz o custo de treinamento e aumenta a retenção." .

mesh:Skill_ia_operations_onboarding_de_novo_cliente_consultoria_financeira a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-onboarding-de-novo-cliente-consultoria-financeira" ;
    rdfs:label "onboarding-de-novo-cliente-consultoria-financeira" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/onboarding-de-novo-cliente-consultoria-financeira/SKILL.md" ;
    mesh:skillDescription "Estruturar o processo completo de onboarding de um novo cliente de consultoria financeira — da assinatura do contrato até a primeira entrega — com checklist de documentos, roteiro da reunião de kickoff, e-mails de boas-vindas e expectativas claras para os dois lados. Elimina o início caótico de novos contratos e já começa a construir confiança desde o primeiro dia." .

mesh:Skill_ia_operations_onboarding_de_novo_cliente_contabil a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-onboarding-de-novo-cliente-contabil" ;
    rdfs:label "onboarding-de-novo-cliente-contabil" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/onboarding-de-novo-cliente-contabil/SKILL.md" ;
    mesh:skillDescription "Criar o roteiro completo de onboarding para novos clientes do escritório contábil — cobrindo coleta de dados e documentos, assinatura de contrato, configuração no sistema, comunicações iniciais e primeiras entregas — para que cada novo cliente tenha uma experiência profissional desde o primeiro dia, reduza a carga de perguntas repetitivas e aumente a probabilidade de indicação e retenção de longo prazo." .

mesh:Skill_ia_operations_onboarding_de_novo_cliente_de_branding a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-onboarding-de-novo-cliente-de-branding" ;
    rdfs:label "onboarding-de-novo-cliente-de-branding" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/onboarding-de-novo-cliente-de-branding/SKILL.md" ;
    mesh:skillDescription "Criar um processo de onboarding completo para novos clientes de branding — com mensagem de boas-vindas, instruções claras de como o projeto vai funcionar e materiais de início — para transmitir profissionalismo desde o primeiro pagamento e reduzir ansiedade e perguntas desnecessárias durante o projeto." .

mesh:Skill_ia_operations_onboarding_de_novo_cliente_freelancer a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-onboarding-de-novo-cliente-freelancer" ;
    rdfs:label "onboarding-de-novo-cliente-freelancer" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/onboarding-de-novo-cliente-freelancer/SKILL.md" ;
    mesh:skillDescription "Estruturar o processo completo de entrada de um novo cliente — do primeiro \"fechei!\" até o início do projeto — com email de boas-vindas, formulário de briefing, lista de documentos necessários e alinhamento de expectativas. Cria uma primeira impressão profissional que diferencia o freelancer organizado do que responde no WhatsApp de madrugada, e já garante que o projeto começa com as informações certas." .

mesh:Skill_ia_operations_onboarding_de_novo_corretor a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-onboarding-de-novo-corretor" ;
    rdfs:label "onboarding-de-novo-corretor" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/onboarding-de-novo-corretor/SKILL.md" ;
    mesh:skillDescription "Estruturar o processo completo de integração de novos corretores na imobiliária — desde o primeiro dia até o final do primeiro mês — com checklists por fase, programação de treinamentos iniciais e metas progressivas, para reduzir o tempo até a primeira venda, diminuir a rotatividade precoce e fazer com que o novo colaborador se sinta preparado e valorizado desde o primeiro dia." .

mesh:Skill_ia_operations_onboarding_de_profissional_locatario a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-onboarding-de-profissional-locatario" ;
    rdfs:label "onboarding-de-profissional-locatario" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/onboarding-de-profissional-locatario/SKILL.md" ;
    mesh:skillDescription "Criar o processo completo de integração de novos profissionais de saúde que alugam sala na clínica — desde a captação e negociação até a assinatura do contrato, entrega das regras de uso e orientações operacionais — para que a relação comece com clareza, os documentos estejam em ordem e a convivência seja organizada desde o primeiro dia. Profissional bem integrado respeita as regras, paga em dia e fica por mais tempo." .

mesh:Skill_ia_operations_organizacao_de_processos_e_rotinas_da_equipe a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-organizacao-de-processos-e-rotinas-da-equipe" ;
    rdfs:label "organizacao-de-processos-e-rotinas-da-equipe" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/organizacao-de-processos-e-rotinas-da-equipe/SKILL.md" ;
    mesh:skillDescription "Mapear, documentar e organizar os processos e rotinas de uma equipe pequena — com fluxogramas em texto, checklists de execução e responsabilidades claras por função — para que as atividades aconteçam da mesma forma toda vez, independentemente de quem está executando. Substitui a dependência da memória e da pessoa certa pelo processo documentado, reduzindo erros, retrabalho e custo com treinamentos constantes." .

mesh:Skill_ia_operations_organizacao_de_processos_para_empreendedor_solo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-organizacao-de-processos-para-empreendedor-solo" ;
    rdfs:label "organizacao-de-processos-para-empreendedor-solo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
