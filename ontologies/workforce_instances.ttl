    mesh:skillDescription "Garantir qualidade e evitar erros antes de finalizar o dia." .

mesh:Skill_ia_operations_comunicado_de_reajuste_de_honorarios a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-comunicado-de-reajuste-de-honorarios" ;
    rdfs:label "comunicado-de-reajuste-de-honorarios" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/comunicado-de-reajuste-de-honorarios/SKILL.md" ;
    mesh:skillDescription "Criar comunicados profissionais de reajuste de honorários para clientes do escritório contábil — com contexto de valor, justificativa clara e tom que preserva o relacionamento — para aumentar o ticket médio da carteira sem gerar churn desnecessário, transformando um momento potencialmente tenso em uma demonstração de transparência e maturidade do escritório." .

mesh:Skill_ia_operations_comunicado_interno_de_processo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-comunicado-interno-de-processo" ;
    rdfs:label "comunicado-interno-de-processo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/comunicado-interno-de-processo/SKILL.md" ;
    mesh:skillDescription "Criar um comunicado interno completo para informar a equipe sobre implantação de novo processo, mudança em POP existente, entrada em vigor de uma política ou qualquer alteração operacional — com linguagem clara, contexto do porquê da mudança, o que muda na prática e o que é esperado de cada cargo. O comunicado é a ponte entre o documento técnico (POP, IT, Política) e o entendimento real da equipe." .

mesh:Skill_ia_operations_comunicado_interno_profissional a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-comunicado-interno-profissional" ;
    rdfs:label "comunicado-interno-profissional" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/comunicado-interno-profissional/SKILL.md" ;
    mesh:skillDescription "Criar comunicados internos claros, no tom certo e com a mensagem certa para qualquer situação da empresa — mudança de processo, comunicado de resultado, nova política, reconhecimento de equipe ou momento delicado — para que a informação chegue a todo o time de forma organizada, sem ruído e sem o diretor precisar improvisar na hora." .

mesh:Skill_ia_operations_contrato_de_prestacao_de_servicos_criativos a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-contrato-de-prestacao-de-servicos-criativos" ;
    rdfs:label "contrato-de-prestacao-de-servicos-criativos" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/contrato-de-prestacao-de-servicos-criativos/SKILL.md" ;
    mesh:skillDescription "Criar contratos de prestação de serviços para projetos de design e branding — com escopo definido, política de revisão, propriedade intelectual, condições de pagamento e rescisão — para que o designer proteja seu trabalho, evite revisão infinita, receba corretamente e tenha respaldo legal quando o cliente tentar extrapolar o que foi combinado." .

mesh:Skill_ia_operations_controle_regulatorio_rdc_e_suvisa a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-controle-regulatorio-rdc-e-suvisa" ;
    rdfs:label "controle-regulatorio-rdc-e-suvisa" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/controle-regulatorio-rdc-e-suvisa/SKILL.md" ;
    mesh:skillDescription "Criar um sistema de controle dos itens obrigatórios exigidos pela RDC (Resolução da Diretoria Colegiada da ANVISA) e pela SUVISA (Superintendência de Vigilância em Saúde) para clínicas de saúde com laboratório, sala de vacina e serviços ambulatoriais — com checklists por categoria, calendário de renovações e alertas de vencimento. Para a gestora solo que precisa manter tudo em conformidade sem ter um setor de qualidade." .

mesh:Skill_ia_operations_criacao_de_playbooks_operacionais a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-criacao-de-playbooks-operacionais" ;
    rdfs:label "criacao-de-playbooks-operacionais" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
