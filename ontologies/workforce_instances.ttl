mesh:Skill_ia_operations_analise_de_causa_raiz_de_falha_operacional a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-analise-de-causa-raiz-de-falha-operacional" ;
    rdfs:label "analise-de-causa-raiz-de-falha-operacional" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/analise-de-causa-raiz-de-falha-operacional/SKILL.md" ;
    mesh:skillDescription "Investigar falhas, erros e não-conformidades operacionais usando metodologia estruturada — identificando a causa raiz real, não apenas o sintoma visível — e gerar um plano de ação corretivo com responsável e prazo. Para o gestor solo, esta skill substitui o ciclo vicioso de \"apaga o incêndio → o problema volta → apaga de novo\" por um ciclo de solução permanente." .

mesh:Skill_ia_operations_analise_de_causa_raiz_de_problemas_recorrentes a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-analise-de-causa-raiz-de-problemas-recorrentes" ;
    rdfs:label "analise-de-causa-raiz-de-problemas-recorrentes" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/analise-de-causa-raiz-de-problemas-recorrentes/SKILL.md" ;
    mesh:skillDescription "Conduzir uma análise estruturada de causa raiz para qualquer problema que se repete na operação — usando metodologias como 5 Porquês e Diagrama de Ishikawa — para sair do ciclo de apagar incêndio toda semana e chegar à causa real que, quando eliminada, resolve o problema de forma definitiva." .

mesh:Skill_ia_operations_analise_de_desempenho_de_equipe a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-analise-de-desempenho-de-equipe" ;
    rdfs:label "analise-de-desempenho-de-equipe" ;
