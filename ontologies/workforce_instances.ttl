mesh:Skill_hc_corporate_strategy_chief_strategy_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-corporate-strategy-chief-strategy-officer" ;
    rdfs:label "chief-strategy-officer" ;
    mesh:belongsToDepartment mesh:Dept_corporate-strategy ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/corporate-strategy/skills/chief-strategy-officer/SKILL.md" ;
    mesh:skillDescription "Owns where the business plays and how it wins over a multi-year horizon — portfolio choices, corporate development, strategic partnerships, and planning under uncertainty. Use this for a decision about which markets or businesses to be in, whether to build, buy, or partner, how to allocate capital across business lines, or when a long-horizon bet needs framing. Distinct from `chief-executive`, which arbitrates present-quarter conflicts." .

mesh:Skill_hc_corporate_strategy_market_entry a mesh:Skill ;
    mesh:skillIdentifier "hc-corporate-strategy-market-entry" ;
    rdfs:label "market-entry" ;
    mesh:belongsToDepartment mesh:Dept_corporate-strategy ;
    mesh:autonomyTier 3 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/corporate-strategy/skills/market-entry/SKILL.md" ;
    mesh:skillDescription "Decides whether and how to enter a new market — sizing demand from the bottom up rather than from a market report, testing whether your advantage transfers, choosing between organic entry, partnership and acquisition, sequencing the operational and regulatory work that entry actually requires, and setting the criteria that would tell you to stop. Use this to evaluate a new geography, segment or vertical, pressure-test an entry plan, or work out why a launched market never reached scale." .

mesh:Skill_hc_corporate_strategy_mergers_and_acquisitions a mesh:Skill ;
    mesh:skillIdentifier "hc-corporate-strategy-mergers-and-acquisitions" ;
    rdfs:label "mergers-and-acquisitions" ;
    mesh:belongsToDepartment mesh:Dept_corporate-strategy ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/corporate-strategy/skills/mergers-and-acquisitions/SKILL.md" ;
    mesh:skillDescription "Runs corporate development — deal thesis, target screening, valuation framing, diligence, and integration planning. Use this when considering an acquisition or being approached about one, when evaluating build-versus-buy at company scale, when running or reviewing diligence, or when planning how an acquired business will actually be integrated." .

mesh:Skill_hc_corporate_strategy_portfolio_strategy a mesh:Skill ;
    mesh:skillIdentifier "hc-corporate-strategy-portfolio-strategy" ;
    rdfs:label "portfolio-strategy" ;
    mesh:belongsToDepartment mesh:Dept_corporate-strategy ;
    mesh:autonomyTier 2 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/corporate-strategy/skills/portfolio-strategy/SKILL.md" ;
    mesh:skillDescription "Decides where capital and attention go across business lines, products, and markets — what to fund, hold, harvest, or exit, and on what evidence. Use this to allocate budget across businesses, evaluate whether a product line should continue, decide whether to exit one, structure a portfolio review, or when several initiatives compete for the same limited investment." .

mesh:Skill_hc_corporate_strategy_scenario_planning a mesh:Skill ;
    mesh:skillIdentifier "hc-corporate-strategy-scenario-planning" ;
    rdfs:label "scenario-planning" ;
    mesh:belongsToDepartment mesh:Dept_corporate-strategy ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/corporate-strategy/skills/scenario-planning/SKILL.md" ;
    mesh:skillDescription "Plans under genuine uncertainty — building scenarios, identifying which assumptions are load-bearing, setting early-warning indicators, and stress-testing a plan against futures rather than forecasting one. Use this when a decision depends on something unknowable, when a plan assumes conditions that may not hold, before a large irreversible commitment, or when a market, regulatory, or technology shift could invalidate the strategy." .

mesh:Skill_hc_corporate_strategy_strategic_alliances a mesh:Skill ;
    mesh:skillIdentifier "hc-corporate-strategy-strategic-alliances" ;
    rdfs:label "strategic-alliances" ;
    mesh:belongsToDepartment mesh:Dept_corporate-strategy ;
    mesh:autonomyTier 1 ;
    mesh:language "en-US" ;
    mesh:skillSourcePath "sources/headcount/plugins/corporate-strategy/skills/strategic-alliances/SKILL.md" ;
    mesh:skillDescription "Structures partnerships that change what the business can do — technology integrations, channel and reseller arrangements, joint ventures, and OEM relationships. Use this to evaluate or structure a strategic partnership, decide between partnering and building, negotiate commercial terms of an alliance, or diagnose a partnership that is signed but not producing. For audience-borrowing partnerships, use `marketing:partnership-marketing`." .

mesh:Skill_hc_customer_experience_chief_customer_officer a mesh:Skill ;
    mesh:skillIdentifier "hc-customer-experience-chief-customer-officer" ;
