    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/criacao-de-playbooks-operacionais/SKILL.md" ;
    mesh:skillDescription "Criar guias passo a passo para tarefas recorrentes da equipe." .

mesh:Skill_ia_operations_criador_de_comunicados_internos a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-criador-de-comunicados-internos" ;
    rdfs:label "criador-de-comunicados-internos" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/criador-de-comunicados-internos/SKILL.md" ;
    mesh:skillDescription "Redigir comunicados internos para a equipe — sobre mudanças de processo, novidades, expectativas ou decisões — de forma clara, objetiva e no tom certo, para que a informação chegue completa, seja compreendida sem ruído e não gere perguntas repetitivas que consomem o tempo do gestor." .

mesh:Skill_ia_operations_criador_de_sop_operacional a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-criador-de-sop-operacional" ;
    rdfs:label "criador-de-sop-operacional" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/criador-de-sop-operacional/SKILL.md" ;
    mesh:skillDescription "Transformar qualquer processo que vive na cabeça de alguém em um documento de procedimento operacional padrão (SOP) claro, seguível e auditável — com passo a passo, responsáveis, critérios de qualidade e pontos de controle — para que qualquer colaborador execute o processo com o mesmo padrão, sem precisar perguntar ao gestor." .

mesh:Skill_ia_operations_criador_de_sop_para_processos_recorrentes a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-criador-de-sop-para-processos-recorrentes" ;
    rdfs:label "criador-de-sop-para-processos-recorrentes" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/criador-de-sop-para-processos-recorrentes/SKILL.md" ;
    mesh:skillDescription "Criar SOPs (Standard Operating Procedures) — procedimentos passo a passo — para os processos recorrentes do negócio, transformando o \"jeito que você faz\" em documentação clara que garante consistência, reduz erro e prepara o negócio para delegar no futuro. Ideal para empreendedoras solos que fazem tudo de cabeça e querem parar de reinventar a roda toda semana." .

mesh:Skill_ia_operations_criador_de_sop_procedimento_operacional_padrao a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-criador-de-sop-procedimento-operacional-padrao" ;
    rdfs:label "criador-de-sop-procedimento-operacional-padrao" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/criador-de-sop-procedimento-operacional-padrao/SKILL.md" ;
    mesh:skillDescription "Transformar qualquer processo recorrente do time em um SOP (Standard Operating Procedure) claro e reutilizável — com etapas detalhadas, responsáveis definidos e checklists de verificação — para que qualquer pessoa consiga executar a tarefa do jeito certo, mesmo sem o gestor presente para orientar." .

mesh:Skill_ia_operations_delegacao_de_tarefas_equipe_pequena a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-delegacao-de-tarefas-equipe-pequena" ;
    rdfs:label "delegacao-de-tarefas-equipe-pequena" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/delegacao-de-tarefas-equipe-pequena/SKILL.md" ;
    mesh:skillDescription "Transformar uma lista de tarefas ou um processo que está centralizado no sócio em briefings de delegação claros e completos para a equipe — com instrução do que fazer, contexto do porquê, critério de qualidade, prazo e quando escalar. Resolve o problema de delegar e a tarefa voltar errada ou incompleta porque o briefing foi vago." .

mesh:Skill_ia_operations_delegador_de_tarefas_com_clareza a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-delegador-de-tarefas-com-clareza" ;
    rdfs:label "delegador-de-tarefas-com-clareza" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/delegador-de-tarefas-com-clareza/SKILL.md" ;
    mesh:skillDescription "Transformar uma tarefa que você quer delegar em uma instrução clara, completa e executável para um membro da equipe — com o contexto necessário, o resultado esperado e os critérios de sucesso definidos — para que a tarefa seja feita certo na primeira vez, sem você precisar refazer, corrigir ou microgerenciar." .

mesh:Skill_ia_operations_descritivo_tecnico_de_projeto a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-descritivo-tecnico-de-projeto" ;
    rdfs:label "descritivo-tecnico-de-projeto" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/descritivo-tecnico-de-projeto/SKILL.md" ;
    mesh:skillDescription "Criar um descritivo técnico completo e profissional para projetos de segurança eletrônica, smartcity ou sonorização — com especificação de sistemas, justificativa de escolha dos equipamentos, requisitos de infraestrutura e parâmetros de desempenho — para que o documento sirva como base contratual, referência para a equipe de instalação e diferencial técnico frente à concorrência que entrega apenas listas de materiais." .

mesh:Skill_ia_operations_diagnostico_de_gargalos_do_negocio a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-diagnostico-de-gargalos-do-negocio" ;
    rdfs:label "diagnostico-de-gargalos-do-negocio" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/diagnostico-de-gargalos-do-negocio/SKILL.md" ;
    mesh:skillDescription "Fazer um raio-X do seu negócio para identificar o que está travando o crescimento — se é falta de tráfego, conversão baixa, produto errado, operação ineficiente ou financeiro desorganizado. Muitas empreendedoras trabalham mais e mais sem crescer porque estão resolvendo o problema errado. Esse diagnóstico aponta o real gargalo e o que resolver primeiro para desbloquear o próximo nível de faturamento." .

mesh:Skill_ia_operations_diagnostico_de_gargalos_operacionais a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-diagnostico-de-gargalos-operacionais" ;
    rdfs:label "diagnostico-de-gargalos-operacionais" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/diagnostico-de-gargalos-operacionais/SKILL.md" ;
    mesh:skillDescription "Conduzir um diagnóstico estruturado dos gargalos operacionais da empresa — identificando onde o trabalho trava, onde há retrabalho, onde o gestor é chamado com mais frequência — para transformar observações do dia a dia em um plano priorizado de melhorias que libera capacidade sem precisar contratar." .

mesh:Skill_ia_operations_diagnostico_de_negocio_com_acoes_priorizadas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-diagnostico-de-negocio-com-acoes-priorizadas" ;
    rdfs:label "diagnostico-de-negocio-com-acoes-priorizadas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/diagnostico-de-negocio-com-acoes-priorizadas/SKILL.md" ;
    mesh:skillDescription "Analisar o negócio atual e identificar gargalos — com recomendações práticas organizadas por prioridade e impacto." .

mesh:Skill_ia_operations_diagnostico_de_problema_causa_raiz a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-diagnostico-de-problema-causa-raiz" ;
    rdfs:label "diagnostico-de-problema-causa-raiz" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/diagnostico-de-problema-causa-raiz/SKILL.md" ;
    mesh:skillDescription "Realizar um diagnóstico estruturado de qualquer problema no negócio ou nas operações — usando o método dos 5 Porquês e análise de causas raiz — para que o gestor pare de resolver o sintoma repetidamente e vá até a origem do problema, implementando uma solução que realmente elimina o bloqueio." .

mesh:Skill_ia_operations_diagnostico_de_processos_para_automatizar_com_ia a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-diagnostico-de-processos-para-automatizar-com-ia" ;
    rdfs:label "diagnostico-de-processos-para-automatizar-com-ia" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/diagnostico-de-processos-para-automatizar-com-ia/SKILL.md" ;
    mesh:skillDescription "Diagnosticar os processos operacionais de uma empresa — a partir de uma descrição da rotina ou de uma conversa com o cliente — e identificar quais têm maior potencial de automação com IA, ordenados por ROI estimado e complexidade de implementação. Gera o mapa de oportunidades que o consultor de IA precisa para apresentar uma proposta de valor concreta e fundamentada ao cliente." .

mesh:Skill_ia_operations_diagnostico_de_sobrecarga_do_gestor a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-diagnostico-de-sobrecarga-do-gestor" ;
    rdfs:label "diagnostico-de-sobrecarga-do-gestor" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/diagnostico-de-sobrecarga-do-gestor/SKILL.md" ;
    mesh:skillDescription "Fazer um diagnóstico honesto de tudo que ocupa o tempo do gestor — cruzando o que ele faz com o que só ele deveria fazer — para identificar quais atividades podem ser delegadas, automatizadas ou simplesmente eliminadas, gerando uma lista de ações concretas para recuperar horas da semana sem precisar contratar mais ninguém." .

mesh:Skill_ia_operations_diagnostico_e_plano_de_crescimento_do_negocio a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-diagnostico-e-plano-de-crescimento-do-negocio" ;
    rdfs:label "diagnostico-e-plano-de-crescimento-do-negocio" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/diagnostico-e-plano-de-crescimento-do-negocio/SKILL.md" ;
    mesh:skillDescription "Aplicar um diagnóstico estratégico completo no negócio de coaching ou consultoria — avaliando audiência, oferta, vendas, operação e financeiro — e criar um plano de crescimento com as alavancas de maior impacto para os próximos 90 dias. Para especialistas que sentem que o negócio poderia crescer mais mas não sabem exatamente o que mudar primeiro para ter mais resultado." .

mesh:Skill_ia_operations_distribuicao_de_tarefas_por_colaborador a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-distribuicao-de-tarefas-por-colaborador" ;
    rdfs:label "distribuicao-de-tarefas-por-colaborador" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/distribuicao-de-tarefas-por-colaborador/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura completa de tarefas e responsabilidades de cada colaborador da imobiliária — com rotinas diárias, semanais e mensais bem definidas — para eliminar o \"todo mundo faz tudo\" e o \"ninguém fez porque achei que era do outro\", garantindo que cada pessoa saiba exatamente o que é esperado dela e que o gestor tenha critérios claros para cobrar e avaliar." .

mesh:Skill_ia_operations_e_mail_de_onboarding_de_novo_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-e-mail-de-onboarding-de-novo-cliente" ;
    rdfs:label "e-mail-de-onboarding-de-novo-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/e-mail-de-onboarding-de-novo-cliente/SKILL.md" ;
    mesh:skillDescription "Criar a sequência de e-mails de boas-vindas e onboarding para um novo cliente de consultoria ou coaching — que confirma a decisão de compra, alinha expectativas, coleta as informações necessárias e prepara o cliente para o trabalho. Um onboarding bem feito reduz a ansiedade do cliente, diminui dúvidas recorrentes e aumenta a probabilidade de renovação — porque o cliente sente que tomou a decisão certa logo nos primeiros dias." .

mesh:Skill_ia_operations_e_mail_profissional_para_gestao_de_projetos_criativos a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-e-mail-profissional-para-gestao-de-projetos-criativos" ;
    rdfs:label "e-mail-profissional-para-gestao-de-projetos-criativos" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/e-mail-profissional-para-gestao-de-projetos-criativos/SKILL.md" ;
    mesh:skillDescription "Redigir e-mails e mensagens profissionais para todas as situações recorrentes da gestão de projetos criativos — solicitar aprovação, enviar apresentação, responder pedido fora de escopo, cobrar pagamento, comunicar atraso, entregar o projeto final — para que o designer se comunique com confiança, proteja seu trabalho e mantenha o relacionamento com o cliente sem gastar tempo escrevendo do zero." .

mesh:Skill_ia_operations_email_de_resposta_profissional_para_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-email-de-resposta-profissional-para-clientes" ;
    rdfs:label "email-de-resposta-profissional-para-clientes" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/email-de-resposta-profissional-para-clientes/SKILL.md" ;
    mesh:skillDescription "Gerar respostas de e-mail profissionais e personalizadas para clientes do escritório — cobrindo dúvidas jurídicas, atualizações de processo, cobranças e situações sensíveis — com tom adequado ao contexto, linguagem acessível ao leigo e indicação clara dos próximos passos. Elimina o tempo gasto pensando \"como vou escrever isso\" e padroniza a comunicação do escritório." .

mesh:Skill_ia_operations_email_e_whatsapp_profissional_para_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-email-e-whatsapp-profissional-para-clientes" ;
    rdfs:label "email-e-whatsapp-profissional-para-clientes" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/email-e-whatsapp-profissional-para-clientes/SKILL.md" ;
    mesh:skillDescription "Gerar respostas profissionais e rápidas para e-mails e mensagens de WhatsApp de clientes do escritório contábil — cobrindo dúvidas, cobranças de documentos, atualizações, situações delicadas e comunicados rotineiros — com tom adequado ao contexto e próximos passos claros, para eliminar o tempo gasto pensando \"como escrevo isso\" e padronizar a comunicação do escritório sem precisar de redator." .

mesh:Skill_ia_operations_estrutura_de_controle_de_entregas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-estrutura-de-controle-de-entregas" ;
    rdfs:label "estrutura-de-controle-de-entregas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
