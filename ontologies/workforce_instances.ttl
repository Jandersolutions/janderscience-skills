    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/analise-de-concorrente-e-posicionamento-e-commerce/SKILL.md" ;
    mesh:skillDescription "Analisar concorrentes de um nicho de e-commerce de forma estruturada para identificar gaps de posicionamento, lacunas de comunicação e oportunidades de diferenciação — permitindo que você posicione seu produto de forma que compita por valor, não por preço, mesmo vendendo produtos similares." .

mesh:Skill_ia_marketing_analise_rapida_de_concorrencia a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-analise-rapida-de-concorrencia" ;
