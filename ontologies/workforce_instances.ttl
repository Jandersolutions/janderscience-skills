    mesh:skillDescription "Criar a copy completa de um lançamento de serviço ou programa de consultoria — do aquecimento de audiência até o fechamento de vagas — incluindo sequência de conteúdo pré-lançamento, copy de apresentação da oferta, emails de abertura e fechamento, e comunicação de urgência real — para uma consultora que quer lançar com estrutura profissional sem precisar de agência ou copywriter externo." .

mesh:Skill_ia_marketing_copy_de_oferta_de_mentoria_e_consultoria a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-copy-de-oferta-de-mentoria-e-consultoria" ;
    rdfs:label "copy-de-oferta-de-mentoria-e-consultoria" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/copy-de-oferta-de-mentoria-e-consultoria/SKILL.md" ;
    mesh:skillDescription "Criar o copy completo de uma oferta de mentoria, consultoria ou programa de treinamento — da headline ao CTA — com linguagem que comunica o valor da transformação, não apenas o serviço, e que converte interessados em clientes sem parecer vendedor. Para consultores e coaches que sabem o que entregam mas não sabem como falar sobre isso de forma que as pessoas queiram comprar." .

mesh:Skill_ia_marketing_copy_de_oferta_direta a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-copy-de-oferta-direta" ;
    rdfs:label "copy-de-oferta-direta" ;
