    mesh:skillDescription "Criar um modelo de contrato de prestação de serviços completo e profissional — com cláusulas que protegem ambas as partes, linguagem clara e adaptável — para formalizar acordos comerciais." .

mesh:Skill_ia_finance_contrato_de_prestacao_de_servicos_corporativo a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-contrato-de-prestacao-de-servicos-corporativo" ;
    rdfs:label "contrato-de-prestacao-de-servicos-corporativo" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/contrato-de-prestacao-de-servicos-corporativo/SKILL.md" ;
    mesh:skillDescription "Gerar contratos de prestação de serviços completos e juridicamente robustos para clientes corporativos — com escopo detalhado, SLA, cláusulas de confidencialidade, responsabilidade e rescisão adequadas ao ambiente B2B — para que gestores e consultores consigam formalizar acordos com empresas de qualquer porte de forma profissional, sem precisar de advogado para cada novo contrato padrão." .

mesh:Skill_ia_finance_contrato_de_prestacao_de_servicos_freelancer a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-contrato-de-prestacao-de-servicos-freelancer" ;
    rdfs:label "contrato-de-prestacao-de-servicos-freelancer" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/contrato-de-prestacao-de-servicos-freelancer/SKILL.md" ;
    mesh:skillDescription "Gerar uma minuta de contrato de prestação de serviços completa para formalizar o trabalho freelancer — com escopo detalhado, prazo de entrega, valor e forma de pagamento, propriedade intelectual, sigilo, limitação de responsabilidade e condições de rescisão — que protege o freelancer juridicamente e deixa as expectativas do cliente documentadas desde o início. Evita os problemas clássicos de \"não era isso que eu queria\" ou cliente que não paga." .

mesh:Skill_ia_finance_contrato_de_prestacao_de_servicos_juridicos a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-contrato-de-prestacao-de-servicos-juridicos" ;
    rdfs:label "contrato-de-prestacao-de-servicos-juridicos" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/contrato-de-prestacao-de-servicos-juridicos/SKILL.md" ;
    mesh:skillDescription "Gerar minutas completas de contratos de prestação de serviços advocatícios — com cláusulas de escopo, honorários, obrigações das partes, sigilo, rescisão e foro — para que o advogado tenha uma base sólida para adaptar a cada cliente, reduzindo o tempo de elaboração e garantindo que nenhuma cláusula essencial seja esquecida." .

mesh:Skill_ia_finance_contrato_de_prestacao_de_servicos_saude_e_bem_estar a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-contrato-de-prestacao-de-servicos-saude-e-bem-estar" ;
    rdfs:label "contrato-de-prestacao-de-servicos-saude-e-bem-estar" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/contrato-de-prestacao-de-servicos-saude-e-bem-estar/SKILL.md" ;
    mesh:skillDescription "Gerar um contrato de prestação de serviços completo e claro para profissionais autônomos de saúde e bem-estar — com cláusulas específicas para o setor, linguagem que o cliente entende e proteções jurídicas básicas — para formalizar o vínculo profissional sem precisar de advogado para começar." .

mesh:Skill_ia_finance_contrato_de_servicos_de_marketing_digital a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-contrato-de-servicos-de-marketing-digital" ;
    rdfs:label "contrato-de-servicos-de-marketing-digital" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
