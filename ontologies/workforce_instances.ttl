    mesh:skillDescription "Gerar a estrutura e argumentação para apelações (quando a Fazenda perde em 1ª instância) e contrarrazões (quando o contribuinte apela de decisão favorável à Fazenda) em matéria tributária — com os fundamentos adequados ao caso concreto e à jurisprudência dos tribunais superiores — para que o Procurador produza recursos e contrarrazões com agilidade e precisão." .

mesh:Skill_ia_legal_risk_gerador_de_contestacao_em_execucao_fiscal a mesh:Skill ;
    mesh:skillIdentifier "ia-legal-risk-gerador-de-contestacao-em-execucao-fiscal" ;
    rdfs:label "gerador-de-contestacao-em-execucao-fiscal" ;
    mesh:belongsToDepartment mesh:Dept_legal-risk ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/juridico-advocacia/skills/gerador-de-contestacao-em-execucao-fiscal/SKILL.md" ;
    mesh:skillDescription "Gerar a estrutura e a argumentação para contestações, manifestações e contrarrazões em processos de execução fiscal — com os argumentos padrão da Fazenda Nacional adaptados ao caso concreto — para que o Procurador produza peças processuais com muito mais rapidez, partindo de uma estrutura sólida que só precisa de revisão e personalização." .

mesh:Skill_ia_legal_risk_gerador_de_contratos_e_clausulas_estrategicas a mesh:Skill ;
    mesh:skillIdentifier "ia-legal-risk-gerador-de-contratos-e-clausulas-estrategicas" ;
