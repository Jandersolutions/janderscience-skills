    mesh:skillDescription "Estruturar sessões de mentoria 1:1 com um framework claro — abertura, diagnóstico, direcionamento e compromisso de ação — para que cada encontro gere valor tangível e progresso mensurável." .

mesh:Skill_ia_people_framework_de_thought_leadership a mesh:Skill ;
    mesh:skillIdentifier "ia-people-framework-de-thought-leadership" ;
