    mesh:skillDescription "Analisar os processos operacionais da empresa para identificar oportunidades de automação com IA e ferramentas no-code — priorizando os processos que mais consomem tempo, são repetitivos e têm maior ROI de automação — com plano de implementação prático." .

mesh:Skill_ia_product_ceo_estrategico_de_ideias a mesh:Skill ;
    mesh:skillIdentifier "ia-product-ceo-estrategico-de-ideias" ;
    rdfs:label "ceo-estrategico-de-ideias" ;
    mesh:belongsToDepartment mesh:Dept_product ;
