    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/primeiros-passos-no-marketing-digital/SKILL.md" ;
    mesh:skillDescription "Começar no marketing digital de forma simples e prática." .

mesh:Skill_ia_marketing_processo_de_captacao_e_qualificacao_de_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-processo-de-captacao-e-qualificacao-de-clientes" ;
    rdfs:label "processo-de-captacao-e-qualificacao-de-clientes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/processo-de-captacao-e-qualificacao-de-clientes/SKILL.md" ;
    mesh:skillDescription "Criar um processo estruturado de captação e qualificação de clientes — com critérios de fit, roteiro de conversa de qualificação e sistema de pontuação — para que você pare de aceitar todo projeto que aparece e comece a escolher os clientes que valem o seu tempo e energia. Para um hub que já tem rotina cheia, cliente errado é mais caro do que não ter cliente." .

mesh:Skill_ia_marketing_proposta_comercial_completa_b2b a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-proposta-comercial-completa-b2b" ;
    rdfs:label "proposta-comercial-completa-b2b" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/proposta-comercial-completa-b2b/SKILL.md" ;
    mesh:skillDescription "Criar uma proposta comercial profissional e persuasiva para vendas B2B que vai além de listar serviços e preços — posiciona o problema, apresenta a solução com clareza, justifica o investimento e facilita a decisão de compra." .

mesh:Skill_ia_marketing_proposta_comercial_consultoria_financeira a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-proposta-comercial-consultoria-financeira" ;
    rdfs:label "proposta-comercial-consultoria-financeira" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/proposta-comercial-consultoria-financeira/SKILL.md" ;
    mesh:skillDescription "Criar uma proposta comercial de consultoria financeira completa e persuasiva — com diagnóstico do problema do cliente, escopo de trabalho detalhado, entregáveis, metodologia, investimento e garantias — posicionando o consultor como parceiro estratégico e não como \"mais um prestador de serviço\". A proposta é redigida em linguagem que o empresário entende e valoriza, aumentando a taxa de fechamento." .

mesh:Skill_ia_marketing_proposta_comercial_de_alto_impacto a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-proposta-comercial-de-alto-impacto" ;
    rdfs:label "proposta-comercial-de-alto-impacto" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/proposta-comercial-de-alto-impacto/SKILL.md" ;
    mesh:skillDescription "Criar propostas comerciais completas e persuasivas — com diagnóstico do problema do cliente, escopo claro, justificativa de valor e estrutura que guia o decisor para o sim — para que o gestor pare de enviar documentos genéricos e comece a fechar mais negócios com propostas que vendem antes mesmo da reunião de apresentação." .

mesh:Skill_ia_marketing_proposta_comercial_de_alto_valor_consultoria a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-proposta-comercial-de-alto-valor-consultoria" ;
    rdfs:label "proposta-comercial-de-alto-valor-consultoria" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/proposta-comercial-de-alto-valor-consultoria/SKILL.md" ;
    mesh:skillDescription "Criar uma proposta comercial completa para serviço de consultoria ou coaching de alto valor — estruturada para refletir o diagnóstico do cliente, apresentar a solução personalizada, justificar o investimento e eliminar objeções antes da reunião de apresentação — de forma que a proposta em si já demonstre o nível de profundidade e personalização que o cliente vai receber." .

mesh:Skill_ia_marketing_proposta_comercial_de_consultoria_e_coaching a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-proposta-comercial-de-consultoria-e-coaching" ;
    rdfs:label "proposta-comercial-de-consultoria-e-coaching" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/proposta-comercial-de-consultoria-e-coaching/SKILL.md" ;
    mesh:skillDescription "Criar uma proposta comercial profissional e persuasiva para serviços de consultoria, coaching ou mentoria — com estrutura que apresenta o diagnóstico do cliente, a solução proposta, a metodologia, os entregáveis, o investimento e os próximos passos. Uma proposta bem escrita substitui horas de negociação e posiciona o consultor como autoridade, não como fornecedor." .

mesh:Skill_ia_marketing_proposta_comercial_de_marketing_digital a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-proposta-comercial-de-marketing-digital" ;
    rdfs:label "proposta-comercial-de-marketing-digital" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
