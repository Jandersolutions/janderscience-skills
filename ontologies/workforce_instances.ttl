    mesh:skillDescription "Analisar casos e sugerir estratégias e próximos passos — com foco em ação." .

mesh:Skill_ia_legal_risk_analise_de_mandado_de_seguranca_tributario a mesh:Skill ;
    mesh:skillIdentifier "ia-legal-risk-analise-de-mandado-de-seguranca-tributario" ;
    rdfs:label "analise-de-mandado-de-seguranca-tributario" ;
