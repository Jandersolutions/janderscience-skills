mesh:Skill_ia_marketing_analise_competitiva_de_mercado a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-analise-competitiva-de-mercado" ;
    rdfs:label "analise-competitiva-de-mercado" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/analise-competitiva-de-mercado/SKILL.md" ;
    mesh:skillDescription "Conduzir uma análise competitiva estruturada de um mercado ou nicho — mapeando posicionamento dos concorrentes, ângulos de copy usados, lacunas de mercado e oportunidades de diferenciação — para que as campanhas criadas atacem os pontos cegos da concorrência em vez de brigar no mesmo território e pelo mesmo público." .

mesh:Skill_ia_marketing_analise_de_concorrencia_para_branding a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-analise-de-concorrencia-para-branding" ;
