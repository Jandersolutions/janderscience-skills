    mesh:skillDescription "Criar a pauta de uma reunião de equipe — semanal, de alinhamento ou de projeto — com estrutura clara, tempo definido para cada ponto e objetivo concreto por item, para que as reuniões terminem no horário, gerem decisões reais e não se transformem em sessões de relato sem saída prática." .

mesh:Skill_ia_operations_pauta_e_ata_de_reuniao_com_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-pauta-e-ata-de-reuniao-com-cliente" ;
    rdfs:label "pauta-e-ata-de-reuniao-com-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/pauta-e-ata-de-reuniao-com-cliente/SKILL.md" ;
    mesh:skillDescription "Criar pautas estruturadas e atas profissionais de reuniões com clientes de marketing digital — com os tópicos certos, espaço para decisões e próximos passos claros — para eliminar o \"eu achei que estava incluso\" e o \"não foi isso que combinamos\" que geram retrabalho, conflito e cliente insatisfeito." .

mesh:Skill_ia_operations_pesquisa_de_avatar_e_voz_do_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-pesquisa-de-avatar-e-voz-do-cliente" ;
    rdfs:label "pesquisa-de-avatar-e-voz-do-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
