    mesh:skillDescription "Criar um painel de visão geral simples e acionável — integrando negócio, vida pessoal e finanças — para dar clareza, reduzir desorganização e melhorar a tomada de decisão no dia a dia." .

mesh:Skill_ia_operations_pauta_de_reuniao_one_on_one_com_o_time a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-pauta-de-reuniao-one-on-one-com-o-time" ;
    rdfs:label "pauta-de-reuniao-one-on-one-com-o-time" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/pauta-de-reuniao-one-on-one-com-o-time/SKILL.md" ;
    mesh:skillDescription "Criar uma pauta completa e estruturada para reuniões individuais (1:1) com cada membro do time — com perguntas de alinhamento, desenvolvimento e engajamento — para que o gestor transforme essas reuniões em ferramenta real de liderança, e não em mais uma obrigação que não gera resultado." .

mesh:Skill_ia_operations_pauta_de_reuniao_semanal_eficiente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-pauta-de-reuniao-semanal-eficiente" ;
    rdfs:label "pauta-de-reuniao-semanal-eficiente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
