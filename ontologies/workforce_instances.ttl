    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/checklist-de-entrega-de-projeto-dev/SKILL.md" ;
    mesh:skillDescription "Criar um checklist completo e personalizado para a entrega de projetos de desenvolvimento — cobrindo qualidade de código, testes, documentação, deploy, comunicação com cliente e encerramento formal — para nunca mais entregar um projeto esquecendo algo importante, causar boa impressão no momento final e proteger você de chamados pós-entrega por coisas que poderiam ter sido verificadas antes." .

mesh:Skill_ia_operations_checklist_de_onboarding_de_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-checklist-de-onboarding-de-cliente" ;
    rdfs:label "checklist-de-onboarding-de-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/checklist-de-onboarding-de-cliente/SKILL.md" ;
    mesh:skillDescription "Gerar um checklist e roteiro completo de onboarding para novos clientes do escritório — cobrindo coleta de documentos, alinhamento de expectativas, assinatura de contrato e primeiras comunicações — para padronizar o processo de entrada de clientes, eliminar retrabalho, reduzir dúvidas repetitivas e criar uma experiência profissional desde o primeiro dia." .

mesh:Skill_ia_operations_checklist_de_onboarding_operacional a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-checklist-de-onboarding-operacional" ;
    rdfs:label "checklist-de-onboarding-operacional" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
