    mesh:skillDescription "Projetar a estrutura completa de um curso online — definindo módulos, aulas, objetivos de aprendizagem, atividades práticas e sequência lógica — para criar uma experiência educacional que transforma o aluno e maximiza engajamento e conclusão." .

mesh:Skill_ia_people_estrutura_de_palestra_framework_tedx a mesh:Skill ;
    mesh:skillIdentifier "ia-people-estrutura-de-palestra-framework-tedx" ;
