    mesh:skillDescription "Criar scripts completos de conversa para direct do Instagram ou WhatsApp — do primeiro contato ao agendamento da consulta — para que o advogado transforme seguidores interessados em clientes pagantes sem improvisar na hora, sem soar desesperado e sem perder leads por falta de acompanhamento estruturado." .

mesh:Skill_ia_marketing_script_de_discovery_call_consultiva a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-discovery-call-consultiva" ;
    rdfs:label "script-de-discovery-call-consultiva" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-discovery-call-consultiva/SKILL.md" ;
    mesh:skillDescription "Criar um script completo de discovery call (conversa de diagnóstico) que conduz o lead de forma natural — do problema que ele chegou com até a percepção de que trabalhar com a consultora é a decisão óbvia — sem pitch de vendas forçado, sem pressão e sem roteiro robótico, usando uma abordagem consultiva que gera confiança e fecha negócio de alto valor." .

mesh:Skill_ia_marketing_script_de_dm_para_captacao_de_clientes_no_instagram a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-dm-para-captacao-de-clientes-no-instagram" ;
    rdfs:label "script-de-dm-para-captacao-de-clientes-no-instagram" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-dm-para-captacao-de-clientes-no-instagram/SKILL.md" ;
    mesh:skillDescription "Criar scripts de mensagem direta (DM) para abordar potenciais clientes no Instagram — que chegaram via conteúdo, comentários ou enquetes — de forma natural, sem parecer vendedor, para converter audiência engajada em leads qualificados que agendam uma consulta ou conversa inicial." .

mesh:Skill_ia_marketing_script_de_follow_up_para_fechar_proposta a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-follow-up-para-fechar-proposta" ;
    rdfs:label "script-de-follow-up-para-fechar-proposta" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-follow-up-para-fechar-proposta/SKILL.md" ;
    mesh:skillDescription "Gerar mensagens de follow-up estratégicas e não invasivas para clientes que receberam sua proposta de branding mas não responderam — para parar de ficar esperando passivamente e começar a converter mais propostas enviadas em projetos fechados, sem parecer desesperado." .

mesh:Skill_ia_marketing_script_de_primeira_reuniao_com_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-primeira-reuniao-com-cliente" ;
    rdfs:label "script-de-primeira-reuniao-com-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-primeira-reuniao-com-cliente/SKILL.md" ;
    mesh:skillDescription "Gerar um roteiro estruturado para a primeira reunião com um cliente de branding — com as perguntas certas, a ordem certa e as transições certas — para conduzir a conversa com confiança, entender o que o cliente realmente precisa e já criar autoridade antes de enviar a proposta." .

mesh:Skill_ia_marketing_script_de_reuniao_de_descoberta_com_potencial_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-reuniao-de-descoberta-com-potencial-cliente" ;
    rdfs:label "script-de-reuniao-de-descoberta-com-potencial-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-reuniao-de-descoberta-com-potencial-cliente/SKILL.md" ;
    mesh:skillDescription "Gerar o roteiro completo de uma reunião de descoberta (discovery call) com potencial cliente de marketing — com perguntas estratégicas, transições naturais e técnica de qualificação — para conduzir reuniões que revelam o problema real do cliente, criam urgência e encaminham naturalmente para uma proposta que ele já quer receber." .

mesh:Skill_ia_marketing_script_de_reuniao_de_diagnostico_com_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-reuniao-de-diagnostico-com-cliente" ;
    rdfs:label "script-de-reuniao-de-diagnostico-com-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-reuniao-de-diagnostico-com-cliente/SKILL.md" ;
    mesh:skillDescription "Criar o roteiro completo para conduzir uma reunião de diagnóstico (discovery call) com um potencial cliente — com as perguntas certas para revelar a dor real, a urgência, o orçamento disponível e o que faz o cliente tomar decisão. Um bom diagnóstico fecha a venda antes de qualquer proposta ser enviada: o cliente sente que já foi entendido e a proposta vira confirmação, não surpresa." .

mesh:Skill_ia_marketing_script_de_reuniao_de_vendas_freelancer a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-reuniao-de-vendas-freelancer" ;
    rdfs:label "script-de-reuniao-de-vendas-freelancer" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-reuniao-de-vendas-freelancer/SKILL.md" ;
    mesh:skillDescription "Criar um script completo para a reunião de vendas do freelancer — da abertura ao fechamento — com perguntas de diagnóstico, narrativa de valor, tratamento das principais objeções e frases de fechamento que funcionam. Elimina o improviso nas reuniões mais importantes, aumenta a taxa de fechamento e faz o freelancer parecer mais experiente e confiante do que se sente na hora." .

mesh:Skill_ia_marketing_script_de_reuniao_de_vendas_para_agencia a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-reuniao-de-vendas-para-agencia" ;
    rdfs:label "script-de-reuniao-de-vendas-para-agencia" ;
