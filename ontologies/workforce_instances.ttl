    mesh:skillDescription "Criar roteiros completos de carrosséis educativos — com estrutura narrativa, texto por slide, hierarquia de informação e CTA — sobre temas de IA agêntica e educação, para que o creator produza conteúdo de alta qualidade e profundidade sem partir do zero toda vez, mantendo consistência e velocidade de publicação." .

mesh:Skill_ia_demand_generation_roteiro_de_reels_e_videos_curtos a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-roteiro-de-reels-e-videos-curtos" ;
    rdfs:label "roteiro-de-reels-e-videos-curtos" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
