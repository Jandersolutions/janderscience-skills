    mesh:skillDescription "Criar propostas criativas com direção estratégica clara — unindo conceito, narrativa e execução visual para acelerar decisões e reduzir tempo de pesquisa." .

mesh:Skill_ia_marketing_gerador_de_ideias_criativas_para_campanhas a mesh:Skill ;
