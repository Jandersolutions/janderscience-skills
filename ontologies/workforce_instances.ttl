mesh:Skill_ia_demand_generation_angulos_de_conteudo_nao_obvios_sobre_ia a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-angulos-de-conteudo-nao-obvios-sobre-ia" ;
