mesh:Skill_ia_marketing_criativo_de_anuncio_para_meta_ads a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-criativo-de-anuncio-para-meta-ads" ;
    rdfs:label "criativo-de-anuncio-para-meta-ads" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/criativo-de-anuncio-para-meta-ads/SKILL.md" ;
    mesh:skillDescription "Criar conceitos completos de criativos para anúncios no Meta Ads — com copy do anúncio, texto da imagem/vídeo, gancho para os primeiros segundos e direção de arte — para que você possa testar múltiplos ângulos de comunicação sem depender de agência, escalar o que funciona e parar de queimar dinheiro em anúncios que ninguém clica." .

mesh:Skill_ia_marketing_diagnostico_de_equipe_comercial a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-diagnostico-de-equipe-comercial" ;
    rdfs:label "diagnostico-de-equipe-comercial" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/diagnostico-de-equipe-comercial/SKILL.md" ;
    mesh:skillDescription "Fazer um diagnóstico completo da equipe comercial da imobiliária — identificando pontos de melhoria individuais e coletivos, analisando as taxas de conversão por etapa do funil e revelando os gargalos que impedem mais vendas — para criar um plano de ação concreto que o gestor pode implementar imediatamente, sem depender de achismos ou intuição." .

mesh:Skill_ia_marketing_diagnostico_de_funil_identificar_gargalos a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-diagnostico-de-funil-identificar-gargalos" ;
    rdfs:label "diagnostico-de-funil-identificar-gargalos" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/diagnostico-de-funil-identificar-gargalos/SKILL.md" ;
    mesh:skillDescription "Analisar um funil de vendas existente para identificar exatamente onde estão os gargalos que impedem o crescimento — calculando as taxas de conversão entre cada etapa, comparando com benchmarks e priorizando as correções de maior impacto." .

mesh:Skill_ia_marketing_diagnostico_de_identidade_visual_existente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-diagnostico-de-identidade-visual-existente" ;
    rdfs:label "diagnostico-de-identidade-visual-existente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/diagnostico-de-identidade-visual-existente/SKILL.md" ;
    mesh:skillDescription "Auditar a identidade visual atual de um cliente e gerar um relatório profissional com os problemas encontrados, o impacto no negócio e as recomendações de melhoria — para usar como ferramenta de venda de um projeto de rebranding ou como entregável de consultoria, transformando o diagnóstico em receita." .

mesh:Skill_ia_marketing_diagnostico_de_metricas_facebook_ads a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-diagnostico-de-metricas-facebook-ads" ;
    rdfs:label "diagnostico-de-metricas-facebook-ads" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/diagnostico-de-metricas-facebook-ads/SKILL.md" ;
    mesh:skillDescription "Transformar os números brutos do Gerenciador de Anúncios em diagnóstico claro e acionável — identificando o que está funcionando, o que está drenando orçamento e quais ajustes fazer primeiro — para que o gestor tome decisões de otimização com base em lógica, não em intuição." .

mesh:Skill_ia_marketing_e_mail_de_recuperacao_de_carrinho_abandonado a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-e-mail-de-recuperacao-de-carrinho-abandonado" ;
    rdfs:label "e-mail-de-recuperacao-de-carrinho-abandonado" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/e-mail-de-recuperacao-de-carrinho-abandonado/SKILL.md" ;
    mesh:skillDescription "Criar uma sequência de 3 e-mails estratégicos para recuperar clientes que abandonaram o carrinho — cada e-mail com abordagem diferente: lembrança, argumento e urgência. E-commerce de cosméticos perde em média 70% das compras por abandono de carrinho; essa sequência recupera parte significativa desse faturamento de forma automática." .

mesh:Skill_ia_marketing_e_mail_de_vendas_para_lista a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-e-mail-de-vendas-para-lista" ;
    rdfs:label "e-mail-de-vendas-para-lista" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/e-mail-de-vendas-para-lista/SKILL.md" ;
    mesh:skillDescription "Criar um e-mail de vendas completo — com assunto que abre, abertura que prende, construção de contexto, apresentação da oferta, quebra de objeções e CTA que leva ao clique — para converter leads da lista em compradores. E-mail marketing ainda tem o melhor ROI de todos os canais digitais, e saber escrever um e-mail de vendas é uma das habilidades mais valiosas do empreendedor digital." .

mesh:Skill_ia_marketing_e_mail_marketing_para_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-e-mail-marketing-para-e-commerce" ;
    rdfs:label "e-mail-marketing-para-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/e-mail-marketing-para-e-commerce/SKILL.md" ;
    mesh:skillDescription "Criar as sequências de e-mail essenciais para e-commerce — boas-vindas, recuperação de carrinho abandonado e pós-compra — para gerar receita a partir da base de contatos sem depender exclusivamente de ads pagos. E-mail marketing bem feito representa entre 20% e 40% da receita de e-commerces maduros com custo próximo de zero depois de configurado." .

mesh:Skill_ia_marketing_e_mail_marketing_para_reativacao_de_pacientes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-e-mail-marketing-para-reativacao-de-pacientes" ;
    rdfs:label "e-mail-marketing-para-reativacao-de-pacientes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/e-mail-marketing-para-reativacao-de-pacientes/SKILL.md" ;
    mesh:skillDescription "Criar uma sequência de e-mails ou mensagens WhatsApp para reativar pacientes que há mais de 6 meses não retornam à clínica — com mensagens personalizadas por serviço (audiologia, vacinas, laboratório) que oferecem motivo real para retornar. A base de pacientes existentes é o ativo mais subutilizado de qualquer clínica: custa 5 vezes menos reativar um paciente antigo do que captar um novo." .

mesh:Skill_ia_marketing_email_de_nutricao_e_venda a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-email-de-nutricao-e-venda" ;
    rdfs:label "email-de-nutricao-e-venda" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/email-de-nutricao-e-venda/SKILL.md" ;
    mesh:skillDescription "Criar emails de nutrição personalizados que constroem relação com a lista, entregam valor real e conduzem o leitor naturalmente para uma oferta — sem parecer spam, sem ser agressivo e sem precisar ser um copywriter experiente — para que o empreendedor solo transforme sua lista de emails em um ativo de venda que trabalha de forma automática." .

mesh:Skill_ia_marketing_email_de_nutricao_para_lead_juridico a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-email-de-nutricao-para-lead-juridico" ;
    rdfs:label "email-de-nutricao-para-lead-juridico" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/email-de-nutricao-para-lead-juridico/SKILL.md" ;
    mesh:skillDescription "Criar sequências completas de e-mails de nutrição para leads que demonstraram interesse em serviços jurídicos — mas ainda não contrataram — com progressão de valor, construção de autoridade e convites sutis à ação, para que o advogado mantenha presença na mente do lead até o momento em que ele estiver pronto para contratar." .

mesh:Skill_ia_marketing_email_de_prospeccao_b2b a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-email-de-prospeccao-b2b" ;
    rdfs:label "email-de-prospeccao-b2b" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/email-de-prospeccao-b2b/SKILL.md" ;
    mesh:skillDescription "Criar emails de prospecção fria — ou cadências de email — para abrir portas em construtoras, prefeituras, empresas industriais e condomínios, usando abordagem consultiva que desperta interesse sem parecer spam, para que a empresa nunca dependa só de indicações e tenha um canal de captação ativa que traz oportunidades novas toda semana, mesmo sem equipe comercial dedicada." .

mesh:Skill_ia_marketing_email_de_prospeccao_consultor_financeiro a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-email-de-prospeccao-consultor-financeiro" ;
    rdfs:label "email-de-prospeccao-consultor-financeiro" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/email-de-prospeccao-consultor-financeiro/SKILL.md" ;
    mesh:skillDescription "Criar uma sequência de 3 emails de prospecção fria para captar clientes para consultoria financeira — do primeiro contato ao follow-up de fechamento — com subject lines de alta abertura, corpo persuasivo baseado em dor do segmento e CTA claro. Permite iniciar conversas comerciais com empresários que nunca ouviram falar de você, sem soar como spam." .

mesh:Skill_ia_marketing_email_de_prospeccao_consultoria_de_ia a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-email-de-prospeccao-consultoria-de-ia" ;
    rdfs:label "email-de-prospeccao-consultoria-de-ia" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/email-de-prospeccao-consultoria-de-ia/SKILL.md" ;
    mesh:skillDescription "Criar uma sequência de 3 emails de prospecção fria para captar clientes para consultoria de implementação de IA — com subject lines que geram abertura, corpo focado em resultado concreto do setor do prospecto e CTA que leva a uma conversa, não a uma venda imediata. Permite prospectar empresas ativamente sem depender de indicações, com mensagens que se diferenciam por falar de problemas reais do setor." .

mesh:Skill_ia_marketing_email_de_prospeccao_freelancer_de_contratos a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-email-de-prospeccao-freelancer-de-contratos" ;
    rdfs:label "email-de-prospeccao-freelancer-de-contratos" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/email-de-prospeccao-freelancer-de-contratos/SKILL.md" ;
    mesh:skillDescription "Criar uma sequência de 3 emails de prospecção fria para captar clientes para serviços de contratos e consultoria jurídica — com subject lines de alta abertura, corpo focado na dor específica do segmento prospectado e CTA claro — que geram respostas e reuniões sem soar como spam. Permite escalar a captação além das indicações e alcançar novos clientes de forma sistemática." .

mesh:Skill_ia_marketing_email_de_retencao_e_upsell_de_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-email-de-retencao-e-upsell-de-cliente" ;
    rdfs:label "email-de-retencao-e-upsell-de-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/email-de-retencao-e-upsell-de-cliente/SKILL.md" ;
    mesh:skillDescription "Criar emails e mensagens estratégicas para manter clientes da agência engajados, demonstrar valor entre relatórios e abrir conversas de upsell de forma natural — para que o churn seja reduzido, o ticket médio por cliente aumente ao longo do tempo e o relacionamento vá além de \"mandaram o relatório mensal\"." .

mesh:Skill_ia_marketing_estrategia_de_conteudo_de_90_dias a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategia-de-conteudo-de-90-dias" ;
    rdfs:label "estrategia-de-conteudo-de-90-dias" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategia-de-conteudo-de-90-dias/SKILL.md" ;
    mesh:skillDescription "Criar uma estratégia de conteúdo completa para os próximos 90 dias — dividida em três fases com objetivos distintos: construção de audiência, aprofundamento de autoridade e conversão. Resolve o problema da inconsistência: em vez de criar conteúdo aleatório todo dia, você tem um plano com propósito claro para cada fase. Ao final de 90 dias com essa estratégia, você tem audiência maior, mais reconhecido como autoridade e leads chegando de forma orgânica." .

mesh:Skill_ia_marketing_estrategia_de_escala_de_anuncios a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategia-de-escala-de-anuncios" ;
    rdfs:label "estrategia-de-escala-de-anuncios" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategia-de-escala-de-anuncios/SKILL.md" ;
    mesh:skillDescription "Criar um framework completo para escalar campanhas de Facebook Ads e TikTok Ads lucrativas — com critérios claros de quando escalar, como escalar (vertical vs horizontal), quanto subir por vez e como monitorar para não matar a performance ao aumentar o budget. Escalar sem método é a forma mais rápida de transformar uma campanha lucrativa em prejuízo." .

mesh:Skill_ia_marketing_estrategia_de_marketing_digital_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategia-de-marketing-digital-para-cliente" ;
    rdfs:label "estrategia-de-marketing-digital-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategia-de-marketing-digital-para-cliente/SKILL.md" ;
    mesh:skillDescription "Criar um plano estratégico completo de marketing digital para um cliente — com diagnóstico, canais recomendados, metas, ações prioritárias e cronograma — para entregar um documento de alto valor que justifica a consultoria estratégica, diferencia seu trabalho de gestores de tráfego comuns e serve como guia de execução para os próximos 3-6 meses." .

mesh:Skill_ia_marketing_estrategia_de_recompra_e_fidelizacao_de_clientes_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategia-de-recompra-e-fidelizacao-de-clientes-e-commerce" ;
    rdfs:label "estrategia-de-recompra-e-fidelizacao-de-clientes-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategia-de-recompra-e-fidelizacao-de-clientes-e-commerce/SKILL.md" ;
    mesh:skillDescription "Criar uma estratégia completa de recompra e fidelização de clientes para e-commerce — com sequência pós-compra, ofertas para a segunda compra, comunicação de relacionamento e programa de indicação — para aumentar o valor vitalício de cada cliente sem precisar gastar mais em tráfego para adquirir novos." .

mesh:Skill_ia_marketing_estrategia_de_retargeting a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategia-de-retargeting" ;
    rdfs:label "estrategia-de-retargeting" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategia-de-retargeting/SKILL.md" ;
    mesh:skillDescription "Criar uma estratégia completa de retargeting para e-commerce — com audiências segmentadas por estágio do funil (visitantes, view content, add to cart, checkout abandonado), criativos específicos para cada estágio e regras de exclusão — para converter o tráfego que já chegou na loja mas não comprou. Retargeting bem feito tipicamente gera ROAS 3 a 6x maior do que campanhas de aquisição, com custo por clique muito menor." .

mesh:Skill_ia_marketing_estrategia_de_segmentacao_de_publico a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategia-de-segmentacao-de-publico" ;
    rdfs:label "estrategia-de-segmentacao-de-publico" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategia-de-segmentacao-de-publico/SKILL.md" ;
    mesh:skillDescription "Criar uma estratégia completa de segmentação de público para campanhas de anúncios pagos — definindo públicos por temperatura, camadas de funil, lógica de exclusão e estratégia de lookalike — para maximizar a relevância dos anúncios e reduzir o desperdício de budget com pessoas que não têm perfil de compra. Funciona como um mapa de audiências que organiza quem ver o quê e quando." .

mesh:Skill_ia_marketing_estrategia_de_trafego_pago_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategia-de-trafego-pago-para-cliente" ;
    rdfs:label "estrategia-de-trafego-pago-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategia-de-trafego-pago-para-cliente/SKILL.md" ;
    mesh:skillDescription "Montar a estratégia completa de tráfego pago para um cliente — com estrutura de conta, divisão de campanhas por temperatura de funil, direcionamento de criativos, orçamento e KPIs — para entrar em qualquer briefing com um plano de alto nível que demonstra autoridade, organiza a execução e reduz o risco de queimar verba sem resultado." .

mesh:Skill_ia_marketing_estrategia_de_tripwire_oferta_de_entrada a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategia-de-tripwire-oferta-de-entrada" ;
    rdfs:label "estrategia-de-tripwire-oferta-de-entrada" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategia-de-tripwire-oferta-de-entrada/SKILL.md" ;
    mesh:skillDescription "Criar a estratégia completa de uma oferta tripwire — um produto de baixo custo (R$7-R$47) que transforma leads em compradores, cobre o custo de aquisição e aquece o público para a oferta principal." .

mesh:Skill_ia_marketing_estrategia_de_upsell_e_retencao_de_alunas a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategia-de-upsell-e-retencao-de-alunas" ;
    rdfs:label "estrategia-de-upsell-e-retencao-de-alunas" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategia-de-upsell-e-retencao-de-alunas/SKILL.md" ;
    mesh:skillDescription "Criar uma estratégia completa de upsell e retenção de alunas — identificando os melhores momentos para oferecer mais, como criar continuidade natural no produto e como transformar alunas satisfeitas em clientes recorrentes e promotoras ativas. Aumentar o LTV (valor do cliente ao longo do tempo) é a forma mais rápida de crescer faturamento sem precisar captar novos clientes do zero." .

mesh:Skill_ia_marketing_estrategista_de_precificacao_para_advogado_freelancer a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrategista-de-precificacao-para-advogado-freelancer" ;
    rdfs:label "estrategista-de-precificacao-para-advogado-freelancer" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrategista-de-precificacao-para-advogado-freelancer/SKILL.md" ;
    mesh:skillDescription "Criar uma estratégia de precificação completa para os serviços jurídicos do advogado freelancer — com modelos de honorários por tipo de serviço, ancoragem de valor, técnicas de apresentação de preço e quando e como aumentar — para que o profissional pare de cobrar abaixo do mercado por insegurança e passe a precificar com clareza, aumentando faturamento sem necessariamente aumentar volume de clientes." .

mesh:Skill_ia_marketing_estrutura_de_campanha_facebookinstagram_ads a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrutura-de-campanha-facebookinstagram-ads" ;
    rdfs:label "estrutura-de-campanha-facebookinstagram-ads" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrutura-de-campanha-facebookinstagram-ads/SKILL.md" ;
    mesh:skillDescription "Planejar a estrutura completa de uma campanha de Facebook e Instagram Ads — desde a definição de objetivo e público até os criativos e métricas — seguindo as melhores práticas de mídia paga para maximizar o ROAS." .

mesh:Skill_ia_marketing_estrutura_de_campanhas_tiktok_ads a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrutura-de-campanhas-tiktok-ads" ;
    rdfs:label "estrutura-de-campanhas-tiktok-ads" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrutura-de-campanhas-tiktok-ads/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura completa de campanhas de TikTok Ads para e-commerce de produto físico — com arquitetura de campanha/grupo de anúncio/criativo, configuração de público, estratégia de lance, pixel events e organização para testes — para maximizar a eficiência do gasto e o aprendizado do algoritmo. TikTok Ads tem lógica diferente do Meta Ads, e estrutura errada custa caro." .

mesh:Skill_ia_marketing_estrutura_de_funil_simples_para_servicos a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrutura-de-funil-simples-para-servicos" ;
    rdfs:label "estrutura-de-funil-simples-para-servicos" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrutura-de-funil-simples-para-servicos/SKILL.md" ;
    mesh:skillDescription "Criar um funil simples e funcional — organizando aquisição, relacionamento e conversão de clientes." .

mesh:Skill_ia_marketing_estrutura_de_oferta_irresistivel a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-estrutura-de-oferta-irresistivel" ;
    rdfs:label "estrutura-de-oferta-irresistivel" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/estrutura-de-oferta-irresistivel/SKILL.md" ;
    mesh:skillDescription "Estruturar uma oferta completa e persuasiva — definindo o que inclui, como apresentar o valor percebido, quais bônus adicionar, qual o preço ideal e como comunicar a transformação — para que o empreendedor solo pare de vender apenas o produto e comece a vender o resultado, transformando ofertas comuns em propostas que fazem o cliente sentir que seria burrice não comprar." .

mesh:Skill_ia_marketing_follow_up_de_propostas_enviadas a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-follow-up-de-propostas-enviadas" ;
    rdfs:label "follow-up-de-propostas-enviadas" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/follow-up-de-propostas-enviadas/SKILL.md" ;
    mesh:skillDescription "Criar uma cadência de follow-up para propostas de projeto enviadas — com mensagens prontas por canal, timing ideal de cada contato e critérios para saber quando insistir vs. quando soltar — para parar de enviar proposta e ficar esperando em silêncio, aumentar a taxa de fechamento com os leads que você já tem e nunca mais perder um projeto por falta de acompanhamento." .

mesh:Skill_ia_marketing_follow_up_de_vendas_por_e_mail a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-follow-up-de-vendas-por-e-mail" ;
    rdfs:label "follow-up-de-vendas-por-e-mail" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/follow-up-de-vendas-por-e-mail/SKILL.md" ;
    mesh:skillDescription "Criar uma sequência de 4 e-mails de follow-up para leads que receberam proposta e sumiram — cada e-mail com abordagem diferente e crescente, sem pressionar nem mendigar resposta. A maioria das vendas de serviços de consultoria acontece no 4º ou 5º contato; a maioria dos consultores desiste no 2º. Essa sequência mantém o contato vivo com dignidade e inteligência." .

mesh:Skill_ia_marketing_follow_up_estrategico_para_fechar_projetos_em_negociacao a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-follow-up-estrategico-para-fechar-projetos-em-negociacao" ;
    rdfs:label "follow-up-estrategico-para-fechar-projetos-em-negociacao" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/follow-up-estrategico-para-fechar-projetos-em-negociacao/SKILL.md" ;
    mesh:skillDescription "Criar sequências de follow-up estratégico para prospects que receberam proposta de branding mas não responderam — retomando o contato com ângulos diferentes, agregando valor a cada mensagem e aumentando a taxa de fechamento — sem que o designer pareça desesperado, insistente ou sem projeto." .

mesh:Skill_ia_marketing_framework_de_criativo_para_anuncios a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-framework-de-criativo-para-anuncios" ;
    rdfs:label "framework-de-criativo-para-anuncios" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/framework-de-criativo-para-anuncios/SKILL.md" ;
    mesh:skillDescription "Criar o briefing estratégico completo de criativos para campanhas de tráfego pago — com conceito criativo, roteiro de vídeo ou direção de estático, copy de sobreposição e justificativa do porquê cada elemento funciona — para que a produção de criativos saia do \"vamos fazer uma arte bonita\" e passe a ser guiada por hipóteses de performance com base no comportamento do público." .

mesh:Skill_ia_marketing_framework_de_funil_de_vendas_completo a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-framework-de-funil-de-vendas-completo" ;
    rdfs:label "framework-de-funil-de-vendas-completo" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/framework-de-funil-de-vendas-completo/SKILL.md" ;
    mesh:skillDescription "Projetar o funil de vendas completo para um produto ou serviço — com cada etapa do customer journey, gatilhos de conversão, pontos de abandono e estratégia para cada fase — para que o cliente da agência pare de depender só de anúncios diretos para venda e tenha um sistema de aquisição escalável que converte em diferentes temperaturas de público." .

mesh:Skill_ia_marketing_framework_de_gestao_de_objecoes_em_vendas_de_servico a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-framework-de-gestao-de-objecoes-em-vendas-de-servico" ;
    rdfs:label "framework-de-gestao-de-objecoes-em-vendas-de-servico" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/framework-de-gestao-de-objecoes-em-vendas-de-servico/SKILL.md" ;
    mesh:skillDescription "Mapear as objeções mais comuns na venda de serviços de consultoria e coaching, entender a causa raiz de cada uma e criar respostas que avançam a decisão de forma consultiva — sem pressão, sem argumento de venda forçado e sem jamais fazer o lead se sentir manipulado — para que a consultora converta mais conversas em clientes sem precisar \"forçar\" nada." .

mesh:Skill_ia_marketing_framework_de_planejamento_de_marketing_do_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-framework-de-planejamento-de-marketing-do-cliente" ;
    rdfs:label "framework-de-planejamento-de-marketing-do-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/framework-de-planejamento-de-marketing-do-cliente/SKILL.md" ;
    mesh:skillDescription "Criar o plano de marketing trimestral completo para um cliente de consultoria — com análise de situação, metas definidas, estratégias por canal, cronograma de ações e KPIs de acompanhamento. É o entregável de alto valor que diferencia consultores estratégicos de executores: você não só implementa, você pensa e planeja. Com esse framework, cada cliente recebe um plano sob medida em vez de receitas genéricas." .

mesh:Skill_ia_marketing_framework_de_posicionamento_como_especialista a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-framework-de-posicionamento-como-especialista" ;
    rdfs:label "framework-de-posicionamento-como-especialista" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/framework-de-posicionamento-como-especialista/SKILL.md" ;
    mesh:skillDescription "Construir o posicionamento estratégico completo de uma consultora ou especialista em marketing e vendas — definindo nicho, avatar ideal, promessa única, ponto de vista diferenciado e mensagem central — para parar de ser \"mais uma\" no mercado e se tornar a referência óbvia para um público específico." .

mesh:Skill_ia_marketing_framework_de_teste_de_criativos a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-framework-de-teste-de-criativos" ;
    rdfs:label "framework-de-teste-de-criativos" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/framework-de-teste-de-criativos/SKILL.md" ;
    mesh:skillDescription "Criar um sistema completo e metodológico de teste de criativos para Facebook Ads e TikTok Ads — definindo o que testar, em que ordem, com qual budget, por quanto tempo e como interpretar os resultados — para sair do ciclo de \"teste sem sistema\" e construir aprendizado acumulado sobre o que funciona para o seu produto e público específico. Criativos testados com método são vantagem competitiva sustentável." .

mesh:Skill_ia_marketing_framework_de_upsell_e_expansao_de_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-framework-de-upsell-e-expansao-de-clientes" ;
    rdfs:label "framework-de-upsell-e-expansao-de-clientes" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/framework-de-upsell-e-expansao-de-clientes/SKILL.md" ;
    mesh:skillDescription "Criar uma estratégia de expansão de receita com clientes existentes — identificando o momento certo para propor mais serviço, como estruturar o upsell de forma consultiva (não como venda forçada), como fazer cross-sell de serviços complementares e como renovar contratos aumentando o ticket — para uma consultora que quer crescer o faturamento sem precisar de novos clientes o tempo todo." .

mesh:Skill_ia_marketing_funil_de_conteudo_para_advocacia a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-funil-de-conteudo-para-advocacia" ;
    rdfs:label "funil-de-conteudo-para-advocacia" ;
