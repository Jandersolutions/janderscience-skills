    mesh:skillDescription "Criar um processo completo de avaliação de desempenho para um cargo ou departamento — com critérios claros, formulário de avaliação, escala de pontuação e roteiro para a conversa de feedback — para que gestores avaliem o time com consistência, colaboradores saibam exatamente o que é esperado deles e o diretor tenha dados para decisões de promoção, bonificação ou desligamento." .

mesh:Skill_ia_operations_avaliacao_de_desempenho_operacional a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-avaliacao-de-desempenho-operacional" ;
    rdfs:label "avaliacao-de-desempenho-operacional" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/avaliacao-de-desempenho-operacional/SKILL.md" ;
    mesh:skillDescription "Criar um formulário completo de avaliação de desempenho para colaboradores operacionais — com critérios técnicos e comportamentais, escala de avaliação, espaço para autoavaliação, resultado consolidado e plano de ação vinculado — para que a avaliação seja um processo estruturado, justo e útil para o desenvolvimento da equipe, não apenas uma burocracia semestral sem efeito prático." .

mesh:Skill_ia_operations_avaliacao_e_selecao_de_fornecedores a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-avaliacao-e-selecao-de-fornecedores" ;
    rdfs:label "avaliacao-e-selecao-de-fornecedores" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/avaliacao-e-selecao-de-fornecedores/SKILL.md" ;
    mesh:skillDescription "Estruturar um processo de avaliação e seleção de fornecedores — de equipamentos de segurança, importação ou desenvolvimento — com critérios técnicos, comerciais e operacionais ponderados, para que a empresa tome decisões de fornecimento baseadas em análise objetiva e não apenas em preço ou relacionamento, reduzindo risco de problemas de qualidade, prazo e suporte pós-venda que comprometem a entrega de projetos." .

mesh:Skill_ia_operations_bot_de_atendimento_e_vendas_para_whatsapp a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-bot-de-atendimento-e-vendas-para-whatsapp" ;
    rdfs:label "bot-de-atendimento-e-vendas-para-whatsapp" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/bot-de-atendimento-e-vendas-para-whatsapp/SKILL.md" ;
    mesh:skillDescription "Criar o script completo de um bot de atendimento e vendas para WhatsApp — com fluxo de qualificação, respostas automáticas para as dúvidas mais comuns, apresentação de produto e fechamento de venda — para que o empreendedor solo pare de responder as mesmas perguntas manualmente e tenha um sistema que atende e vende mesmo quando está ocupado." .

mesh:Skill_ia_operations_briefing_completo_para_parceiros_e_fornecedores a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-briefing-completo-para-parceiros-e-fornecedores" ;
    rdfs:label "briefing-completo-para-parceiros-e-fornecedores" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/briefing-completo-para-parceiros-e-fornecedores/SKILL.md" ;
    mesh:skillDescription "Criar briefings completos, claros e padronizados para repassar demandas a parceiros e fornecedores — designers, trafegantes, redatores, produtores, advogados — de forma que a entrega chegue certa na primeira vez, sem idas e vindas de revisão e sem perda de tempo de ambos os lados. Para quem funciona como hub, o briefing é o principal instrumento de trabalho e define 80% da qualidade da entrega." .

mesh:Skill_ia_operations_briefing_de_delegacao_de_tarefas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-briefing-de-delegacao-de-tarefas" ;
    rdfs:label "briefing-de-delegacao-de-tarefas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/briefing-de-delegacao-de-tarefas/SKILL.md" ;
    mesh:skillDescription "Transformar uma ideia ou demanda na cabeça do gestor em um briefing estruturado que o colaborador consegue executar sem precisar voltar para tirar dúvidas — com contexto, critérios de sucesso, prazo e autonomia bem definidos — eliminando o retrabalho que acontece quando a delegação é feita de forma vaga ou verbal." .

mesh:Skill_ia_operations_briefing_tecnico_de_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-briefing-tecnico-de-cliente" ;
    rdfs:label "briefing-tecnico-de-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/briefing-tecnico-de-cliente/SKILL.md" ;
    mesh:skillDescription "Conduzir um levantamento completo de requisitos técnicos, comerciais e estratégicos antes de montar qualquer proposta — com as perguntas certas para o perfil técnico e para o decisor — para que o gestor nunca mais entregue uma proposta sem entender o problema real do cliente, evite retrabalho por escopo mal definido e demonstre profissionalismo consultivo que já diferencia a empresa antes de apresentar preço." .

mesh:Skill_ia_operations_briefing_tecnico_de_projeto a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-briefing-tecnico-de-projeto" ;
    rdfs:label "briefing-tecnico-de-projeto" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/briefing-tecnico-de-projeto/SKILL.md" ;
    mesh:skillDescription "Criar um questionário de briefing técnico completo e personalizado para levantar todos os requisitos de um projeto de desenvolvimento — funcionalidades, integrações, design, prazo, orçamento e expectativas do cliente — para entrar em qualquer projeto com clareza total, evitar surpresas no meio do caminho e ter a base para uma proposta precisa e um escopo fechado que protege o seu tempo." .

mesh:Skill_ia_operations_checklist_de_entrega_de_projeto_dev a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-checklist-de-entrega-de-projeto-dev" ;
