    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/carreira/skills/branding-e-narrativa-de-marca/SKILL.md" ;
    mesh:skillDescription "Criar a identidade de marca completa — com posicionamento, narrativa central, tom de voz, pilares de conteúdo e linha editorial — para uma perfumaria de nicho no TikTok e Instagram. Marca com narrativa forte converte melhor do que marca sem identidade porque o cliente compra o que a marca representa, não só o produto. No mercado de perfumaria, a narrativa é o produto." .

mesh:Skill_ia_people_construtor_de_portfolio_e_autoridade_juridica a mesh:Skill ;
    mesh:skillIdentifier "ia-people-construtor-de-portfolio-e-autoridade-juridica" ;
