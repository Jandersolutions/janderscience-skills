    mesh:skillDescription "Criar posts de bastidores autênticos que humanizam a marca, geram conexão emocional e aumentam o engajamento ao mostrar o \"por trás das câmeras\" do negócio." .

mesh:Skill_ia_demand_generation_post_de_depoimento_case_de_sucesso a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-post-de-depoimento-case-de-sucesso" ;
