    mesh:skillDescription "Estruturar uma palestra impactante usando o framework TEDx — com abertura memorável, narrativa envolvente, ideia central poderosa e fechamento que inspira ação — para apresentações que emocionam, ensinam e são lembradas." .

mesh:Skill_ia_people_estrutura_de_programa_de_mentoria_ou_consultoria a mesh:Skill ;
    mesh:skillIdentifier "ia-people-estrutura-de-programa-de-mentoria-ou-consultoria" ;
    rdfs:label "estrutura-de-programa-de-mentoria-ou-consultoria" ;
