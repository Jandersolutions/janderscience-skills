mesh:Skill_ia_operations_sistema_de_interconexao_documental a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-sistema-de-interconexao-documental" ;
    rdfs:label "sistema-de-interconexao-documental" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
