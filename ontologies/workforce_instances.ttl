    mesh:skillDescription "Criar contratos simples, claros e funcionais — garantindo segurança nas relações com clientes." .

mesh:Skill_ia_finance_controlador_de_custos_e_orcamento_operacional a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-controlador-de-custos-e-orcamento-operacional" ;
