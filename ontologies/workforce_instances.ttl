    mesh:skillDescription "Definir o branding completo do escritório contábil — posicionamento, tom de voz, proposta de valor única, nomenclatura dos serviços e diretrizes de comunicação — para que toda a presença digital (site, Instagram, LinkedIn, WhatsApp Business) transmita a mesma mensagem com profissionalismo e atraia o cliente certo, diferenciando o escritório dos concorrentes que parecem iguais." .

mesh:Skill_ia_people_branding_e_narrativa_de_marca a mesh:Skill ;
    mesh:skillIdentifier "ia-people-branding-e-narrativa-de-marca" ;
