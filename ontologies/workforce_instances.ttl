    mesh:skillDescription "Criar um plano estratégico simples e executável para os próximos 90 dias — com foco em prioridades reais e ações práticas." .

mesh:Skill_ia_operations_planejamento_estrategico_de_90_dias_para_empreendedor_solo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-planejamento-estrategico-de-90-dias-para-empreendedor-solo" ;
