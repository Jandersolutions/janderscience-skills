    mesh:skillDescription "Garantir que a operação esteja organizada e sob controle — com um checklist simples e recorrente." .

mesh:Skill_ia_operations_checklist_de_qualidade_antes_da_entrega a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-checklist-de-qualidade-antes-da-entrega" ;
