mesh:Skill_ia_operations_analise_de_produto_de_fornecedor_viabilidade_e_estrategia a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-analise-de-produto-de-fornecedor-viabilidade-e-estrategia" ;
    rdfs:label "analise-de-produto-de-fornecedor-viabilidade-e-estrategia" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/analise-de-produto-de-fornecedor-viabilidade-e-estrategia/SKILL.md" ;
    mesh:skillDescription "Avaliar a viabilidade comercial de um produto de fornecedor antes de comprar estoque ou fazer dropshipping — analisando margem real, volume de mercado, nível de concorrência, posicionamento possível e estratégia de entrada — para tomar decisões de compra com base em dados e não em feeling." .

mesh:Skill_ia_operations_analise_de_viabilidade_de_projeto a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-analise-de-viabilidade-de-projeto" ;
    rdfs:label "analise-de-viabilidade-de-projeto" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/analise-de-viabilidade-de-projeto/SKILL.md" ;
    mesh:skillDescription "Avaliar rapidamente se uma oportunidade de projeto vale o investimento de tempo e recurso para elaborar proposta — usando um framework de qualificação que analisa potencial financeiro, viabilidade técnica, alinhamento estratégico e probabilidade de fechamento — para que o gestor pare de desperdiçar horas em propostas de baixa probabilidade e foque energia nos projetos certos, aumentando a taxa de conversão sem aumentar o esforço comercial." .

mesh:Skill_ia_operations_analise_e_sintese_de_documentos_complexos a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-analise-e-sintese-de-documentos-complexos" ;
    rdfs:label "analise-e-sintese-de-documentos-complexos" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/analise-e-sintese-de-documentos-complexos/SKILL.md" ;
    mesh:skillDescription "Analisar documentos extensos e complexos — contratos, relatórios, regulamentos, pareceres jurídicos, editais — extraindo com precisão os pontos críticos, riscos, obrigações e insights acionáveis em formato executivo — para que o gestor tome decisões com base nos pontos que realmente importam sem precisar ler 80 páginas do zero." .

mesh:Skill_ia_operations_apresentacao_de_resultados_para_diretoria a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-apresentacao-de-resultados-para-diretoria" ;
    rdfs:label "apresentacao-de-resultados-para-diretoria" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/apresentacao-de-resultados-para-diretoria/SKILL.md" ;
    mesh:skillDescription "Transformar dados, números e atualizações de área em uma apresentação executiva clara, objetiva e bem estruturada — que a diretoria consegue consumir em 10-15 minutos — para que o gestor pare de montar slides desorganizados na véspera e passe a apresentar com confiança, transmitindo competência e controle da operação." .

mesh:Skill_ia_operations_apresentacao_executiva_para_reunioes_e_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-apresentacao-executiva-para-reunioes-e-clientes" ;
    rdfs:label "apresentacao-executiva-para-reunioes-e-clientes" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/apresentacao-executiva-para-reunioes-e-clientes/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura e o conteúdo completo de apresentações executivas — para reuniões de resultado, pitch para clientes, apresentação de projetos ou proposta de mudança interna — com roteiro slide a slide, texto de cada tela e dicas de apresentação oral, para que qualquer gestor consiga comunicar com clareza e impacto sem depender de uma agência ou designer para criar o deck do zero." .

mesh:Skill_ia_operations_ata_de_reuniao_e_follow_up_estrategico a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-ata-de-reuniao-e-follow-up-estrategico" ;
    rdfs:label "ata-de-reuniao-e-follow-up-estrategico" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/ata-de-reuniao-e-follow-up-estrategico/SKILL.md" ;
    mesh:skillDescription "Documentar reuniões com clientes, parceiros e equipe em atas claras e objetivas — com decisões, responsáveis, prazos e próximos passos — e transformar automaticamente o conteúdo da reunião em email de follow-up profissional, para que nenhuma decisão se perca no ar, cada compromisso tenha um dono e o gestor demonstre o nível de organização que diferencia empresas de referência das que vivem no improviso." .

mesh:Skill_ia_operations_ata_de_reuniao_operacional a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-ata-de-reuniao-operacional" ;
    rdfs:label "ata-de-reuniao-operacional" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/ata-de-reuniao-operacional/SKILL.md" ;
    mesh:skillDescription "Criar uma ata de reunião operacional completa — com pauta, decisões tomadas, ações definidas (com responsável e prazo), pontos em aberto e próxima reunião — transformando cada encontro de equipe em um documento rastreável que gera comprometimento e elimina o \"mas eu não sabia\" ou \"isso não ficou definido\". A ata é a memória formal da operação." .

mesh:Skill_ia_operations_automacao_de_processos_com_o_claude a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-automacao-de-processos-com-o-claude" ;
    rdfs:label "automacao-de-processos-com-o-claude" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/automacao-de-processos-com-o-claude/SKILL.md" ;
    mesh:skillDescription "Criar um sistema de automação de processos do negócio usando o Claude como assistente central — com prompts encadeados, instruções reutilizáveis e fluxos de trabalho documentados — para transformar o Claude de \"ferramenta ocasional\" em \"segundo cérebro do negócio\" que executa tarefas repetitivas com padrão profissional e velocidade 10x maior." .

mesh:Skill_ia_operations_automacao_do_time_com_o_claude a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-automacao-do-time-com-o-claude" ;
