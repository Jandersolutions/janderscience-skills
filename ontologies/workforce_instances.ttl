    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/financeiro/skills/contrato-de-servicos-de-marketing-digital/SKILL.md" ;
    mesh:skillDescription "Gerar um contrato completo de prestação de serviços de marketing digital — com cláusulas específicas para o setor, proteção contra escopo creep e linguagem que o cliente entende — para formalizar todos os projetos e eliminar conflitos sobre o que foi ou não combinado, sem precisar de advogado para o contrato básico." .

mesh:Skill_ia_finance_contrato_simples_para_freelancer_criativo a mesh:Skill ;
    mesh:skillIdentifier "ia-finance-contrato-simples-para-freelancer-criativo" ;
    rdfs:label "contrato-simples-para-freelancer-criativo" ;
    mesh:belongsToDepartment mesh:Dept_finance ;
