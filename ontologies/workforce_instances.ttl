    mesh:skillDescription "Criar posts que usam dados, estatísticas, pesquisas e números concretos para construir autoridade, educar o público e gerar compartilhamentos por serem referência no assunto." .

mesh:Skill_ia_demand_generation_post_de_bastidores_behind_the_scenes a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-post-de-bastidores-behind-the-scenes" ;
