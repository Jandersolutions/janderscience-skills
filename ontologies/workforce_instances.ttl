    mesh:skillDescription "Fazer uma auditoria completa de SEO on-page de uma página específica — analisando título, meta description, headings, conteúdo, imagens, links internos e dados estruturados — com diagnóstico e recomendações práticas para melhorar o ranking no Google." .

mesh:Skill_ia_product_automacao_de_processos_com_ia a mesh:Skill ;
    mesh:skillIdentifier "ia-product-automacao-de-processos-com-ia" ;
