    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/proposta-comercial-de-marketing-digital/SKILL.md" ;
    mesh:skillDescription "Gerar uma proposta comercial completa e persuasiva para serviços de marketing digital — com estrutura profissional, argumentos de valor específicos para o cliente e seção de investimento que facilita a decisão — para parar de enviar orçamentos em planilha e começar a fechar mais negócios com um documento que vende por você." .

mesh:Skill_ia_marketing_proposta_comercial_estruturada a mesh:Skill ;
