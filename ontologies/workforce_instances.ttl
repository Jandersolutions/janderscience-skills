    mesh:belongsToDepartment mesh:Dept_product ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/produto/skills/precificacao-de-consultorias-e-mentorias/SKILL.md" ;
    mesh:skillDescription "Criar a estratégia de precificação completa para consultorias, mentorias e programas de treinamento — com análise de valor entregue, comparação de mercado, posicionamento por ticket e estrutura de pacotes — para que especialistas parem de cobrar por hora e comecem a cobrar por resultado, aumentando a margem sem precisar trabalhar mais. Preço certo não é o mais barato — é o que comunica o valor correto para o cliente certo." .

mesh:Skill_ia_product_project_charter_termo_de_abertura a mesh:Skill ;
    mesh:skillIdentifier "ia-product-project-charter-termo-de-abertura" ;
