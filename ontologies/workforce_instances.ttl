mesh:Skill_ia_legal_risk_gerador_de_apelacao_e_contrarrazoes_em_materia_tributaria a mesh:Skill ;
    mesh:skillIdentifier "ia-legal-risk-gerador-de-apelacao-e-contrarrazoes-em-materia-tributaria" ;
