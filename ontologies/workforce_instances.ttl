    mesh:skillDescription "Criar a bio completa e a estratégia de posicionamento digital para advogados que produzem conteúdo nas redes sociais — definindo nicho, tom de voz, proposta de valor única e textos prontos para Instagram, LinkedIn e Google — para substituir bios genéricas por uma presença digital que atrai o cliente certo e comunica autoridade desde o primeiro contato." .

mesh:Skill_ia_people_bio_e_posicionamento_digital a mesh:Skill ;
    mesh:skillIdentifier "ia-people-bio-e-posicionamento-digital" ;
    rdfs:label "bio-e-posicionamento-digital" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/carreira/skills/bio-e-posicionamento-digital/SKILL.md" ;
    mesh:skillDescription "Criar a bio, o posicionamento e a proposta de valor do perfil nas redes sociais — definindo claramente quem você é, para quem você fala, o que você oferece e por que alguém deveria te seguir. Uma bio forte é o primeiro filtro de conversão: é ela que transforma visitante em seguidor e seguidor em cliente." .

mesh:Skill_ia_people_bio_e_posicionamento_para_instagram a mesh:Skill ;
    mesh:skillIdentifier "ia-people-bio-e-posicionamento-para-instagram" ;
    rdfs:label "bio-e-posicionamento-para-instagram" ;
    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/carreira/skills/bio-e-posicionamento-para-instagram/SKILL.md" ;
    mesh:skillDescription "Criar a bio completa do Instagram — nome de perfil, frase de posicionamento, bullets de proposta de valor e CTA — com base no seu nicho, público e objetivo, para que cada visita ao perfil entenda em menos de 5 segundos o que você faz, para quem e por que vale a pena seguir. Uma bio bem construída converte visitantes em seguidores e seguidores em clientes." .

mesh:Skill_ia_people_bio_profissional_para_saude_e_bem_estar a mesh:Skill ;
    mesh:skillIdentifier "ia-people-bio-profissional-para-saude-e-bem-estar" ;
