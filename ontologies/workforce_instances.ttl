    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/roteiro-de-video-de-autoridade/SKILL.md" ;
    mesh:skillDescription "Criar roteiros completos para vídeos de autoridade — os vídeos que ensinam, posicionam e geram leads qualificados sem precisar \"vender\". Funciona para YouTube, LinkedIn, Reels longos e IGTV. O roteiro já vem estruturado com gancho, desenvolvimento lógico, insight-chave e CTA — para que você grave sem travar e entregue um vídeo que as pessoas assistem até o final." .

mesh:Skill_ia_demand_generation_roteiro_de_video_de_portfolio_case_em_video a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-roteiro-de-video-de-portfolio-case-em-video" ;
