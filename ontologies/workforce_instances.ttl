    mesh:skillDescription "Criar campanhas estruturadas (criativo + copy + oferta + testes) para aumentar ROAS e escala." .

mesh:Skill_ia_operations_playbook_de_respostas_rapidas_para_clientes_e_emails a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-playbook-de-respostas-rapidas-para-clientes-e-emails" ;
    rdfs:label "playbook-de-respostas-rapidas-para-clientes-e-emails" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/playbook-de-respostas-rapidas-para-clientes-e-emails/SKILL.md" ;
    mesh:skillDescription "Criar respostas rápidas, claras e profissionais para clientes, emails e mensagens do dia a dia — economizando tempo sem parecer apressado ou genérico." .

mesh:Skill_ia_operations_politica_interna_da_empresa a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-politica-interna-da-empresa" ;
    rdfs:label "politica-interna-da-empresa" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/politica-interna-da-empresa/SKILL.md" ;
    mesh:skillDescription "Criar o texto completo de uma política interna — de RH, uso de equipamentos, conduta, benefícios, segurança ou qualquer outra área — com linguagem clara, escopo bem definido e regras aplicáveis, para que a empresa tenha as regras do jogo documentadas, todos saibam o que é esperado e o gestor pare de resolver conflitos caso a caso sem respaldo formal." .

mesh:Skill_ia_operations_politica_interna_e_manual_de_processos a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-politica-interna-e-manual-de-processos" ;
    rdfs:label "politica-interna-e-manual-de-processos" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/politica-interna-e-manual-de-processos/SKILL.md" ;
    mesh:skillDescription "Criar políticas internas e manuais de processo claros e aplicáveis — para operação técnica, atendimento, financeiro e RH — para que a empresa pare de depender da memória e julgamento individual de cada pessoa, tenha consistência na entrega independente de quem executa, e esteja preparada para crescer ou contratar sem perder qualidade na operação." .

mesh:Skill_ia_operations_precificacao_estrategica_de_projetos_de_branding a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-precificacao-estrategica-de-projetos-de-branding" ;
    rdfs:label "precificacao-estrategica-de-projetos-de-branding" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/precificacao-estrategica-de-projetos-de-branding/SKILL.md" ;
    mesh:skillDescription "Estruturar a precificação de projetos de design e branding — com modelagem de pacotes, precificação por valor entregue e não por hora, e tabela de honorários por nível de projeto — para que o designer pare de cobrar por achismo, tenha uma política de preços clara e aumente o ticket médio sem perder clientes por isso." .

mesh:Skill_ia_operations_preparacao_estrategica_para_reunioes_importantes a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-preparacao-estrategica-para-reunioes-importantes" ;
    rdfs:label "preparacao-estrategica-para-reunioes-importantes" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/preparacao-estrategica-para-reunioes-importantes/SKILL.md" ;
    mesh:skillDescription "Estruturar a preparação para reuniões importantes — com pauta estratégica, objetivos claros, argumentos principais, antecipação de objeções e definição dos próximos passos desejados — para que o gestor entre em cada reunião com clareza do que quer sair com ela e aumente drasticamente a taxa de decisões tomadas por reunião." .

mesh:Skill_ia_operations_priorizacao_estrategica_de_projetos a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-priorizacao-estrategica-de-projetos" ;
    rdfs:label "priorizacao-estrategica-de-projetos" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/priorizacao-estrategica-de-projetos/SKILL.md" ;
    mesh:skillDescription "Aplicar um framework de priorização em uma lista de projetos, iniciativas ou melhorias em disputa — avaliando impacto no resultado, esforço de execução, alinhamento estratégico e urgência — para que o diretor pare de tentar fazer tudo ao mesmo tempo, decida com critérios objetivos e concentre os recursos da empresa nos projetos que realmente movem o negócio." .

mesh:Skill_ia_operations_proposta_de_melhoria_de_processo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-proposta-de-melhoria-de-processo" ;
    rdfs:label "proposta-de-melhoria-de-processo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/proposta-de-melhoria-de-processo/SKILL.md" ;
    mesh:skillDescription "Criar uma proposta estruturada de melhoria de processo para apresentar à diretoria ou para o próprio diretor decidir — com diagnóstico da situação atual, proposta de solução, análise de impacto financeiro, plano de implementação e riscos — para que boas ideias deixem de morrer na cabeça dos gestores e cheguem ao tomador de decisão com argumentação sólida e visibilidade de execução." .

mesh:Skill_ia_operations_protocolo_de_gestao_de_prazos_processuais a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-protocolo-de-gestao-de-prazos-processuais" ;
    rdfs:label "protocolo-de-gestao-de-prazos-processuais" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/protocolo-de-gestao-de-prazos-processuais/SKILL.md" ;
    mesh:skillDescription "Estruturar o sistema de controle e gestão de prazos processuais — com protocolo de registro, alerta antecipado e priorização — para que o Procurador nunca perca um prazo por falta de controle, saiba sempre o que está vencendo nos próximos dias e tenha uma rotina simples de acompanhamento que funcione mesmo nas semanas mais pesadas." .

mesh:Skill_ia_operations_relatorio_de_acompanhamento_de_projeto a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-relatorio-de-acompanhamento-de-projeto" ;
    rdfs:label "relatorio-de-acompanhamento-de-projeto" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/relatorio-de-acompanhamento-de-projeto/SKILL.md" ;
    mesh:skillDescription "Gerar relatórios de acompanhamento de projeto claros e profissionais — com resumo executivo, evolução física e financeira, próximos passos e riscos — para que o gestor mantenha o cliente informado de forma proativa, construa credibilidade durante a execução e evite surpresas e conflitos que surgem quando o cliente não sabe o que está acontecendo no projeto." .

mesh:Skill_ia_operations_relatorio_de_entrega_de_projeto a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-relatorio-de-entrega-de-projeto" ;
    rdfs:label "relatorio-de-entrega-de-projeto" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/relatorio-de-entrega-de-projeto/SKILL.md" ;
    mesh:skillDescription "Gerar um relatório de entrega completo para acompanhar o trabalho entregue ao cliente — com resumo do que foi feito, principais decisões tomadas, orientações de uso e próximos passos recomendados — que transforma uma entrega simples de arquivo em uma experiência profissional de alto valor percebido. O cliente que recebe um relatório de entrega paga melhor, indica mais e volta para contratar de novo." .

mesh:Skill_ia_operations_relatorio_de_entrega_e_onboarding_de_novo_projeto_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-relatorio-de-entrega-e-onboarding-de-novo-projeto-para-cliente" ;
    rdfs:label "relatorio-de-entrega-e-onboarding-de-novo-projeto-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/relatorio-de-entrega-e-onboarding-de-novo-projeto-para-cliente/SKILL.md" ;
    mesh:skillDescription "Criar dois documentos essenciais para a gestão de projetos de branding: o relatório de entrega final (que profissionaliza a entrega e orienta o cliente sobre os arquivos) e o onboarding de início de projeto (que alinha expectativas, define processo e cria a primeira boa impressão) — para que o designer entregue uma experiência profissional do início ao fim e reduza ao mínimo as dúvidas e problemas pós-entrega." .

mesh:Skill_ia_operations_relatorio_de_implementacao_de_ia_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-relatorio-de-implementacao-de-ia-para-cliente" ;
    rdfs:label "relatorio-de-implementacao-de-ia-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/relatorio-de-implementacao-de-ia-para-cliente/SKILL.md" ;
    mesh:skillDescription "Gerar um relatório completo de entrega de um projeto de implementação de IA — com o que foi implementado, como funciona, resultados iniciais, documentação para o cliente manter o sistema e recomendações de evolução — que profissionaliza a entrega e justifica o valor cobrado. O relatório de implementação transforma um \"projeto técnico\" em um documento executivo que o cliente apresenta aos sócios e que gera indicações." .

mesh:Skill_ia_operations_relatorio_de_resultado_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-relatorio-de-resultado-para-cliente" ;
    rdfs:label "relatorio-de-resultado-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/relatorio-de-resultado-para-cliente/SKILL.md" ;
    mesh:skillDescription "Criar relatórios mensais profissionais para clientes de consultoria — que documentam o que foi feito, os resultados obtidos, as métricas evoluídas e o próximo ciclo de trabalho. Um relatório bem feito não é burocracia: é a prova do valor entregue que justifica a renovação, facilita o upsell e gera depoimentos espontâneos. Para consultores que entregam muito mas não documentam e perdem clientes que não percebem o valor." .

mesh:Skill_ia_operations_relatorio_de_resultados_para_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-relatorio-de-resultados-para-clientes" ;
    rdfs:label "relatorio-de-resultados-para-clientes" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/relatorio-de-resultados-para-clientes/SKILL.md" ;
    mesh:skillDescription "Criar um relatório de progresso e resultados para clientes de saúde e bem-estar — com estrutura clara, linguagem motivacional e dados que mostram evolução mesmo quando os resultados objetivos ainda são modestos — para aumentar a percepção de valor do acompanhamento, reduzir cancelamentos e facilitar a renovação do serviço." .

mesh:Skill_ia_operations_relatorio_mensal_para_medicos_locatarios a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-relatorio-mensal-para-medicos-locatarios" ;
    rdfs:label "relatorio-mensal-para-medicos-locatarios" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/relatorio-mensal-para-medicos-locatarios/SKILL.md" ;
    mesh:skillDescription "Criar um relatório mensal de prestação de contas para médicos e profissionais que alugam sala na clínica — com resumo de dias utilizados, valores, eventuais cobranças adicionais e informações relevantes da operação da clínica — para manter a relação profissional transparente, reduzir conflitos financeiros e demonstrar gestão organizada. Profissional que recebe relatório mensal tem menos razão para questionar cobranças e mais razão para renovar o contrato." .

mesh:Skill_ia_operations_relatorio_operacional_semanal a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-relatorio-operacional-semanal" ;
    rdfs:label "relatorio-operacional-semanal" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/relatorio-operacional-semanal/SKILL.md" ;
    mesh:skillDescription "Criar um relatório operacional semanal completo — com desempenho dos KPIs, ocorrências relevantes, ações em andamento e plano da semana seguinte — para comunicar a performance da operação à liderança ou registrar para próprio controle. Para o gestor solo, o relatório semanal é a ferramenta que impõe ritmo, cria histórico e demonstra profissionalismo na gestão." .

mesh:Skill_ia_operations_respondedor_de_e_mails_profissionais a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-respondedor-de-e-mails-profissionais" ;
    rdfs:label "respondedor-de-e-mails-profissionais" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/respondedor-de-e-mails-profissionais/SKILL.md" ;
    mesh:skillDescription "Transformar um e-mail recebido — seja uma solicitação, reclamação, dúvida ou proposta — em uma resposta profissional, clara e completa em menos de 2 minutos, sem precisar ficar reescrevendo rascunhos ou pensando em como formular. Ideal para gestores que acumulam caixa de entrada e precisam responder com qualidade sem gastar tempo." .

mesh:Skill_ia_operations_resposta_profissional_a_clientes_dificeis a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-resposta-profissional-a-clientes-dificeis" ;
    rdfs:label "resposta-profissional-a-clientes-dificeis" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/resposta-profissional-a-clientes-dificeis/SKILL.md" ;
    mesh:skillDescription "Gerar respostas prontas e profissionais para as situações mais desafiadoras do atendimento: cliente insatisfeito, produto com defeito, atraso na entrega, pedido de reembolso e avaliação negativa pública — mantendo a calma, protegendo a marca e muitas vezes revertendo o cliente em fã. Para empreendedoras solo que não têm equipe e precisam responder rápido sem perder a cabeça." .

mesh:Skill_ia_operations_resposta_profissional_de_emails_e_mensagens a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-resposta-profissional-de-emails-e-mensagens" ;
    rdfs:label "resposta-profissional-de-emails-e-mensagens" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/resposta-profissional-de-emails-e-mensagens/SKILL.md" ;
    mesh:skillDescription "Transformar qualquer situação de comunicação com clientes, parceiros ou fornecedores em uma resposta bem redigida, com tom adequado e estrutura clara — para que o gestor não perca tempo escolhendo palavras e passe mais tempo em atividades estratégicas, sem sacrificar a qualidade da comunicação profissional." .

mesh:Skill_ia_operations_resposta_profissional_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-resposta-profissional-para-cliente" ;
    rdfs:label "resposta-profissional-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/resposta-profissional-para-cliente/SKILL.md" ;
    mesh:skillDescription "Transformar um raciocínio rápido sobre a situação do cliente em uma mensagem escrita profissional, clara e completa — para WhatsApp, email ou qualquer canal — que informa, orienta e transmite confiança sem demorar para ser escrita. Resolve o problema de \"ficar devendo resposta\" para clientes e elimina o tempo gasto \"montando\" o texto perfeito." .

mesh:Skill_ia_operations_resposta_profissional_para_cliente_whatsapp_email a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-resposta-profissional-para-cliente-whatsapp-email" ;
    rdfs:label "resposta-profissional-para-cliente-whatsapp-email" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/resposta-profissional-para-cliente-whatsapp-email/SKILL.md" ;
    mesh:skillDescription "Transformar uma anotação rápida ou um raciocínio sobre a situação do cliente em uma resposta escrita profissional, clara e completa — seja para WhatsApp, email ou mensagem de texto — que informe, oriente e transmita segurança sem ser fria ou robotizada. Elimina o tempo gasto \"montando\" o texto da resposta e garante que informações importantes não sejam esquecidas." .

mesh:Skill_ia_operations_respostas_profissionais_a_clientes_e_e_mails a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-respostas-profissionais-a-clientes-e-e-mails" ;
    rdfs:label "respostas-profissionais-a-clientes-e-e-mails" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/respostas-profissionais-a-clientes-e-e-mails/SKILL.md" ;
    mesh:skillDescription "Gerar respostas profissionais, claras e estratégicas para qualquer tipo de e-mail ou mensagem de cliente — cobrança de prazo, pedido de desconto, reclamação, proposta recebida, solicitação fora do escopo, follow-up de venda — para que você nunca fique paralisado diante de uma mensagem difícil e sempre responda com o tom certo, protegendo o relacionamento e os interesses do negócio ao mesmo tempo." .

mesh:Skill_ia_operations_respostas_profissionais_para_clientes a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-respostas-profissionais-para-clientes" ;
    rdfs:label "respostas-profissionais-para-clientes" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/respostas-profissionais-para-clientes/SKILL.md" ;
    mesh:skillDescription "Gerar respostas rápidas, claras e profissionais — melhorando comunicação e economizando tempo no atendimento." .

mesh:Skill_ia_operations_resumo_executivo_de_reuniao_financeira a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-resumo-executivo-de-reuniao-financeira" ;
    rdfs:label "resumo-executivo-de-reuniao-financeira" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/resumo-executivo-de-reuniao-financeira/SKILL.md" ;
    mesh:skillDescription "Transformar as anotações brutas de uma reunião financeira com o cliente em uma ata executiva profissional — com resumo da situação discutida, decisões tomadas, próximos passos com responsáveis e prazos, e pontos de atenção para a próxima reunião. Elimina horas de organização pós-reunião e cria um documento que reforça o valor da consultoria e mantém o cliente comprometido com as ações." .

mesh:Skill_ia_operations_reuniao_semanal_de_time_de_e_commerce a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-reuniao-semanal-de-time-de-e-commerce" ;
    rdfs:label "reuniao-semanal-de-time-de-e-commerce" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/reuniao-semanal-de-time-de-e-commerce/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura completa de reunião semanal de time — com pauta, dinâmica, perguntas de accountability e documentação — para que o alinhamento aconteça em menos de 45 minutos, todos saiam sabendo o que fazer e o gestor não precise ficar apagando incêndio durante a semana por falta de alinhamento." .

mesh:Skill_ia_operations_revisao_e_redacao_de_contratos_com_linguagem_clara a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-revisao-e-redacao-de-contratos-com-linguagem-clara" ;
    rdfs:label "revisao-e-redacao-de-contratos-com-linguagem-clara" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/revisao-e-redacao-de-contratos-com-linguagem-clara/SKILL.md" ;
    mesh:skillDescription "Revisar ou redigir contratos com precisão jurídica e linguagem acessível — identificando riscos, cláusulas problemáticas e ausências importantes — para que o gestor entenda o que está assinando, proteja os interesses da empresa e não dependa de advogado para cada análise de rotina." .

mesh:Skill_ia_operations_revisao_estrategica_semanal_do_gestor a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-revisao-estrategica-semanal-do-gestor" ;
    rdfs:label "revisao-estrategica-semanal-do-gestor" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/revisao-estrategica-semanal-do-gestor/SKILL.md" ;
    mesh:skillDescription "Criar um ritual de revisão estratégica semanal — com perguntas estruturadas, análise de KPIs e planejamento de próximas ações — para que o gestor de e-commerce saia de cada semana com clareza do que aconteceu, do que precisa mudar e do que fazer na próxima, sem deixar o caos operacional consumir o pensamento estratégico." .

mesh:Skill_ia_operations_roteiro_de_feedback_estruturado a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-roteiro-de-feedback-estruturado" ;
    rdfs:label "roteiro-de-feedback-estruturado" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/roteiro-de-feedback-estruturado/SKILL.md" ;
    mesh:skillDescription "Criar um roteiro personalizado para dar feedback — seja corretivo, de reconhecimento ou de desenvolvimento — para um liderado específico, com abertura, contexto, observação, impacto e próximos passos, para que o gestor pare de adiar conversas difíceis ou dar feedbacks genéricos que não mudam comportamento." .

mesh:Skill_ia_operations_roteiro_de_primeiro_atendimento_ao_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-roteiro-de-primeiro-atendimento-ao-cliente" ;
    rdfs:label "roteiro-de-primeiro-atendimento-ao-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/roteiro-de-primeiro-atendimento-ao-cliente/SKILL.md" ;
    mesh:skillDescription "Estruturar o roteiro completo da primeira consulta com um cliente novo — com perguntas de diagnóstico por área do direito, checklist de documentos a solicitar, avaliação de viabilidade do caso e transição para a proposta de honorários — de forma que a consulta seja produtiva, profissional e já prepare o terreno para o fechamento. Resolve o problema de sair da consulta sem ter coletado tudo que precisava." .

mesh:Skill_ia_operations_roteiro_de_reuniao_com_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-roteiro-de-reuniao-com-cliente" ;
    rdfs:label "roteiro-de-reuniao-com-cliente" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/roteiro-de-reuniao-com-cliente/SKILL.md" ;
    mesh:skillDescription "Estruturar o roteiro completo de reuniões com clientes de marketing — seja o briefing inicial, a reunião de resultados ou a renovação de contrato — com perguntas certas, sequência lógica e objetivos claros por tipo de reunião. Profissionaliza o relacionamento com o cliente, extrai as informações certas e demonstra preparo sem improvisar." .

mesh:Skill_ia_operations_roteiro_simples_para_execucao_de_tarefas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-roteiro-simples-para-execucao-de-tarefas" ;
    rdfs:label "roteiro-simples-para-execucao-de-tarefas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/roteiro-simples-para-execucao-de-tarefas/SKILL.md" ;
    mesh:skillDescription "Evitar travamento na execução — criando um passo a passo simples para qualquer tarefa." .

mesh:Skill_ia_operations_rotina_de_producao_de_conteudo_agil a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-rotina-de-producao-de-conteudo-agil" ;
    rdfs:label "rotina-de-producao-de-conteudo-agil" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/rotina-de-producao-de-conteudo-agil/SKILL.md" ;
    mesh:skillDescription "Criar um sistema de produção de conteúdo ágil — com fluxo de trabalho, divisão de tarefas entre especialista e equipe, batch de produção e banco de ideias recorrente — para que consultores e coaches com equipe pequena publiquem de forma consistente no Instagram e na newsletter gastando o mínimo do seu tempo pessoal. Para quem quer velocidade e consistência sem abrir mão de qualidade." .

mesh:Skill_ia_operations_rotina_operacional_de_secretaria a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-rotina-operacional-de-secretaria" ;
    rdfs:label "rotina-operacional-de-secretaria" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/rotina-operacional-de-secretaria/SKILL.md" ;
    mesh:skillDescription "Criar a rotina operacional completa da secretaria de clínica multisserviço — com checklists diários de abertura e fechamento, rotinas semanais e mensais, prioridades por período do dia e processos para as situações mais comuns — para que a gestora solo saiba exatamente o que precisa acontecer em cada momento e, quando tiver uma secretária, possa delegar com um documento em mãos." .

mesh:Skill_ia_operations_rotina_operacional_semanal_da_equipe a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-rotina-operacional-semanal-da-equipe" ;
    rdfs:label "rotina-operacional-semanal-da-equipe" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/rotina-operacional-semanal-da-equipe/SKILL.md" ;
    mesh:skillDescription "Criar a rotina operacional semanal completa da imobiliária — com reuniões, ritmo de trabalho, rituais de gestão e checkpoints por setor — para transformar uma semana caótica e reativa em uma semana previsível e produtiva, onde todos os colaboradores sabem suas prioridades e o gestor consegue acompanhar a operação sem estar presente em tudo." .

mesh:Skill_ia_operations_rotina_semanal_de_gestao_de_equipe a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-rotina-semanal-de-gestao-de-equipe" ;
    rdfs:label "rotina-semanal-de-gestao-de-equipe" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/rotina-semanal-de-gestao-de-equipe/SKILL.md" ;
    mesh:skillDescription "Criar uma rotina semanal de gestão estruturada — com rituais de abertura, alinhamento, acompanhamento e fechamento — para que líderes de equipes pequenas garantam consistência na execução, identifiquem problemas antes que virem crises e mantenham a equipe alinhada com as prioridades sem precisar de reuniões longas e improdutivas. Uma boa rotina de gestão é o que separa equipe que funciona de equipe que depende do gestor para cada decisão." .

mesh:Skill_ia_operations_script_de_reuniao_one_on_one_11 a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-script-de-reuniao-one-on-one-11" ;
    rdfs:label "script-de-reuniao-one-on-one-11" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/script-de-reuniao-one-on-one-11/SKILL.md" ;
    mesh:skillDescription "Criar o roteiro completo para reuniões individuais (1:1) entre o diretor e seus gerentes — com perguntas certas, estrutura de tempo, temas recorrentes e como usar o espaço para desenvolver liderança — para transformar a 1:1 de uma conversa informal em um ritual de gestão que fortalece o gestor, previne problemas antes que escalem e constrói confiança mútua." .

mesh:Skill_ia_operations_sistema_de_acompanhamento_de_demandas a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-sistema-de-acompanhamento-de-demandas" ;
    rdfs:label "sistema-de-acompanhamento-de-demandas" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/sistema-de-acompanhamento-de-demandas/SKILL.md" ;
    mesh:skillDescription "Ter controle total sobre demandas e evitar atrasos." .

mesh:Skill_ia_operations_sistema_de_automacao_de_producao_de_conteudo a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-sistema-de-automacao-de-producao-de-conteudo" ;
    rdfs:label "sistema-de-automacao-de-producao-de-conteudo" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/sistema-de-automacao-de-producao-de-conteudo/SKILL.md" ;
    mesh:skillDescription "Produzir conteúdo com mais velocidade e menos esforço manual." .

