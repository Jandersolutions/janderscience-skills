    mesh:autonomyTier 3 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/proposta-de-campanha-corporativa-de-vacinas/SKILL.md" ;
    mesh:skillDescription "Criar uma proposta comercial completa para campanhas de vacinação em empresas — com apresentação dos serviços, vacinas disponíveis, logística de aplicação (in loco ou na clínica), preços, condições de pagamento e vantagens para a empresa — para abrir uma fonte de receita B2B que complementa o atendimento individual de pacientes. Uma campanha corporativa de gripe para uma empresa de 50 funcionários pode gerar o faturamento de semanas de atendimento individual." .

mesh:Skill_ia_marketing_proposta_de_captacao_de_imovel a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-proposta-de-captacao-de-imovel" ;
