    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/analise-de-desempenho-de-equipe/SKILL.md" ;
    mesh:skillDescription "Criar uma análise de desempenho completa — individual e coletiva — com critérios objetivos, metodologia de avaliação e plano de desenvolvimento por colaborador, para que gestores de equipes pequenas consigam dar feedback estruturado, identificar quem precisa de suporte e quem está pronto para mais responsabilidade, sem depender de avaliações subjetivas e sem criar o desconforto de conversas sem estrutura." .

mesh:Skill_ia_operations_analise_de_metricas_de_conteudo_e_ajuste_estrategico a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-analise-de-metricas-de-conteudo-e-ajuste-estrategico" ;
    rdfs:label "analise-de-metricas-de-conteudo-e-ajuste-estrategico" ;
