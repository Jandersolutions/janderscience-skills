    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/post-de-lancamento-de-produtoservico/SKILL.md" ;
    mesh:skillDescription "Criar posts de anúncio de lançamento para redes sociais que geram expectativa, comunicam valor e direcionam o público para a ação de compra ou cadastro." .

mesh:Skill_ia_demand_generation_post_de_valor_para_linkedin_e_instagram a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-post-de-valor-para-linkedin-e-instagram" ;
    rdfs:label "post-de-valor-para-linkedin-e-instagram" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/post-de-valor-para-linkedin-e-instagram/SKILL.md" ;
    mesh:skillDescription "Criar posts de valor completos e prontos para publicar no LinkedIn e Instagram — com hook que prende atenção, desenvolvimento que educa ou provoca reflexão, e CTA que gera engajamento ou ação — para que o gestor construa autoridade digital e atraia clientes sem precisar contratar redator ou passar horas na frente do cursor piscando." .

mesh:Skill_ia_demand_generation_post_para_redes_sociais_conteudo_juridico a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-post-para-redes-sociais-conteudo-juridico" ;
    rdfs:label "post-para-redes-sociais-conteudo-juridico" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/post-para-redes-sociais-conteudo-juridico/SKILL.md" ;
    mesh:skillDescription "Criar posts jurídicos para Instagram e LinkedIn que educam o público sobre direitos e temas do direito, posicionam o advogado como autoridade acessível e geram engajamento orgânico — sem parecer propaganda de escritório ou apostila de faculdade. Resolve o \"não sei o que postar\" e transforma temas jurídicos complexos em conteúdo que qualquer pessoa compartilha porque é útil de verdade." .

mesh:Skill_ia_demand_generation_post_para_redes_sociais_contratos_e_direitos_do_freelancer a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-post-para-redes-sociais-contratos-e-direitos-do-freelancer" ;
    rdfs:label "post-para-redes-sociais-contratos-e-direitos-do-freelancer" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/post-para-redes-sociais-contratos-e-direitos-do-freelancer/SKILL.md" ;
    mesh:skillDescription "Criar posts educativos sobre contratos, direitos e boas práticas para freelancers e empreendedores — que posicionam o criador como referência confiável na área, geram engajamento orgânico e atraem clientes que precisam exatamente desse serviço. Resolve o problema de não saber o que postar e transforma o conhecimento técnico em conteúdo que qualquer pessoa quer compartilhar porque é útil de verdade." .

mesh:Skill_ia_demand_generation_post_para_redes_sociais_ia_para_empresas a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-post-para-redes-sociais-ia-para-empresas" ;
    rdfs:label "post-para-redes-sociais-ia-para-empresas" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/post-para-redes-sociais-ia-para-empresas/SKILL.md" ;
    mesh:skillDescription "Criar posts para LinkedIn e Instagram sobre inteligência artificial aplicada a empresas — em linguagem que empresários entendem e que derruba o ceticismo (\"IA é coisa de empresa grande\") — posicionando o consultor como o profissional que torna a IA acessível e prática para PMEs. Conteúdo que atrai exatamente quem precisa de implementação de IA e que ainda não deu o passo." .

mesh:Skill_ia_demand_generation_reaproveitamento_de_conteudo a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-reaproveitamento-de-conteudo" ;
    rdfs:label "reaproveitamento-de-conteudo" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/reaproveitamento-de-conteudo/SKILL.md" ;
    mesh:skillDescription "Transformar um único conteúdo — um post, vídeo, ideia ou texto — em 5 a 8 peças diferentes para plataformas distintas, multiplicando o alcance sem precisar criar do zero a cada vez. Para o empreendedor solo sem tempo, esta é a estratégia de conteúdo mais inteligente: criar uma vez, distribuir muitas vezes." .

mesh:Skill_ia_demand_generation_reels_e_tiktok_de_produto_roteiro_rapido_10_ideias a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-reels-e-tiktok-de-produto-roteiro-rapido-10-ideias" ;
    rdfs:label "reels-e-tiktok-de-produto-roteiro-rapido-10-ideias" ;
    mesh:belongsToDepartment mesh:Dept_demand-generation ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/conteudo-copy/skills/reels-e-tiktok-de-produto-roteiro-rapido-10-ideias/SKILL.md" ;
    mesh:skillDescription "Gerar 10 ideias de Reels ou TikTok de produto com roteiro completo e prontos para gravar — cobrindo diferentes formatos (demonstração, educativo, antes/depois, trend, depoimento encenado) — para um empreendedor solo ter um mês de vídeo planejado e gravar tudo em 1-2 horas de sessão semanal." .

mesh:Skill_ia_demand_generation_reescritor_de_artigo_melhorar_existente a mesh:Skill ;
    mesh:skillIdentifier "ia-demand-generation-reescritor-de-artigo-melhorar-existente" ;
