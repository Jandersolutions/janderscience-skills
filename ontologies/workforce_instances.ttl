mesh:Skill_ia_technology_system_prompt_ia_personalizada_para_tarefa_especifica a mesh:Skill ;
    mesh:skillIdentifier "ia-technology-system-prompt-ia-personalizada-para-tarefa-especifica" ;
    rdfs:label "system-prompt-ia-personalizada-para-tarefa-especifica" ;
    mesh:belongsToDepartment mesh:Dept_technology ;
    mesh:autonomyTier 2 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/codigo/skills/system-prompt-ia-personalizada-para-tarefa-especifica/SKILL.md" ;
    mesh:skillDescription "Criar system prompts completos e profissionais para configurar IAs personalizadas — seja para atendimento ao cliente, análise de documentos, geração de conteúdo, suporte interno ou qualquer outra tarefa — que funcionam de forma consistente, dentro do escopo definido e com o tom correto. O system prompt é a fundação de qualquer produto de IA: um bom prompt faz a diferença entre uma IA que impressiona e uma que constrange." .

mesh:Skill_ia_technology_testes_unitarios_framework_de_escrita a mesh:Skill ;
