    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/copy-de-captacao-para-servicos-juridicos-e-de-gestao/SKILL.md" ;
    mesh:skillDescription "Criar textos de captação persuasivos para serviços jurídicos e de gestão — para anúncios, landing pages, mensagens de prospecção e posts — que comunicam o valor do serviço na linguagem do cliente, antecipam objeções e geram interesse real de prospects qualificados." .

mesh:Skill_ia_marketing_copy_de_e_mail_comercial_e_follow_up a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-copy-de-e-mail-comercial-e-follow-up" ;
    rdfs:label "copy-de-e-mail-comercial-e-follow-up" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/copy-de-e-mail-comercial-e-follow-up/SKILL.md" ;
    mesh:skillDescription "Criar e-mails comerciais profissionais e sequências de follow-up estruturadas — de prospecção a fechamento — para que gestores consigam avançar negociações por e-mail sem experiência prévia em copywriting. Cada e-mail tem objetivo definido, estrutura guiada e tom calibrado para o momento da negociação, eliminando o bloqueio de \"não sei como escrever esse e-mail sem parecer insistente ou genérico\"." .

mesh:Skill_ia_marketing_copy_de_email_de_vendas_para_servicos_de_consultoria a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-copy-de-email-de-vendas-para-servicos-de-consultoria" ;
    rdfs:label "copy-de-email-de-vendas-para-servicos-de-consultoria" ;
