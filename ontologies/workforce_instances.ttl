    mesh:belongsToDepartment mesh:Dept_people ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/carreira/skills/estrutura-de-curso-digital-completo/SKILL.md" ;
    mesh:skillDescription "Criar a estrutura completa de um curso digital — do título ao conteúdo aula por aula — a partir de um tema informado. Inclui módulos organizados por progressão de aprendizagem, títulos de aula com ângulo certo, objetivos de cada módulo e sugestão de formato por aula, para que você saia do \"tenho a ideia\" para o \"tenho o produto pronto para gravar\" em minutos." .

mesh:Skill_ia_people_estrutura_de_curso_online_modulos_e_aulas a mesh:Skill ;
