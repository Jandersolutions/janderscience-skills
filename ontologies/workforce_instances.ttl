    mesh:skillDescription "Garantir que todos os dias você faça ações que geram vendas." .

mesh:Skill_ia_marketing_script_de_direct_para_fechar_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-direct-para-fechar-cliente" ;
    rdfs:label "script-de-direct-para-fechar-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
