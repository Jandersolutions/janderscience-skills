    mesh:skillSourcePath "sources/skills-ia/skills/carreira/skills/linkedin-para-desenvolvedor-freelancer/SKILL.md" ;
    mesh:skillDescription "Otimizar o perfil do LinkedIn e criar uma estratégia de conteúdo que atrai clientes e oportunidades para o desenvolvedor freelancer — com headline que comunica valor, seção \"Sobre\" que converte visitantes em contatos, e plano de conteúdo que demonstra competência sem precisar de grande audiência — para transformar o LinkedIn de currículo estático em canal ativo de geração de oportunidades." .

mesh:Skill_ia_people_otimizacao_de_perfil_do_linkedin a mesh:Skill ;
    mesh:skillIdentifier "ia-people-otimizacao-de-perfil-do-linkedin" ;
