    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/relatorio-de-performance-de-marketing/SKILL.md" ;
    mesh:skillDescription "Transformar dados brutos de campanhas e ações de marketing em um relatório executivo claro e profissional — com análise dos resultados, comparação com metas, conclusões e recomendações — para que clientes, sócios ou diretores entendam o que aconteceu, o que gerou resultado e o que será feito a seguir." .

mesh:Skill_ia_marketing_relatorio_de_resultados_para_cliente a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-relatorio-de-resultados-para-cliente" ;
    rdfs:label "relatorio-de-resultados-para-cliente" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/relatorio-de-resultados-para-cliente/SKILL.md" ;
    mesh:skillDescription "Transformar dados brutos de campanha em um relatório mensal que conta a história dos resultados — com contexto, análise, o que funcionou, o que foi ajustado e o que vem por aí — para que o cliente saia da reunião sentindo que tem um estrategista do lado dele (não um executor de anúncios), valorize mais o trabalho da agência e renove o contrato sem questionar o preço." .

mesh:Skill_ia_marketing_resposta_a_objecoes_de_preco_em_consultoria a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-resposta-a-objecoes-de-preco-em-consultoria" ;
    rdfs:label "resposta-a-objecoes-de-preco-em-consultoria" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/resposta-a-objecoes-de-preco-em-consultoria/SKILL.md" ;
    mesh:skillDescription "Criar respostas estratégicas e prontas para as objeções de preço mais comuns em vendas de consultoria e coaching — sem baixar o valor, sem parecer defensivo e sem travar quando o cliente diz \"está caro\". Para consultores que perdem vendas na objeção de preço porque não sabem o que responder e acabam dando desconto desnecessário ou ficando em silêncio constrangedor." .

mesh:Skill_ia_marketing_roteiro_de_live_de_vendas a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-roteiro-de-live-de-vendas" ;
    rdfs:label "roteiro-de-live-de-vendas" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/roteiro-de-live-de-vendas/SKILL.md" ;
    mesh:skillDescription "Criar o roteiro completo de uma live de vendas — da abertura que prende a atenção até o pitch de oferta e sessão de perguntas — com script, timing, transições e técnicas de conversão ao vivo. Ideal para empreendedoras que usam lives como principal evento de conversão em lançamentos e querem estrutura profissional sem depender de improviso." .

mesh:Skill_ia_marketing_roteiro_de_live_e_webinario_de_venda a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-roteiro-de-live-e-webinario-de-venda" ;
    rdfs:label "roteiro-de-live-e-webinario-de-venda" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/roteiro-de-live-e-webinario-de-venda/SKILL.md" ;
    mesh:skillDescription "Criar o roteiro completo de uma live ou webinário — do gancho de abertura ao pitch de oferta — que entrega valor real para a audiência, constrói autoridade do especialista e converte parte da audiência em clientes sem parecer uma apresentação de vendas disfarçada de conteúdo. Para consultores e coaches que querem usar lives como canal de venda sem perder a credibilidade de especialista." .

mesh:Skill_ia_marketing_roteiro_de_vendas_para_conversas_e_dms a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-roteiro-de-vendas-para-conversas-e-dms" ;
    rdfs:label "roteiro-de-vendas-para-conversas-e-dms" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/roteiro-de-vendas-para-conversas-e-dms/SKILL.md" ;
    mesh:skillDescription "Criar roteiros de venda naturais e eficientes — para conduzir conversas até o fechamento sem parecer forçado." .

mesh:Skill_ia_marketing_roteiro_de_webinar_ou_live_de_vendas a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-roteiro-de-webinar-ou-live-de-vendas" ;
    rdfs:label "roteiro-de-webinar-ou-live-de-vendas" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/roteiro-de-webinar-ou-live-de-vendas/SKILL.md" ;
    mesh:skillDescription "Criar o roteiro completo de um webinar ou live de vendas para consultores e coaches — que ensina algo genuinamente valioso, constrói autoridade em tempo real e, ao final, apresenta a oferta de forma natural e persuasiva. Webinar bem roteirizado é o formato mais escalável de venda de serviços de ticket médio e alto: um evento para 50 pessoas pode gerar 5-10 clientes em 90 minutos." .

mesh:Skill_ia_marketing_rotina_de_vendas_diaria_simples a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-rotina-de-vendas-diaria-simples" ;
