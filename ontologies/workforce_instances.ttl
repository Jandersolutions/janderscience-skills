    mesh:skillDescription "Mapear o avatar ideal de um negócio ou consultoria com profundidade psicográfica — indo além de dados demográficos para entender como o cliente pensa, o que teme, como toma decisões e quais palavras exatas usa para descrever seus problemas — para criar copy e conteúdo que ressoa de forma cirúrgica e faz o leitor sentir que o texto foi escrito especificamente para ele." .

mesh:Skill_ia_operations_pesquisa_e_analise_de_mercado_para_cliente_de_consultoria a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-pesquisa-e-analise-de-mercado-para-cliente-de-consultoria" ;
    rdfs:label "pesquisa-e-analise-de-mercado-para-cliente-de-consultoria" ;
    mesh:belongsToDepartment mesh:Dept_operations ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/operacoes/skills/pesquisa-e-analise-de-mercado-para-cliente-de-consultoria/SKILL.md" ;
    mesh:skillDescription "Conduzir uma pesquisa e análise de mercado profunda para um cliente de consultoria de marketing — mapeando o cenário competitivo, o comportamento do público, as tendências do nicho e as oportunidades não aproveitadas — para entregar um entregável estratégico que o cliente não conseguiria produzir sozinho e que fundamenta todas as decisões de marketing e posicionamento." .

mesh:Skill_ia_operations_pesquisa_rapida_e_sintese_de_mercado a mesh:Skill ;
    mesh:skillIdentifier "ia-operations-pesquisa-rapida-e-sintese-de-mercado" ;
