    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-reuniao-de-vendas-para-agencia/SKILL.md" ;
    mesh:skillDescription "Criar o roteiro completo para conduzir a reunião de diagnóstico e vendas com prospects da agência — com perguntas de qualificação, análise do problema, apresentação da solução e fechamento — para transformar a reunião numa conversa consultiva que vende sem parecer que está vendendo, aumentando a taxa de conversão de prospects em clientes." .

mesh:Skill_ia_marketing_script_de_venda_consultiva_de_aparelho_auditivo a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-venda-consultiva-de-aparelho-auditivo" ;
    rdfs:label "script-de-venda-consultiva-de-aparelho-auditivo" ;
    mesh:belongsToDepartment mesh:Dept_marketing ;
    mesh:autonomyTier 1 ;
    mesh:language "pt-BR" ;
    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-venda-consultiva-de-aparelho-auditivo/SKILL.md" ;
    mesh:skillDescription "Criar um script completo de venda consultiva para aparelhos auditivos — desde a apresentação dos resultados da avaliação audiológica até o fechamento da proposta — com linguagem adaptada para pacientes idosos, seus familiares e adultos em idade ativa, considerando as objeções mais comuns (preço, \"não preciso ainda\", \"vou pensar\"). Para a fonoaudióloga que faz a avaliação e a venda sozinha, este script transforma a consulta em conversão sem parecer forçado." .

mesh:Skill_ia_marketing_script_de_venda_por_whatsapp a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-venda-por-whatsapp" ;
