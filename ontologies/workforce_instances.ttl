    mesh:skillSourcePath "sources/skills-ia/skills/marketing/skills/script-de-venda-por-whatsapp/SKILL.md" ;
    mesh:skillDescription "Criar scripts completos de vendas por WhatsApp — desde a primeira mensagem até o fechamento — com sequências para diferentes cenários (lead frio, lead quente, pós-orçamento, follow-up), respeitando a dinâmica conversacional do canal." .

mesh:Skill_ia_marketing_script_de_vendas_consultoria_de_implementacao_de_ia a mesh:Skill ;
    mesh:skillIdentifier "ia-marketing-script-de-vendas-consultoria-de-implementacao-de-ia" ;
