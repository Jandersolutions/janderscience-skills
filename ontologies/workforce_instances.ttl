mesh:Skill_ia_legal_risk_analise_de_acao_com_tese_vinculante_do_stf_ou_stj a mesh:Skill ;
    mesh:skillIdentifier "ia-legal-risk-analise-de-acao-com-tese-vinculante-do-stf-ou-stj" ;
